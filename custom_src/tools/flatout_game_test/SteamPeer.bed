local startedHere

runModeSweep = function(current)
	if not ChloeNet_IsServer() then return end
	local count = ChloeNet_GetNumPlayers()
	assert(count <= 2, "another player entered the Steam test lobby")
	if current == "steam-hosting" then
		if not ChloeSteam_SetLobbyValue("cc_flatout_test", FlatOutTest_Run) then return end
		for slot = 1, 12 do ChloeSteam_SetAIDriver(slot, slot <= 4 and slot or 0) end
		ChloeNet_Host_SetNumAI(4)
		ChloeNet_Host_SetAIClass(4)
		ChloeNet_Host_SetCarClass(CARCLASS_ANY)
		ChloeNet_Host_SetLevelId(31)
		ChloeNet_Host_SetGameRules(GR_DERBY)
		ChloeNet_Host_SetDerbyType(DERBY_FRAG)
		ChloeNet_Host_SetLapCount(1)
		ChloeNet_Host_SetDamageMult(0.1)
		ChloeNet_SetPlayerCar(CarIndex.Insetta)
		ChloeNet_SetPlayerCarSkin(1)
		advance("steam-peer-lobby")
	elseif current == "steam-peer-lobby" and count == 2 then
		for index = 1, count do
			if not ChloeNet_IsPlayerLocalPlayer(index) then
				local name = string.gsub(ChloeNet_GetPlayerName(index) or "", "%z", "")
				if string.lower(name) ~= string.lower(FlatOutTest_SteamPeerName) then
					assert(name == "", "unexpected Steam test participant: " .. name)
					return
				end
				if ChloeNet_IsPlayerReady(index) then
					startedHere = true
					advance("steam-peer-racing")
					FlatOutTest_StartHostRace()
				end
			end
		end
	elseif current == "steam-peer-racing" and not startedHere then
		advance("steam-leaving", "steam-peer-returned")
		ChloeNet_Disconnect()
		EnterMenu("menu_chloemultiplayer")
	end
end
