-- Appended after Scenario.bed. Each case uses the same setup function as
-- Change Track and the tournament, then the normal lobby start callback.
local modes = {
	{"Race", GAMETYPE_RACE, 19, GR_RACE, GR_DEFAULT},
	{"Pong-Race", GAMETYPE_PONGRACE, 19, GR_PONGRACE, GR_PONGRACE},
	{"Knockout", GAMETYPE_KNOCKOUT, 19, GR_KNOCKOUT, GR_DEFAULT},
	{"Lap-Knockout", GAMETYPE_LAPKNOCKOUT, 19, GR_LAPKNOCKOUT, GR_DEFAULT},
	{"Drift", GAMETYPE_DRIFT, 19, GR_DRIFT, GR_ARCADE_RACE},
	{"Carnage-Race", GAMETYPE_ARCADE_RACE, 19, GR_ARCADE_RACE, GR_ARCADE_RACE},
	{"Beat-the-Bomb", GAMETYPE_BEAT_THE_BOMB, 16, GR_BEAT_THE_BOMB, GR_BEAT_THE_BOMB},
	{"Stunt-Show", GAMETYPE_TONYHAWK, 19, GR_TONYHAWK, GR_ARCADE_RACE},
	{"Speedtrap", GAMETYPE_SPEEDTRAP, 19, GR_SPEEDTRAP, GR_ARCADE_RACE},
	{"Wrecking-Derby", GAMETYPE_DERBY_WRECKING, 31, GR_DERBY, GR_DERBY, DERBY_WRECKING},
	{"Deathmatch-Derby", GAMETYPE_DERBY_FRAG, 31, GR_DERBY, GR_DERBY, DERBY_FRAG},
	{"Survivor-Derby", GAMETYPE_DERBY_LMS, 31, GR_DERBY, GR_DERBY, DERBY_LMS},
}

for track = 47, 58 do
	assert(Levels[track].Rules == GR_STUNT and Levels[track].StartPosition)
	table.insert(modes, {string.gsub(Levels[track].Name, " ", "-"), GAMETYPE_STUNT, track, GR_STUNT, GR_STUNT})
end

-- Track sweep: every multiplayer track and FO2 geometry variant with its natural
-- rules, rotating through every car of the "ANY" class (base cars and FO2
-- variants) and every stunt car. Leftover cars get extra races on Midwest Ranch 1.
if FlatOutTest_TrackSweep then
	modes = {}
	local cars, seen = {}, {}
	local function addCar(car)
		if car and not seen[car] and ChloeCustom_IsFO2Car(car) then
			seen[car] = true
			table.insert(cars, car)
		end
	end
	for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
		if IsValidCarNoTemp350(i) then
			addCar(i)
			addCar(ChloeCollection_GetCarMatchup(i))
		end
	end
	local stuntCars = {}
	for _, entry in ipairs(CarlistStuntCars()) do table.insert(stuntCars, entry.index) end
	assert(table.getn(cars) > 0 and table.getn(stuntCars) > 0, "empty car lists")
	local nextCar, nextStunt, nextDerby = 1, 1, 1
	local derbyTypes = {
		{GAMETYPE_DERBY_WRECKING, DERBY_WRECKING}, {GAMETYPE_DERBY_FRAG, DERBY_FRAG}, {GAMETYPE_DERBY_LMS, DERBY_LMS},
	}
	local function addTrack(id, variant)
		local level = Levels[id]
		local rules = level.Rules or GR_RACE
		if rules == GR_DEFAULT then rules = GR_RACE end
		local name = string.gsub(level.Name, " ", "-") .. (variant and "-FO2" or "")
		local car
		if rules == GR_STUNT then
			car = stuntCars[math.mod(nextStunt - 1, table.getn(stuntCars)) + 1]
			nextStunt = nextStunt + 1
			table.insert(modes, {name, GAMETYPE_STUNT, id, GR_STUNT, GR_STUNT, nil, variant, car})
		elseif rules == GR_DERBY then
			car = cars[math.mod(nextCar - 1, table.getn(cars)) + 1]
			nextCar = nextCar + 1
			local d = derbyTypes[math.mod(nextDerby - 1, 3) + 1]
			nextDerby = nextDerby + 1
			table.insert(modes, {name, d[1], id, GR_DERBY, GR_DERBY, d[2], variant, car})
		elseif rules == GR_RACE then
			car = cars[math.mod(nextCar - 1, table.getn(cars)) + 1]
			nextCar = nextCar + 1
			table.insert(modes, {name, GAMETYPE_RACE, id, GR_RACE, GR_DEFAULT, nil, variant, car})
		else
			log("track skipped " .. id .. " rules " .. tostring(rules))
		end
	end
	for id = 1, 58 do
		if not Levels[id].ChloeCustomHidden then addTrack(id, false) end
	end
	for id = 1, 58 do
		if not Levels[id].ChloeCustomHidden and ChloeCollection_DoesTrackHaveFO2Variant(id) then addTrack(id, true) end
	end
	-- Mode-specific track lists of the multiplayer race menu (own checkpoints/splines per track).
	local special = {
		{"Reversed", "AllowReversed", GAMETYPE_RACE, GR_RACE, GR_DEFAULT, true},
		{"Carnage", "AllowArcadeRace", GAMETYPE_ARCADE_RACE, GR_ARCADE_RACE, GR_ARCADE_RACE},
		{"Speedtrap", "AllowSpeedtrap", GAMETYPE_SPEEDTRAP, GR_SPEEDTRAP, GR_ARCADE_RACE},
		{"Beat-the-Bomb", "AllowBeatTheBomb", GAMETYPE_BEAT_THE_BOMB, GR_BEAT_THE_BOMB, GR_BEAT_THE_BOMB},
	}
	for _, kind in ipairs(special) do
		for id = 1, 58 do
			local level = Levels[id]
			if level.TrackType and not level.ChloeCustomHidden and level[kind[2]] then
				local car = cars[math.mod(nextCar - 1, table.getn(cars)) + 1]
				nextCar = nextCar + 1
				table.insert(modes, {string.gsub(level.Name, " ", "-") .. "-" .. kind[1], kind[3], id, kind[4], kind[5],
					nil, false, car, kind[6]})
			end
		end
	end
	while nextCar <= table.getn(cars) do
		table.insert(modes, {"Car-Check", GAMETYPE_RACE, 19, GR_RACE, GR_DEFAULT, nil, false, cars[nextCar]})
		nextCar = nextCar + 1
	end
	while nextStunt <= table.getn(stuntCars) do
		table.insert(modes, {"Stunt-Car-Check", GAMETYPE_STUNT, 47, GR_STUNT, GR_STUNT, nil, false, stuntCars[nextStunt]})
		nextStunt = nextStunt + 1
	end
	log(string.format("track sweep %d cases, %d cars, %d stunt cars", table.getn(modes), table.getn(cars), table.getn(stuntCars)))
	for i, mode in ipairs(modes) do
		log(string.format("track case %d %s level=%d variant=%s car=%d folder=car_%d skins=%d", i, mode[1], mode[3],
			tostring(mode[7]) .. (mode[9] and " reversed" or ""), mode[8], ChloeCollection_GetCarDataID(mode[8]), ChloeSkins_GetNumSkinsForCar(mode[8])))
	end
end

local caseKey = prefix .. "mode"
local through = math.min(FlatOutTest_ModeThrough, table.getn(modes))
local startedHere = false

local function prepareMode(index)
	local mode = modes[index]
	local level = Levels[mode[3]]
	if mode[4] == GR_BEAT_THE_BOMB then assert(level.AllowBeatTheBomb) end
	if mode[4] == GR_SPEEDTRAP then assert(level.AllowSpeedtrap) end
	local stunt = mode[4] == GR_STUNT
	local ai = stunt and 0 or 3
	for slot = 1, 12 do
		ChloeSteam_SetAIDriver(slot, slot <= ai and slot or 0)
	end
	assert(ChloeSteam_GetAIDriverCount() == ai)
	ChloeNet_Host_SetNumAI(ai)
	ChloeNet_Host_SetCarClass(CARCLASS_ANY)
	local car = mode[8] or (stunt and CarIndex.Rocket or CarIndex.Insetta)
	local skins = ChloeSkins_GetNumSkinsForCar(car)
	assert(skins > 0, "car without installed skins: " .. car)
	ChloeNet_SetPlayerCar(car)
	-- rotate skins so the sweep also loads different liveries
	ChloeNet_SetPlayerCarSkin(mode[8] and math.mod(index - 1, skins) + 1 or 1)
	ChloeSteam_StoreSet(caseKey, tostring(index))
	advance("mode-prepared", "mode preparing " .. index .. " " .. mode[1])
	ChloeCustomTourney_SetEvents({{
		trackid = mode[3], rules = mode[2], weather = level.Weather or 1,
		lapsOrTimeLimit = 1, tracktype = mode[9] and TRACKTYPE_REVERSED or nil,
	}})
end

runModeSweep = function(current)
	if current ~= "steam-hosting" and current ~= "mode-prepared" and current ~= "mode-running" then return end
	if not ChloeNet_IsServer() then return end
	assert(ChloeNet_GetNumPlayers() == 1, "foreign player entered the test lobby")
	if current == "steam-hosting" then
		if not ChloeSteam_SetLobbyValue("cc_flatout_test", FlatOutTest_Run) then return end
		assert(FlatOutTest_ModeFrom <= through, "invalid multiplayer mode range")
		assert(ChloeNet_GetHandlingMode() == HANDLING_NORMAL_FO2DOWNFORCE, "unexpected default Steam host handling")
		log(string.format("mode range %d %d", FlatOutTest_ModeFrom, through))
		prepareMode(FlatOutTest_ModeFrom)
	elseif current == "mode-prepared" then
		local index = tonumber(ChloeSteam_StoreGet(caseKey))
		local mode = modes[index]
		local level = Levels[mode[3]]
		local stunt = mode[4] == GR_STUNT
		local lobbyRules = level.Rules or GR_RACE
		if lobbyRules == GR_DEFAULT then lobbyRules = GR_RACE end
		if mode[4] ~= GR_RACE then lobbyRules = mode[4] end
		local actual = ChloeNet_GetGameRules()
		if actual == GR_DEFAULT then actual = level.Rules or GR_RACE end
		assert(actual == lobbyRules and ChloeNet_GetLevelId() == mode[3], "lobby did not apply the test mode")
		assert(ChloeNet_GetNumAI() == (stunt and 0 or 3))
		assert(ChloeNet_GetTrackReversed() == (mode[9] == true), "reversed track setting was not applied")
		ChloeNet_Host_SetIsFO2Track(mode[7] and 1 or 0)
		assert(ChloeNet_GetIsFO2Track() == (mode[7] == true), "FO2 track variant was not applied")
		local car = mode[8] or (stunt and CarIndex.Rocket or CarIndex.Insetta)
		assert(ChloeNet_GetLocalPlayerCar() == car, "lobby did not keep the test car " .. car .. ", has " .. tostring(ChloeNet_GetLocalPlayerCar()))
		if stunt then
			assert(ChloeNet_GetNoContact(), "stunt ghost mode was not enabled")
		end
		startedHere = true
		advance("mode-running", string.format("mode begin %d %s %d %d %d %d %d %d %d %d",
			index, mode[1], mode[3], mode[4], mode[6] or 0, mode[6] and 1 or 0,
			stunt and level.StartPosition or 0, stunt and 0 or 3, mode[5], car))
		FlatOutTest_StartHostRace()
	elseif not startedHere then
		local index = tonumber(ChloeSteam_StoreGet(caseKey))
		log("mode return " .. index)
		if index < through then
			prepareMode(index + 1)
		else
			advance("steam-leaving", "mode sweep complete")
			ChloeNet_Disconnect()
		end
	end
end
