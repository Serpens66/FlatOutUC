	self.parent:deinit(self)



end

-- custom: menu button index -> TRACKTYPE (buttons 7-12 removed, button 7 is now TRACKTYPE_EVENT)
local racetype_button_map = { 1, 2, 3, 4, 5, 6, 13 }

function menu_singleplayer_racetype.buttonChange(self,oldbutton,newbutton)
	local id = racetype_button_map[newbutton] or newbutton
	RaceSelectionState.RaceType=id
	W("type_image"):AttachResource(self:getResource(race_type_names[id].bg))
	W("type_name"):SetTitle(race_type_names[id].name)
	W("type_description"):SetTitle(tracktype_descriptions[id])
	W("type_description"):WordWrap()
end

function GetTracksByTypeUnlocked(type)
	local tracks={}

	for k,v in ipairs(Levels) do
		if v.TrackType and v.TrackType == type and not v.IsMultiplayerOnly and not v.ChloeCustomHidden and not ChloeCollection_IsTrackLockedByCheatCode(k) then
			if RaceSelectionState.Rules == GR_TIME_TRIAL or RaceSelectionState.Rules == GR_DRIFT or RaceSelectionState.Rules == GR_TONYHAWK or not v.NoAI then
				table.insert(tracks,{level_id=k,locked=false,name=ConvertToWString(v.Name),image=v.TrackImage,logo=v.TrackLogo})
			end
		end
	end

	return tracks
end

function GetTracksForTonyHawk(type)
	local tracks={}

	for k,v in ipairs(Levels) do
		if v.TrackType and v.AllowTonyHawk and not v.IsMultiplayerOnly and not v.ChloeCustomHidden and not ChloeCollection_IsTrackLockedByCheatCode(k) then
			table.insert(tracks,{level_id=k,locked=false,name=ConvertToWString(v.Name),image=v.TrackImage,logo=v.TrackLogo})
		end
	end

	return tracks
end

function GetTracksForSpeedtrap(type)
	local tracks={}

	for k,v in ipairs(Levels) do
		if v.TrackType and v.AllowSpeedtrap and not v.IsMultiplayerOnly and not v.ChloeCustomHidden and not ChloeCollection_IsTrackLockedByCheatCode(k) then
			if RaceSelectionState.Rules == GR_TIME_TRIAL or RaceSelectionState.Rules == GR_DRIFT or RaceSelectionState.Rules == GR_TONYHAWK or not v.NoAI then
				table.insert(tracks,{level_id=k,locked=false,name=ConvertToWString(v.Name),image=v.TrackImage,logo=v.TrackLogo})
			end
		end
	end

	return tracks
end

local DIRECTION_NONE = 0
local DIRECTION_LEFT = 1
local DIRECTION_RIGHT = 2

local function SwitchTrackInfoName()
	local levelid=tracks[RaceSelectionState.Id].level_id
	local leveldata=Levels[levelid]
	if ChloeCollection_DoesTrackHaveFO2Variant(levelid) then
		if RaceSelectionState.IsFO2Track ~= nil and RaceSelectionState.IsFO2Track == true then
			W("track_name"):SetTitle(ConvertToWString("FO2 "..leveldata.Name))
		else
			W("track_name"):SetTitle(ConvertToWString(leveldata.Name))
		end
	else
		RaceSelectionState.IsFO2Track = false
		AUDIO.PlayMenuSound(AUDIO.MENUSFX_ERROR)
	end
end

local function SwitchTrackInfo(self,direction,id)
	if IsNormalRace() then
		if ChloeCollection_DoesTrackHaveFO2Variant(tracks[id].level_id) then
			GUI:SetHelpButtons(BUTTON_OPTIONS,TRANSLATOR(UI_TRACKOPTIONS),BUTTON_INFO,TRANSLATOR(MULTIPLAYER_ICON_CHANGETRACK),BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))
		else
			GUI:SetHelpButtons(BUTTON_OPTIONS,TRANSLATOR(UI_TRACKOPTIONS),BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))
		end
	end
	
	RaceSelectionState.IsFO2Track = false

	local leveldata=Levels[tracks[id].level_id]

	db.GameFlow.PreRace.Laps = leveldata.Laps
	if RaceSelectionState.NitroMultiplier then
		db.GameFlow.PreRace.NitroMultiplier = RaceSelectionState.NitroMultiplier
	end
	if RaceSelectionState.DamageMultiplier then
		db.GameFlow.PreRace.DamageMultiplier = RaceSelectionState.DamageMultiplier
	end
	if RaceSelectionState.UpgradeLevel then
		db.GameFlow.PreRace.UpgradeLevel = RaceSelectionState.UpgradeLevel
	end
	if RaceSelectionState.HandlingDamage then
		db.GameFlow.PreRace.HandlingDamage = RaceSelectionState.HandlingDamage
	end
	if RaceSelectionState.DerbyType then
		db.GameFlow.PreRace.DerbyType = RaceSelectionState.DerbyType
	end
	if RaceSelectionState.NitroType then
		TimeTrial_SetNitroType(RaceSelectionState.NitroType)
	end
	if RaceSelectionState.PropsEnabled then
		TimeTrial_SetPropsEnabledBool(RaceSelectionState.PropsEnabled)
	end
	if RaceSelectionState.ThreeLapMode then
		TimeTrial_Set3LapMode(RaceSelectionState.ThreeLapMode)
	end
	if RaceSelectionState.TonyHawkHandling then
		ChloeCollection_SetStuntHandling(RaceSelectionState.TonyHawkHandling)
	end
	db.GameFlow.PreRace.Weather = 1

	update_options(track_options)

	local w=W("track_name")
	W("track_name"):SetTitle(ConvertToWString(leveldata.Name))

	if W("lapcount") then
		if W("stunt_goal") then W("stunt_goal"):HideWindow() end

		if leveldata.Rules and leveldata.Rules == GR_DERBY then
			W("lap_icon"):HideWindow()
			W("lapcount"):HideWindow()
			W("track_info_title"):HideWindow()
		else
			W("track_info_title"):ShowWindow()
			W("lap_icon"):ShowWindow()
			W("lapcount"):ShowWindow()
			W("lapcount"):SetTitle(ConvertToWString(string.format("%d LAPS",leveldata.Laps or 0)))
		end
	end

	if W("stunt_goal") and leveldata.StuntType then
		if W("lap_icon") then W("lap_icon"):HideWindow() end
		if W("lapcount") then W("lapcount"):HideWindow() end

		W("track_info_title"):ShowWindow()
		W("stunt_goal"):ShowWindow()
		W("stunt_goal"):SetTitle(TRANSLATOR(stunt_goals[leveldata.StuntType]))
	end



	if W("highscore") then
		local highscore=GetHighScore(tracks[id].level_id)
		W("highscore"):SetTitle(FormatHighScore(highscore))
	end


	local trackDesc = TRANSLATOR(leveldata.Description)
	if (trackDesc == 65535) then
        trackDesc = L(leveldata.Description)
	end
	W("track_description"):SetTitle(trackDesc)
	W("track_description"):WordWrap()

	local image=leveldata.TrackImage or ""
	W("track_image"):AttachResource(self:getResource(image))
end


menu_singleplayer_trackselection = CreateMenuFromTemplate("template_basic")


menu_singleplayer_trackselection.options.title=TRANSLATOR(TITLE_SELECTRACE)
menu_singleplayer_trackselection.options.forgetselection = true
menu_singleplayer_trackselection.items={}

menu_singleplayer_trackselection.back = function()

	--//RaceSelectionState:prevPhase()
	if RaceSelectionState.backmenu then
		RaceSelectionState.backmenu()
	else
		EnterMenu("menu_singleplayer_racetype")
	end
end

menu_singleplayer_trackselection.buttonPressed=function(self,button,selected)
	if button == KeyCodes.BUTTON_OPTIONS then
		if not IsNormalRace() then
			return
		end

		self.leftarrow:ShowWindow()
		self.rightarrow:ShowWindow()
		W("inputhandler"):activate(1)
	elseif button == KeyCodes.BUTTON_INFO then
		if not IsNormalRace() then
			return
		end
		
		if RaceSelectionState.IsFO2Track == nil or RaceSelectionState.IsFO2Track == false then
			RaceSelectionState.IsFO2Track = true
		else
			RaceSelectionState.IsFO2Track = false
		end
		SwitchTrackInfoName()
	end
end



local function onChildAction()
	local self=menu_singleplayer_trackselection

	if self.pressed then return end
	self.pressed=true


	--//playmenusound_action()

	
	if singlerace_selected then
		local selection=CopyTable(RaceSelectionState)
		singlerace_selected(selection)
		RaceSelectionState=nil
	else
		local carlist
		local bg
		if RaceSelectionState.RaceType == TRACKTYPE_STUNT then
			carlist=CarlistStuntCars()
			bg="data/menu/stunt_car_selection_bg.tga"
		else
			carlist=CarlistAllCars()
		end
		
		SetUpgradeLevelForStats()

		EnterCarSelection(carselected,
				function()
					--//RaceSelectionState:prevPhase()
					EnterMenu("menu_singleplayer_trackselection")
				end,carlist,false,true,false,false,bg,nil,true,TRANSLATOR(TITLE_SELECTCAR),true)
	end
end



function menu_singleplayer_trackselection.create(self)

	
	self.pressed=nil
	self.backpressed=nil

	self.parent:create(self)	

	self.items={}

	self.options.title=TRANSLATOR(TITLE_SELECTRACE)
	
	local racetype=RaceSelectionState.RaceType

	if racetype == TRACKTYPE_STUNT then
		self.options.title=TRANSLATOR(TITLE_SELECTSTUNT)
	elseif racetype == TRACKTYPE_EVENT or racetype == TRACKTYPE_TONYHAWK or racetype == TRACKTYPE_SPEEDTRAP then
		self.options.title=TRANSLATOR(TITLE_SELECT_EVENT)
	elseif racetype == TRACKTYPE_DERBY then
		self.options.title=TRANSLATOR(TITLE_SELECT_DERBY)
	end

	self:addResource("game_mode_selector_ws.tga",game_mode_selector,game_mode_selector_size)	
	self:addResource("track_images.tga",track_images,track_images_size)
	self:addResource("event_type_icons_2.tga",event_type_icons_2,event_type_icons_2_size)
	self:addResource("event_type_icons_3.tga",event_type_icons_3,event_type_icons_3_size)
	self:addResource("event_type_icons_4.tga",event_type_icons_4,event_type_icons_4_size)
	
	if racetype == TRACKTYPE_TONYHAWK or racetype == TRACKTYPE_SPEEDTRAP then
		self:addResource("track_images_wide_1_ws.tga",track_images_wide_1,track_images_wide_1_size)
		self:addResource("track_images_wide_2_ws.tga",track_images_wide_2,track_images_wide_2_size)
		self:addResource("track_images_wide_3_ws.tga",track_images_wide_3,track_images_wide_3_size)
		self:addResource("track_images_wide_4_ws.tga",track_images_wide_4,track_images_wide_4_size)
		self:addResource("track_images_wide_5_ws.tga",track_images_wide_5,track_images_wide_5_size)
		self:addResource("track_images_wide_6_ws.tga",track_images_wide_6,track_images_wide_6_size)
		self:addResource("track_images_wide_7_ws.tga",track_images_wide_7,track_images_wide_7_size)
		self:addResource("event_type_images_wide_2.tga",event_type_images_wide_2,event_type_images_wide_2_size)
		self:addResource("event_type_images_wide_tt.tga",event_type_images_wide_tt,event_type_images_wide_tt_size)
		self:addResource("event_type_images_wide_karelia.tga",event_type_images_wide_karelia,event_type_images_wide_karelia_size)
		self:addResource("event_type_images_wide_kenya.tga",event_type_images_wide_kenya,event_type_images_wide_kenya_size)
		self:addResource("event_type_images_wide_finland.tga",event_type_images_wide_finland,event_type_images_wide_finland_size)
		self:addResource("event_type_images_wide_sweden.tga",event_type_images_wide_sweden,event_type_images_wide_sweden_size)
		self:addResource("event_type_images_wide_switzerland.tga",event_type_images_wide_switzerland,event_type_images_wide_switzerland_size)
		self:addResource("event_type_images_wide_arcade.tga",event_type_images_wide_arcade,event_type_images_wide_arcade_size)
		self:addResource("event_type_images_wide_extras.tga",event_type_images_wide_extras,event_type_images_wide_extras_size)
	else
		local images = tracktype_images[racetype]
	
		for k,v in ipairs(images) do
			if string.find(v, "event_type_images")==nil then
				self:addResource(v.."_ws.tga",_G[v],_G[v.."_size"])
			else
				self:addResource(v..".tga",_G[v],_G[v.."_size"])
			end
		end
	end

	self:loadResources()

	local function getIcon(name)
		return menu_singleplayer_trackselection:getResource(name),menu_singleplayer_trackselection:getResource(name)
	end

	tracks=nil
	
	if racetype == TRACKTYPE_TONYHAWK then
		tracks=GetTracksForTonyHawk(racetype)
	elseif racetype == TRACKTYPE_SPEEDTRAP then
		tracks=GetTracksForSpeedtrap(racetype)
	else
		tracks=GetTracksByTypeUnlocked(racetype)
	end
	
	for k,v in ipairs(tracks) do
		local data=Levels[v.level_id]
		OUTPUTDEBUGSTRING(string.format("level %d %s icon=%s",v.level_id,data.Name,data.TrackIcon))
		table.insert(self.items,{ L"", onChildAction,getIcon(data.TrackIcon) } )
	end
end


function menu_singleplayer_trackselection.init(self)
	self.parent:init(self)

	state={}

	SetCurrentMenuCar()


	RaceSelectionState.Id=nil

	Frame{Position=POS(ChloeWidescreen_GetLeft(),70),Size=SIZE(ChloeWidescreen_GetRight(),35)}:AttachResource(self:getResource("game_mode_main_bd"))
	Frame{Position=POS(ChloeWidescreen_GetLeft(),110),Size=SIZE(ChloeWidescreen_GetRight(),128)}:AttachResource(self:getResource("game_mode_main_bd_2"))

	FadingFrame{Name="track_image",Position=POS(64,118),Size=SIZE(512,112)}

	FadingStaticText{Name="track_name",Position=POS(320,67),Align=FONTF_CENTER,Font=fonttitle(),Color=GetPaletteColor(33)}

	local rules = RaceSelectionState.Rules
	local racetype=RaceSelectionState.RaceType

	local derby
	local time_trial
	local race
	local event
	local tonyhawk
	local speedtrap
	local drift
	local knockout

	if rules == GR_TIME_TRIAL then
		time_trial=true
	elseif rules == GR_TONYHAWK then
		tonyhawk=true
	elseif rules == GR_SPEEDTRAP then
		speedtrap=true
	elseif rules == GR_DRIFT then
		drift=true
	elseif rules == GR_KNOCKOUT then
		knockout=true
	elseif racetype == TRACKTYPE_DERBY or rules == GR_DERBY then
		derby=true
	elseif racetype == TRACKTYPE_EVENT then
		event=true
	elseif rules == GR_DEFAULT or rules == GR_RACE then
		race=true
	end


	if IsNormalRace() then
		Frame{Position=POS(ChloeWidescreen_GetLeft(),244),Size=SIZE(292-ChloeWidescreen_GetLeft(),114)}:AttachResource(self:getResource("game_mode_bd_str"))
		Frame{Position=POS(292,244),Size=SIZE(67,114)}:AttachResource(self:getResource("game_mode_bd_tips"))
		Frame{Position=POS(359,244),Size=SIZE(ChloeWidescreen_GetRight()-359,114)}:AttachResource(self:getResource("game_mode_bd_str"))

		StaticText{Title=TRANSLATOR(CAREER_DESCRIPTION),Align=FONTF_CENTER,Position=POS(170,244),Font=fontsmall(),Color=GetPaletteColor(33)}

		FadingStaticText{Name="track_description",Position=POS(170,277),Size=SIZE(260,110),Font=fontextratiny(),Align=FONTF_CENTER,Color=GetPaletteColor(34)}


		StaticText{Title=TRANSLATOR(OPTIONS_RACEOPTIONS),Align=FONTF_CENTER,Position=POS(473,244),Font=fontsmall(),Color=GetPaletteColor(33)}

		
		if derby then
			track_options=track_options_derby
		elseif time_trial then
			if racetype == TRACKTYPE_EVENT then
				track_options=track_options_time_trial_event
			elseif racetype == TRACKTYPE_RALLYTROPHY then
				track_options=track_options_time_trial_rallytrophy
			else
				track_options=track_options_time_trial
			end
		elseif drift then
			if racetype == TRACKTYPE_EVENT or racetype == TRACKTYPE_RALLYTROPHY then
				track_options=track_options_drift_event
			else
				track_options=track_options_drift
			end
		elseif knockout then
			if racetype == TRACKTYPE_EVENT or racetype == TRACKTYPE_RALLYTROPHY then
				track_options=track_options_knockout_event
			else
				track_options=track_options_knockout
			end
		elseif tonyhawk then
			track_options=track_options_tonyhawk_event
		elseif speedtrap then
			track_options=track_options_speedtrap_event
		elseif event then
			track_options=track_options_event
		elseif racetype == TRACKTYPE_RALLYTROPHY then
			track_options=track_options_rallytrophy
		else
			track_options=track_options_race
		end

		self.leftarrow = CreateArrow(self, "leftarrow", "ingame_options_arrow_left")
		self.rightarrow = CreateArrow(self, "rightarrow", "ingame_options_arrow_right")
		self.leftarrow:HideWindow()
		self.rightarrow:HideWindow()

		create_options(track_options)
	else
		Frame{Position=POS(ChloeWidescreen_GetLeft(),244),Size=SIZE(ChloeWidescreen_GetRight(),114)}:AttachResource(self:getResource("game_mode_bd_str"))
		
		StaticText{Title=TRANSLATOR(CAREER_DESCRIPTION),Align=FONTF_CENTER,Position=POS(320,244),Font=fontsmall(),Color=GetPaletteColor(33)}

		FadingStaticText{Name="track_description",Position=POS(320,277),Size=SIZE(260,110),Font=fontextratiny(),Align=FONTF_CENTER,Color=GetPaletteColor(34),Align=FONTF_CENTER}
	end

	GUI:SetMenuSelectionResource(self:getResource("selection_additive_glow"))
	GUI:InitMenuButtons(self.items)

	if IsNormalRace() then
		if ChloeCollection_DoesTrackHaveFO2Variant(tracks[1].level_id) then
			GUI:SetHelpButtons(BUTTON_OPTIONS,TRANSLATOR(UI_TRACKOPTIONS),BUTTON_INFO,TRANSLATOR(MULTIPLAYER_ICON_CHANGETRACK),BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))
		else
			GUI:SetHelpButtons(BUTTON_OPTIONS,TRANSLATOR(UI_TRACKOPTIONS),BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))
		end
	else
		GUI:SetHelpButtons(BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))
	end


	local input=InputHandler{Name="inputhandler"}
	input.options=track_options

	input.onKeyPressed = function(self,character,virtualkey,scancode)
		if virtualkey == KeyCodes.BUTTON_SELECT then
			playmenusound_back()
			self:deactivate(self.item)
			menu_singleplayer_trackselection.leftarrow:HideWindow()
			menu_singleplayer_trackselection.rightarrow:HideWindow()
			GUI:SetActiveItem(RaceSelectionState.Id)
			GUI:ShowMenuButtons()
			if ChloeCollection_DoesTrackHaveFO2Variant(tracks[RaceSelectionState.Id].level_id) then
				GUI:SetHelpButtons(BUTTON_OPTIONS,TRANSLATOR(UI_TRACKOPTIONS),BUTTON_INFO,TRANSLATOR(MULTIPLAYER_ICON_CHANGETRACK),BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))
			else
				GUI:SetHelpButtons(BUTTON_OPTIONS,TRANSLATOR(UI_TRACKOPTIONS),BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))
			end
		elseif virtualkey == KeyCodes.BUTTON_LEFT then
			playmenusound_move()
			self.options[self.item].frame:moveLeft()

		elseif virtualkey == KeyCodes.BUTTON_RIGHT then
			playmenusound_move()
			self.options[self.item].frame:moveRight()

		elseif virtualkey == KeyCodes.BUTTON_DOWN then
			local maxitems=table.getn(self.options)

			local value=self.item+1
			if value > maxitems then
				value=1
			end

			while not self.options[value].title do
				value=value + 1
				if value > maxitems then
					value=0
				end
			end

			self:activate(value)
			
			playmenusound_move()

		elseif virtualkey == KeyCodes.BUTTON_UP then

			local value=self.item-1

			if value < 1 then
				value=table.getn(self.options)
			end

			while not self.options[value].title do
				value=value-1

				if value < 1 then
					value=table.getn(self.options)
				end
			end

			self:activate(value)

			playmenusound_move()
		end
	end

	input.activate = function(self,item)

		local old_type

		if self.item then
			self:deactivate(self.item)
			old_type=self.options[self.item].type
		else
			--//old_type=self.options[item].type
		end

		self.item=item

		GUI:SetHelpButtons(BUTTON_BACK,TRANSLATOR(UI_BACK))

		self.options[item].frame:activate()

		self:SetFocus()
		GUI:HideMenuButtons()
	end

	input.deactivate = function(self,item)

		self.options[item].frame:deactivate()

	end


end

function menu_singleplayer_trackselection.update(self,time)
	self.parent:update(self,time)
	
	if RaceSelectionState ~= nil and IsNormalRace() then
		self.leftarrow:AnimateAlpha(time)
		self.rightarrow:AnimateAlpha(time)
	end
end

function menu_singleplayer_trackselection.deinit(self)
	self.parent:deinit(self)
end

function menu_singleplayer_trackselection.buttonChange(self,oldbutton,newbutton)
	if self.pressed or self.backpressed then return end

	local id=newbutton
	playmenusound_move()
	--//local old_id=RaceSelectionState.Id
	RaceSelectionState.Id=id
	--//db.GameFlow.PreRace.Level=tracks[id].level_id
	RaceSelectionState.Level=tracks[id].level_id
	RaceSelectionState.Laps=Levels[RaceSelectionState.Level].Laps or 1

	--//GUI:SwitchButtonText(tracks[id].name)

	SwitchTrackInfo(self,DIRECTION_NONE,id)
end

function menu_singleplayer_trackselection.moveUp(self)
	if self.pressed or self.backpressed then return end
	if RaceSelectionState.RaceType ~= TRACKTYPE_RALLYTROPHY then return end

	local id = 27 -- switzerland 1
	if RaceSelectionState.Id > 21 then
		id = 21 -- sweden 1
	elseif RaceSelectionState.Id > 15 then
		id = 15 -- finland 1
	elseif RaceSelectionState.Id > 9 then
		id = 9 -- kenya 1
	elseif RaceSelectionState.Id > 1 then
		id = 1 -- karelia 1
	end
	
	GUI:SetActiveItem(id)

	playmenusound_move()
	RaceSelectionState.Id=id
	RaceSelectionState.Level=tracks[id].level_id
	RaceSelectionState.Laps=Levels[RaceSelectionState.Level].Laps or 1

	SwitchTrackInfo(self,DIRECTION_NONE,id)
end

function menu_singleplayer_trackselection.moveDown(self)
	if self.pressed or self.backpressed then return end
	if RaceSelectionState.RaceType ~= TRACKTYPE_RALLYTROPHY then return end

	local id = 1 -- karelia 1
	if RaceSelectionState.Id < 9 then
		id = 9 -- kenya 1
	elseif RaceSelectionState.Id < 15 then
		id = 15 -- finland 1
	elseif RaceSelectionState.Id < 21 then
		id = 21 -- sweden 1
	elseif RaceSelectionState.Id < 27 then
		id = 27 -- switzerland 1
	end
	
	GUI:SetActiveItem(id)

	playmenusound_move()
	RaceSelectionState.Id=id
	RaceSelectionState.Level=tracks[id].level_id
	RaceSelectionState.Laps=Levels[RaceSelectionState.Level].Laps or 1

	SwitchTrackInfo(self,DIRECTION_NONE,id)
end


