	{ name=TRANSLATOR(RACETRACKTYPE_FOREST), bg="event_forest", tracktype=TRACKTYPE_FOREST, },
	{ name=TRANSLATOR(RACETRACKTYPE_FIELDS), bg="event_field", tracktype=TRACKTYPE_FIELDS, },
