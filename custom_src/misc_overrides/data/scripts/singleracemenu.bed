local function IsNormalRace()
	if not RaceSelectionState.RaceType or 
		RaceSelectionState.RaceType == TRACKTYPE_STUNT or
		RaceSelectionState.Rules == GR_STUNT then
			return false
	end

	return true
end

local function SetUpgradeLevelForStats()
	db.GameFlow.PreRace.UpgradeLevel = RaceSelectionState.UpgradeLevel
end


local function carselected(car,skin)
	--//db.GameFlow.PreRace.Mode=RaceSelectionState.GameMode
	GameFlow.ClearRace()
	db.GameFlow.PreRace.Mode=GM_SINGLE_RACE
	db.GameFlow.PreRace.Car=car
	db.GameFlow.PreRace.CarSkin=skin or 1
	db.GameFlow.PreRace.Level=RaceSelectionState.Level
	
	if RaceSelectionState.Rules then 
		db.GameFlow.PreRace.Rules = RaceSelectionState.Rules
	end
	
	db.GameFlow.PreRace.HandlingDamage = 0
	if IsNormalRace() then
		db.GameFlow.PreRace.Laps = RaceSelectionState.Laps
		db.GameFlow.PreRace.Weather = RaceSelectionState.Weather
		db.GameFlow.PreRace.UpgradeLevel = RaceSelectionState.UpgradeLevel
		db.GameFlow.PreRace.HandlingDamage = RaceSelectionState.HandlingDamage
		db.GameFlow.PreRace.DamageMultiplier = RaceSelectionState.DamageMultiplier
		db.GameFlow.PreRace.NitroMultiplier = RaceSelectionState.NitroMultiplier
		
		if RaceSelectionState.RaceType == TRACKTYPE_DERBY or RaceSelectionState.Rules == GR_DERBY then
			db.GameFlow.PreRace.DerbyType = RaceSelectionState.DerbyType
		end
			
		if Levels[RaceSelectionState.Level].Weathers == nil or Levels[RaceSelectionState.Level].Weathers[2] == nil then
			db.GameFlow.PreRace.Weather = 1
		end
		
		if Levels[RaceSelectionState.Level].ForceOneLapOnly then
			db.GameFlow.PreRace.Laps=1
		end
	end
	
	ChloeCollection_ReinitHooks()
	if db.GameFlow.PreRace.Rules == GR_TIME_TRIAL then
		db.GameFlow.PreRace.Rules=GR_DEFAULT
		if Levels[RaceSelectionState.Level].ForceOneLapOnly then
			db.GameFlow.PreRace.Laps=1
			RaceSelectionState.ThreeLapMode = 0
		elseif RaceSelectionState.ThreeLapMode == 1 then
			db.GameFlow.PreRace.Laps=3
		else
			db.GameFlow.PreRace.Laps=10
		end
		TimeTrial_SetEnabled(1)
		TimeTrial_SetPropsEnabled(RaceSelectionState.PropsEnabled)
		TimeTrial_SetNitroType(RaceSelectionState.NitroType)
		TimeTrial_SetUpgradeLevel(RaceSelectionState.UpgradeLevel)
		TimeTrial_SetHandlingMode(Settings["Game"]["HandlingMode"])
		if RaceSelectionState.IsFO2Track ~= nil and RaceSelectionState.IsFO2Track == true then
			TimeTrial_SetIsFO2Track(1)
		else
			TimeTrial_SetIsFO2Track(0)
		end
		TimeTrial_Set3LapMode(RaceSelectionState.ThreeLapMode)
		TimeTrial_SetCareerMode(0)
		TimeTrial_SetCareerRallyMode(0)
		ChloeCollection_SetIsTimeTrial(1)
	elseif db.GameFlow.PreRace.Rules == GR_TONYHAWK then
		db.GameFlow.PreRace.Rules=GR_ARCADE_RACE
		db.GameFlow.PreRace.Laps=10
		ChloeCollection_SetStuntSimpleUI(1)
		ChloeCollection_SetStuntTime(RaceSelectionState.TonyHawkTime)
		ChloeCollection_SetStuntHandling(RaceSelectionState.TonyHawkHandling)
		ChloeCollection_SetStuntMode(1)
	elseif db.GameFlow.PreRace.Rules == GR_SPEEDTRAP then
		if Levels[RaceSelectionState.Level].ForceOneLapOnly then
			RaceSelectionState.Laps=1
		end
		db.GameFlow.PreRace.Rules=GR_ARCADE_RACE
		db.GameFlow.PreRace.Laps=RaceSelectionState.Laps
		ChloeCollection_SetSpeedtrapSimpleUI(1)
		--ChloeCollection_SetSpeedtrapLaps(RaceSelectionState.Laps)
		ChloeCollection_SetSpeedtrapMode(1)
	elseif db.GameFlow.PreRace.Rules == GR_DRIFT then
		if Levels[RaceSelectionState.Level].ForceOneLapOnly then
			db.GameFlow.PreRace.Laps=1
		else
			db.GameFlow.PreRace.Laps=10
		end
		db.GameFlow.PreRace.Rules=GR_ARCADE_RACE
		ChloeCollection_SetDriftSimpleUI(1)
		ChloeCollection_SetDriftTime(RaceSelectionState.TonyHawkTime)
		ChloeCollection_SetDriftMode(1)
	elseif db.GameFlow.PreRace.Rules == GR_LAPKNOCKOUT then
		if Levels[RaceSelectionState.Level].ForceOneLapOnly then
			db.GameFlow.PreRace.Laps=1
		else
			db.GameFlow.PreRace.Laps = RaceSelectionState.Laps
		end
		db.GameFlow.PreRace.Rules=GR_RACE
		ChloeCollection_SetLapKnockoutMode(1)
	elseif db.GameFlow.PreRace.Rules == GR_KNOCKOUT then
		if Levels[RaceSelectionState.Level].ForceOneLapOnly then
			db.GameFlow.PreRace.Laps=1
		else
			db.GameFlow.PreRace.Laps=10
		end
		db.GameFlow.PreRace.Rules=GR_RACE
		ChloeCollection_SetTimedKnockoutMode(1)
	end
	
	if RaceSelectionState.IsFO2Track ~= nil and RaceSelectionState.IsFO2Track == true then
		ChloeCollection_SetTrackFO2Variant(1)
	else
		ChloeCollection_SetTrackFO2Variant(0)
	end
	
	Event:PostEvent(event(EVENT_RACE_BEGIN))
end

function EnterSingleRaceSelection(backfunction,type,okfunction,rule)

	--//db.GameFlow.PreRace.Mode=GM_SINGLE_RACE --//RaceSelectionState.GameMode

	RaceSelectionState={} --//newTransaction()
	RaceSelectionState.GameMode=GM_SINGLE_RACE
	RaceSelectionState.RaceType=type
	RaceSelectionState.backmenu=backfunction
	RaceSelectionState.Rules=rule

	singlerace_selected=okfunction
	--//RaceSelectionState:nextPhase()

	if type then
		EnterMenu("menu_singleplayer_trackselection")
	else
		EnterMenu("menu_singleplayer_racetype")
	end
end





local state

local event_type_names = {
	TRANSLATOR(EVENTSET_RACE),
	TRANSLATOR(EVENTSET_DERBIESDIRTSOVALS),
	TRANSLATOR(EVENTSET_STUNTS),
}

