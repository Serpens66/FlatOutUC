local function SetBackground(id)
	GUI:SetBackground("data/menu/"..race_type_names[id].bg)
end




menu_singleplayer_racetype = CreateMenuFromTemplate("template_basic")


menu_singleplayer_racetype.options.title=TRANSLATOR(TITLE_RACETYPE)

menu_singleplayer_racetype.back=function()
	RaceSelectionState=nil
	EnterMenu("menu_singleplayer_events")
end



function menu_singleplayer_racetype.create(self)
	self.parent:create(self)

	self:addResource("event_type_icons.tga",event_type_icons,event_type_icons_size)
	self:addResource("event_type_icons_2.tga",event_type_icons_2,event_type_icons_2_size)
	self:addResource("event_type_icons_3.tga",event_type_icons_3,event_type_icons_3_size)
	self:addResource("event_type_icons_4.tga",event_type_icons_4,event_type_icons_4_size)

	self:addResource("event_type_images_wide_ws.tga",event_type_images_wide,event_type_images_wide_size)
	self:addResource("event_type_images_wide_mainmenu.tga",event_type_images_wide_mainmenu,event_type_images_wide_mainmenu_size)

	self:addResource("game_mode_selector_ws.tga",game_mode_selector,game_mode_selector_size)	


	self:loadResources()

	local function onChildAction()
		EnterMenu("menu_singleplayer_trackselection")
	end

	local function getOnChildAction()
		return onChildAction
	end

	local function icon(name)
		return self:getResource(name),self:getResource(name)
	end

	self.items= {
		{ L"",getOnChildAction(),icon("race_type_1") }, --//icon("race_type_1")),
		{ L"",getOnChildAction(),icon("race_type_2") },
		{ L"",getOnChildAction(),icon("race_type_3") },
		{ L"",getOnChildAction(),icon("race_type_4") },
		{ L"",getOnChildAction(),icon("race_type_5") },
		{ L"",getOnChildAction(),icon("race_type_6") },
		-- custom: FO1 / Tough Trucks / Rally Trophy categories removed (see racetype_button_map)
		{ L"",getOnChildAction(),icon("event_type_2") },
	}


end


function menu_singleplayer_racetype.init(self)
	self.parent:init(self)


	state={}




	Frame{Position=POS(ChloeWidescreen_GetLeft(),64),Size=SIZE(ChloeWidescreen_GetRight(),42)}:AttachResource(self:getResource("game_mode_main_bd"))
	Frame{Position=POS(ChloeWidescreen_GetLeft(),110),Size=SIZE(ChloeWidescreen_GetRight(),128)}:AttachResource(self:getResource("game_mode_main_bd_2"))


	FadingFrame{Name="type_image",Position=POS(64,118),Size=SIZE(512,112)}

	FadingStaticText{Name="type_name",Position=POS(320,67),Align=FONTF_CENTER,Font=fonttitle(),Color=GetPaletteColor(33)}

	Frame{Position=POS(ChloeWidescreen_GetLeft(),244),Size=SIZE(ChloeWidescreen_GetRight(),114)}:AttachResource(self:getResource("game_mode_bd_str"))

	StaticText{Title=TRANSLATOR(CAREER_DESCRIPTION),Position=POS(320,244),Font=fontsmall(),Align=FONTF_CENTER,Color=GetPaletteColor(33)}


	FadingStaticText{Name="type_description",Position=POS(320,275),Size=SIZE(400,110),Font=fontextratiny(),Color=GetPaletteColor(34),Align=FONTF_CENTER}

	GUI:SetMenuSelectionResource(self:getResource("selection_additive_glow"))
