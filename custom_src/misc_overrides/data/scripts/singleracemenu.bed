	{ name=TRANSLATOR(RACETRACKTYPE_CITY), bg="event_city", tracktype=TRACKTYPE_CITY, },
	{ name=TRANSLATOR(RACETRACKTYPE_RACING), bg="event_racing", tracktype=TRACKTYPE_RACING, },
	{ name=L(RACETRACKTYPE_FO1_TOWN), bg="event_fo1_town2", tracktype=TRACKTYPE_FO1_TOWN, },
	{ name=L(RACETRACKTYPE_FO1_PIT), bg="event_fo1_pit1", tracktype=TRACKTYPE_FO1_PIT, },
	{ name=L(RACETRACKTYPE_FO1_WINTER), bg="event_fo1_winter1", tracktype=TRACKTYPE_FO1_WINTER, },
	{ name=L(RACETRACKTYPE_TOUGHTRUCKS), bg="event_toughtrucks1", tracktype=TRACKTYPE_TOUGHTRUCKS, },
	{ name=L(RACETRACKTYPE_RALLYTROPHY), bg="event_rallytrophyfinland1", tracktype=TRACKTYPE_RALLYTROPHY, },
	{ name=L(RACETRACKTYPE_RALLYTROPHYARCADE), bg="event_rallytrophyarcadefinland1", tracktype=TRACKTYPE_RALLYTROPHYARCADE, },
	{ name=TRANSLATOR(RACETRACKTYPE_EVENTS), bg="single_bonus_pic", tracktype=TRACKTYPE_EVENT, },
	{ name=TRANSLATOR(RACETRACKTYPE_STUNT), bg="event_stunt", tracktype=TRACKTYPE_STUNT, },
	{ name=TRANSLATOR(RACETRACKTYPE_DERBY), bg="event_derby", tracktype=TRACKTYPE_DERBY, },
	{ name=TRANSLATOR(RACETRACKTYPE_PITTHEBOMB), bg="event_derby", tracktype=TRACKTYPE_PITTHEBOMB, },
	{ name=TRANSLATOR(RACETRACKTYPE_ARCADE_RACE), bg="event_race", tracktype=TRACKTYPE_ARCADE_RACING, },
	{ name=TRANSLATOR(RACETRACKTYPE_TIME_TRIAL), bg="event_race", tracktype=TRACKTYPE_TIME_TRIAL, },
}




local function create_value(item,parent)
	
	local value=0
	local o

	if item.setting == "PropsEnabled" then
		value=TimeTrial_GetPropsEnabled()
	elseif item.setting == "ThreeLapMode" then
		value=TimeTrial_Get3LapMode()
	elseif item.setting == "TonyHawkTime" then
		value=5
	elseif item.setting == "TonyHawkHandling" then
		value=ChloeCollection_GetStuntHandling()
	elseif item.setting == "NitroType" then
		value=TimeTrial_GetNitroType()
	elseif item.setting and item.setting ~= "" then
		value=db.GameFlow.PreRace[item.setting]
	end


	local arrowsize=GetResourceSize(menu_singleplayer_trackselection:getResource("ingame_options_arrow_left"))
	local parentsize={ parent:GetSize() }

	o=StaticText{Title=item.visualdata[value] or TRANSLATOR(MULTIPLAYER_MESSAGE_ERROR), Position=POS(parent.itempos[1]+9+arrowsize[1]+4,0),Color=GetPaletteColor(34),Font=fontextratiny(),Parent=parent}

	o.item=item
	o.parent=parent

	o.activate = function(self)
		self:SetColor(GetPaletteColor(33),false)

		if table.getn(self.item.data) > 1 then
			local x,y = self.parent:GetPosition()
			local arrowsize=GetResourceSize(menu_singleplayer_trackselection:getResource("ingame_options_arrow_left_glow"))
			local textw=wm.GetTextWidth(self:GetTitle(),fontextratiny())

			menu_singleplayer_trackselection.leftarrow:SetPosition(self.parent.itempos[1]+9,y)--+(parentsize[2]/2-arrowsize[2]/2))
			menu_singleplayer_trackselection.rightarrow:SetPosition(self.parent.itempos[1]+9+arrowsize[1]+4+textw+4,y)--+(parentsize[2]/2-arrowsize[2]/2))
		end
	end

	o.deactivate = function(self)
		self:SetColor(GetPaletteColor(1),false)
		menu_singleplayer_trackselection.leftarrow:StopFlash()
		menu_singleplayer_trackselection.rightarrow:StopFlash()
	end

	o.moveLeft = function(self)
		local value=self:getValue()

		if value > 1 then
			self:setValue(value-1)
		else
			self:setValue(table.getn(self.item.data))
		end

		playmenusound_move()
		self:setTitle()
		menu_singleplayer_trackselection.leftarrow:Flash(-1)
	end

	o.moveRight = function(self)
		local value=self:getValue()
		local maxvalue=table.getn(self.item.data)

		if value < maxvalue then
			self:setValue(value+1)
		else
			self:setValue(1)
		end

		playmenusound_move()
		self:setTitle()
		menu_singleplayer_trackselection.rightarrow:Flash(1)
	end

	

	o.setTitle = function(self)
		local value=self:getValue()		


		local title=self.item.visualdata[value] or TRANSLATOR(MULTIPLAYER_MESSAGE_ERROR)

		if self.item.setting == "Weather" then
			if RaceSelectionState.Level and Levels[RaceSelectionState.Level].Weathers and Levels[RaceSelectionState.Level].Weathers[value] then
				title=weathers[Levels[RaceSelectionState.Level].Weathers[value]] or title
			else
				title=weathers[WEATHER_DAY]
			end
		end

		self:SetTitle(title)


		local textw=wm.GetTextWidth(self:GetTitle(),fontextratiny())

		local _,y=self.parent:GetPosition()--menu_singleplayer_trackselection.rightarrow:GetPosition()
		local arrowsize=GetResourceSize(menu_singleplayer_trackselection:getResource("ingame_options_arrow_left_glow"))

		menu_singleplayer_trackselection.rightarrow:SetPosition(self.parent.itempos[1]+9+arrowsize[1]+4+textw+4,y)

	end

	o.setValue = function(self,value)

		if self.item.action then
			self.item.action(self:getValue(),value)
		end

		self.value=value

		if self.item.setting and self.item.setting ~= "" then
			if RaceSelectionState then
				RaceSelectionState[self.item.setting]=self.item.data[value]
			end
		end
	end


	o.getValue = function(self)

		if not self.value then
			self.value = 1
		end

		local value=self.value
		return value
	end

	o.updateValue = function(self)
		self.value=1
		if self.item.setting and self.item.setting ~= "" then
			local value=nil
			if self.item.setting == "PropsEnabled" then
				value=TimeTrial_GetPropsEnabled()
			elseif self.item.setting == "ThreeLapMode" then
				value=TimeTrial_Get3LapMode()
			elseif self.item.setting == "TonyHawkTime" then
				value=5
			elseif self.item.setting == "TonyHawkHandling" then
				value=ChloeCollection_GetStuntHandling()
			elseif self.item.setting == "NitroType" then
				value=TimeTrial_GetNitroType()
			else
				value=db.GameFlow.PreRace[self.item.setting]
			end
			for k,v in ipairs(self.item.data) do
				if v == value then
					self.value=k
					break
				end
			end
			self:setValue(self.value)
		end
		self:setTitle()
	end

	o:setTitle()

	return o
end

local function create_option(item,parent)


	local o

	parent.title=StaticText{Title=item.title,Position=POS(parent.itempos[1]-9,0),Font=fontextratiny(),Align=FONTF_RIGHT,Color=GetPaletteColor(33),Parent=parent}


	parent.moveLeft = function(self)
		self.value:moveLeft()
	end

	parent.moveRight = function(self)
		self.value:moveRight()
	end


	o=create_value(item,parent)

	parent.value=o

end

local function update_options(options)
	if not IsNormalRace() then return end	

	for k,v in ipairs(options) do
		if v.frame then 
			v.frame.value:updateValue()
		end
	end
end



local function create_options(options,pos)
	
	local pos=pos or POS(0,271)
	local parent

	local itempos=POS(487,0)
	local gfxpos=POS(330,0)

	for k,v in ipairs(options) do
		if v.title then

		
			if v.ypos then
				pos[2]=v.ypos
			end
			
			parent=Frame{Position=pos,Size=SIZE(640,14)}

			parent.gfx={}
			parent.gfx[1]=Frame{Position=gfxpos,Size=SIZE(14,14),Parent=parent}:AttachResource(menu_singleplayer_trackselection:getResource("track_options_bd_black_1"))
			parent.gfx[2]=Frame{Position=POS(gfxpos[1]+14,gfxpos[2]),Size=SIZE(ChloeWidescreen_GetRight(),14),Parent=parent}:AttachResource(menu_singleplayer_trackselection:getResource("track_options_bd_black_2"))

			parent.itempos=CopyTable(itempos)

			parent.activate = function(self)
				self.gfx[1]:AttachResource(menu_singleplayer_trackselection:getResource("track_options_bd_white_1"))
				self.gfx[2]:AttachResource(menu_singleplayer_trackselection:getResource("track_options_bd_white_2"))

				self.value:activate()
			end

			parent.deactivate = function(self)
				self.gfx[1]:AttachResource(menu_singleplayer_trackselection:getResource("track_options_bd_black_1"))
				self.gfx[2]:AttachResource(menu_singleplayer_trackselection:getResource("track_options_bd_black_2"))


				self.value:deactivate()
			end

			parent.onPressed = function(self)
				if self.value.onPressed then
					self.value:onPressed()
				end
			end

			create_option(v,parent)

			v.frame=parent

			parent:deactivate()

		end

		pos[2] = pos[2] + 15

		gfxpos[1] = gfxpos[1] + 4
	end
end


