-- ChloeCustom: vanilla FOUC career (classes.bed from the original game), cars/levels converted
-- to CarIndex/LevelIndex. Generated by custom_src/make_vanilla_singleplayer.py, do not edit.
if not Levels then
	-- levels.bed is needed for stunt names
	dofile( "data/scripts/levels.bed" )
end

if not CarIndex then
	-- cars.bed is needed for car indices (ChloeCustom)
	dofile( "data/scripts/cars.bed" )
end

-- Table multiplier helper function
function multable(table, multiplier)
	local newtable = {}
	for k, v in pairs( table ) do
		newtable[k] = v * multiplier
	end
	return newtable
end

-- Table adder helper function
function addtable(table, addition)
	local newtable = {}
	for k, v in pairs( table ) do
		newtable[k] = v + addition
	end
	return newtable
end

