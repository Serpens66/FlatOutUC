menu_carselection = CreateMenuFromTemplate("template_cars")


dofile("data/menu/cup_next_race_elements.bed")
dofile("data/menu/upgrade_and_car_bd.bed")
dofile("data/menu/garage_elements_2.bed")

function GetCarData(car_idx)
	return db.FlatOut2.Cars:GetProperty("Car",car_idx)
end

function SortCarsByClass(cars)
	local sort=function(a,b)
		if a.index and b.index then
			local ac = Garage:GetCarClass(a.index)
			local bc = Garage:GetCarClass(b.index)

			if ac < bc then return true end
			
			if ac == bc then 
				return a.index < b.index 
			end
		end
		return false
	end
	table.sort(cars,sort)
	return cars
end

function SortCarsByClassAndTier(cars)
	local sort=function(a,b)
		if a.index and b.index then
			local ac = Garage:GetCarClass(a.index)
			local bc = Garage:GetCarClass(b.index)

			if ac < bc then return true end
			
			if ac == bc then
				local at = ChloeCollection_GetCarTier(a.index)
				local bt = ChloeCollection_GetCarTier(b.index)
	
				if at < bt then return true end
				
				if at == bt then
					local ap = Garage:GetCarValue(a.index)
					local bp = Garage:GetCarValue(b.index)
		
					if ap < bp then return true end
					
					if ap == bp then
						return a.index < b.index 
					end
				end
			end
		end
		return false
	end
	table.sort(cars,sort)
	return cars
end

function IsValidCarIncludeTemp350(car_idx)
	if not ChloeCustom_IsFO2Car(car_idx) then return false end -- custom (used by Chloe's multiplayer lobby)
	local function SplitString(str)
		local t={}		
		for w in string.gfind(str,"(%w+)%.?") do
			table.insert(t,w)
		end
		return t
	end

	local car=db.FlatOut2.Cars:GetProperty("Car",car_idx)
	
	local path=SplitString(string.lower(car:GetFullPath()))
	
	if ChloeCollection_GetCarMatchupInverse(car_idx) then
		return false
	end

	return true
end

function IsValidCarNoTemp350(car_idx)
	if not ChloeCustom_IsFO2Car(car_idx) then return false end -- custom (used by Chloe's multiplayer lobby)
	local function SplitString(str)
		local t={}		
		for w in string.gfind(str,"(%w+)%.?") do
			table.insert(t,w)
		end
		return t
	end

	local car=db.FlatOut2.Cars:GetProperty("Car",car_idx)
	
	local path=SplitString(string.lower(car:GetFullPath()))

	if car_idx ~= CarIndex.PropModern5 and string.find(car:GetFullPath(), ".Prop")~=nil then
		return false
	end
	
	if ChloeCollection_DoesCarHaveCheatCode(car_idx) then
		return false
	end
	
	if ChloeCollection_GetCarMatchupInverse(car_idx) then
		return false
	end

	return true
end

function IsValidCarIncludeTemp350NoProps(car_idx)
	if not ChloeCustom_IsFO2Car(car_idx) then return false end -- custom (used by Chloe's multiplayer lobby)
	local function SplitString(str)
		local t={}		
		for w in string.gfind(str,"(%w+)%.?") do
			table.insert(t,w)
		end
		return t
	end

	local car=db.FlatOut2.Cars:GetProperty("Car",car_idx)
	
	local path=SplitString(string.lower(car:GetFullPath()))

	if car_idx ~= CarIndex.PropModern5 and string.find(car:GetFullPath(), ".Prop")~=nil then
		return false
	end
	
	if ChloeCollection_GetCarMatchupInverse(car_idx) then
		return false
	end

	return true
end

-- custom (FlatOutUCChloeCollection_1.83_custom): only FlatOut 2 / Ultimate Carnage cars
-- data folders car_1..car_99 are vanilla, car_201..car_299 are the FlatOut 2 variants
function ChloeCustom_IsFO2Car(car_idx)
	local car=db.FlatOut2.Cars:GetProperty("Car",car_idx)
	if not car or not car.DataPath then return true end
	local _,__,index=string.find(string.lower(car.DataPath),"car_(%d+)/")
	index=tonumber(index)
	if not index then return true end
	return index < 100 or (index > 200 and index < 300)
end

function IsValidCar(car_idx)
	if not ChloeCustom_IsFO2Car(car_idx) then return false end -- custom
	local function SplitString(str)
		local t={}		
		for w in string.gfind(str,"(%w+)%.?") do
			table.insert(t,w)
		end
		return t
	end

	local car=db.FlatOut2.Cars:GetProperty("Car",car_idx)
	
	local path=SplitString(string.lower(car:GetFullPath()))

	if string.find(car:GetFullPath(), ".Prop")~=nil and (not ChloeCollection_DoesCarHaveCheatCode(car_idx) or ChloeCollection_IsCarLockedByCheatCode(car_idx)) then
		if car_idx ~= CarIndex.PropModern5 and not ChloeCollection_ArePropCarsUnlocked() then
			return false
		end
	elseif ChloeCollection_IsCarLockedByCheatCode(car_idx) then
		return false
	end
	
	if ChloeCollection_GetCarMatchupInverse(car_idx) then
		return false
	end

	return true
end

function IsValidCarIncludeMatchups(car_idx)
	if not ChloeCustom_IsFO2Car(car_idx) then return false end -- custom
	local function SplitString(str)
		local t={}		
		for w in string.gfind(str,"(%w+)%.?") do
			table.insert(t,w)
		end
		return t
	end

	local car=db.FlatOut2.Cars:GetProperty("Car",car_idx)
	
	local path=SplitString(string.lower(car:GetFullPath()))

	if string.find(car:GetFullPath(), ".Prop")~=nil and (not ChloeCollection_DoesCarHaveCheatCode(car_idx) or ChloeCollection_IsCarLockedByCheatCode(car_idx)) then
		if car_idx ~= CarIndex.PropModern5 and not ChloeCollection_ArePropCarsUnlocked() then
			return false
		end
	elseif ChloeCollection_IsCarLockedByCheatCode(car_idx) then
		return false
	end

	return true
end

function IsValidCarForCareer(car_idx)
	local car=db.FlatOut2.Cars:GetProperty("Car",car_idx)
	
	--if not Settings["Game"]["CareerRallyTrophyCars"] and string.find(car:GetFullPath(), ".RT")~=nil then
	if string.find(car:GetFullPath(), ".RT")~=nil then
		return false
	end

	return true
end

function IsValidAndPurchasedCar(car_idx)
	if not Garage:IsCarPurchased(car_idx) then
		return false
	end

	local function SplitString(str)
		local t={}		
		for w in string.gfind(str,"(%w+)%.?") do
			table.insert(t,w)
		end
		return t
	end

	if Garage:GetCarSkinIndex(car_idx) > ChloeSkins_GetNumSkinsForCar(car_idx) then
		Garage:SetCarPurchased(car_idx, false)
		return false
	end

	local car=db.FlatOut2.Cars:GetProperty("Car",car_idx)
	local path=SplitString(string.lower(car:GetFullPath()))
	if path[3] == "bonus" or path[3] == "stunt" then
		Garage:SetCarPurchased(car_idx, false)
		return false
	end
	return true
end

function IsStuntCar(car)
	local cars=StuntCars

	if not cars then return false end

	for k,v in pairs(cars) do
		if car == v then return true end
	end

end

function CarlistAllCars()
	local cars={}
	local locked={}

	for i=0,Garage:GetNumCars()-1 do
		if IsValidCar(i) then
			local t={}
			t.index=i
			if Garage:IsCarLocked(i) then
				table.insert(locked,t)
			else
				table.insert(cars,t)
			end
		end
	end

	for k,v in pairs(locked) do
		table.insert(cars,v)
	end

	return SortCarsByClass(cars)
end

function CarlistUnpurchasedFromClass(index)
	local cars=Classes[index].ClassCars

	local t={}
	local locked={}

	if not cars then LOG("CarlistUnpurchasedFromClass: class %d doesn't have ClassCars",index); return t; end

	for k,v in pairs(cars) do
		if IsValidCar(v) and IsValidCarForCareer(v) and not IsValidAndPurchasedCar(v) and (not ChloeCollection_GetCarMatchup(v) or not IsValidAndPurchasedCar(ChloeCollection_GetCarMatchup(v))) then
			if Garage:IsCarLocked(v) then
				table.insert(locked,{index=v})
			else
				table.insert(t,{ index=v })
			end
		end
	end
	
	SortCarsByClassAndTier(t)
	SortCarsByClassAndTier(locked)

	for k,v in pairs(locked) do
		table.insert(t,v)
	end

	return t
end

function CarlistFromClassStart(index,only_purchased,all_cars)
	local cars=Classes[index].ClassCars

	local t={}
	local locked={}


	if not cars then LOG("CarlistFromClass: class %d doesn't have ClassCars",index); return t; end

	for k,v in pairs(cars) do
		if IsValidCar(v) and IsValidCarForCareer(v) then
			if only_purchased then
				if IsValidAndPurchasedCar(v) then
					table.insert(t,{ index=v })
				end
			else
				if all_cars or not Garage:IsCarLocked(v) then
					if Garage:IsCarLocked(v) then
						table.insert(locked,{index=v})
					else
						table.insert(t,{ index=v })
					end
				end
			end
		end
	end
	
	SortCarsByClassAndTier(t)
	SortCarsByClassAndTier(locked)

	for k,v in pairs(locked) do
		table.insert(t,v)
	end

	return t
end

function CarlistFromClass(index,only_purchased,all_cars)
	local cars=Classes[index].ClassCars

	local t={}
	local locked={}


	if not cars then LOG("CarlistFromClass: class %d doesn't have ClassCars",index); return t; end

	for k,v in pairs(cars) do
		if only_purchased then
			if IsValidCarIncludeMatchups(v) and IsValidAndPurchasedCar(v) then
				table.insert(t,{ index=v })
			end
		elseif IsValidCar(v) then
			if all_cars or not Garage:IsCarLocked(v) then
				if Garage:IsCarLocked(v) then
					table.insert(locked,{index=v})
				else
					table.insert(t,{ index=v })
				end
			end
		end
	end
	
	if not all_cars then
		SortCarsByClassAndTier(t)
		SortCarsByClassAndTier(locked)
	end

	for k,v in pairs(locked) do
		table.insert(t,v)
	end

	return t
end

function CarlistAllUnlocked()
	local t={}

	for i=0,db.FlatOut2.Cars:GetPropertyArraySize("Car")-1 do

		if IsValidCar(i) and not Garage:IsCarLocked(i) and not IsStuntCar(i) then
			table.insert(t,{ index=i })
		end
	end


	return SortCarsByClass(t)
end

function CarlistStuntCars()
	local cars=StuntCars

	local t={}

	if not cars then LOG("CarlistStuntCars: StuntCars not defined."); return t; end

	for k,v in pairs(cars) do
		if IsValidCar(v) then
			table.insert(t,{ index=v })
		end
	end

	return t
end

function CarlistStuntCarsUnlocked()
	local cars=StuntCars

	local t={}

	if not cars then LOG("CarlistStuntCars: StuntCars not defined."); return t; end

	for k,v in pairs(cars) do
		if IsValidCar(v) and not Garage:IsCarLocked(v) then
			table.insert(t,{ index=v })
		end
	end

	return t
end


function CarlistAllPurchased()
	local cars={}

	for i=0,Garage:GetNumCars()-1 do
		if IsValidCarIncludeMatchups(i) and IsValidAndPurchasedCar(i) then
			local t={}
			t.index=i
			table.insert(cars,t)
		end
	end

	return SortCarsByClassAndTier(cars)
end

function GetCarDataIndex(car_idx)
	local index=1

	local car_data=db.FlatOut2.Cars:GetProperty("Car",car_idx)

	local _,__,index=string.find(car_data.DataPath,"_(%d+)/")


	return index
end


function EnterCarSelection(okaction,backaction,carlist,purchase,all_available,only_description,show_tutorial,background,testtrack_menudata,show_class,title,hide_menubar_car,nocolor,nodescription,noswap)
	menu_carselection.carlist=carlist or CarlistAllCars()
	menu_carselection.backaction=backaction
	menu_carselection.okaction=okaction
	menu_carselection.shop_mode=purchase
	menu_carselection.show_class=show_class
	menu_carselection.show_tutorial=show_tutorial
	menu_carselection.all_available=all_available
	menu_carselection.only_description=only_description
	menu_carselection.background=background
	menu_carselection.testtrack_menudata=testtrack_menudata
	menu_carselection.title=title
	menu_carselection.hide_menubar_car=hide_menubar_car
	menu_carselection.nocolor=nocolor
	menu_carselection.nodescription=nodescription
	menu_carselection.noswap=noswap
	EnterMenu("menu_carselection")
end

