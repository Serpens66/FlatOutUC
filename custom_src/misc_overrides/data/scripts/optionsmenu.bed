local function get_undo(options)
	local t={}

	for k,v in ipairs(options) do
		if v.frame then
			t[k]=v.frame.value:getValue()
		end
	end

	return t
end


local function do_undo(options,values)
	for k,v in ipairs(options) do
		if v.frame then
			v.frame.value:setValue(values[k])
			v.frame.value:setTitle()
		end
	end

end

local function settings_changed(options,values)
	if not options or not values then 
		return false
	end

	for k,v in ipairs(options) do
		if v.frame then
			if v.frame.value:getValue() ~= values[k] then
				return true
			end
		end
	end

	return false
end

reset_defaults = function()
	GUI:DefaultSettings()
	Event:PostEvent(event(EVENT_MUSIC_PLAY_TITLE))
	menu_options.changed=true

	for k,v in pairs(W("inputhandler").options) do
		if type(v) == "table" and v.frame then
			v.frame.value:setTitle()
		end
	end

end

local function toggle_forcefeedback()
	if Settings.Control.ForceFeedback then
		Settings.Control.ForceFeedback=FALSE
		if W("vibration_status") then
			W("vibration_status"):SetTitle(TRANSLATOR(OPTIONS_OFF))
		end
	else
		if W("vibration_status") then
			W("vibration_status"):SetTitle(TRANSLATOR(OPTIONS_ON))
			GUI:SetVibration()
		end
		Settings.Control.ForceFeedback=TRUE
	end
	menu_options.changed=true
end


change_controller_actionmap = function(old_controller,new_controller)
	
	if old_controller and Input.GetControllerType(old_controller) ~= Input.CONTROLLER_TYPE_XBOXGAMEPAD then
		Input.SaveActionMap(old_controller)
	end
	
	if Input.GetControllerType(new_controller) == Input.CONTROLLER_TYPE_XBOXGAMEPAD then
		if W("controller") then
			W("controller").handle=AnimateWindowAlpha(W("controller"),W("controller"):GetAlpha(),1.0,0.2,0.0,W("controller").handle)
			show_layout(Settings.Control.ControllerLayout+1)			
		end
	else
		if W("controller") then
			hide_layout()		
			W("controller").handle=AnimateWindowAlpha(W("controller"),W("controller"):GetAlpha(),0.0,0.2,0.0,W("controller").handle)
		end
		Input.LoadActionMap(new_controller)		
	end
	
	--//turn force feedback off
	if new_controller == 0 and Settings.Control.ForceFeedback then
		toggle_forcefeedback()
	end

	Settings.Control.ControllerGuid=Input.GetControllerGuid(new_controller)


	i=1
	if W("inputhandler") then
		for k,v in ipairs(W("inputhandler").options) do
			local frame=v.frame
			if i > 1 and frame then
				if Input.GetControllerType(new_controller) == Input.CONTROLLER_TYPE_XBOXGAMEPAD then	
					frame.handle=AnimateWindowAlpha(frame,frame:GetAlpha(),0.0,0.2,0.0,frame.handle)
					frame.title.handle=AnimateWindowAlpha(frame.title,frame.title:GetAlpha(),0.0,0.2,0.0,frame.title.handle)
					frame.value.handle=AnimateWindowAlpha(frame.value,frame.value:GetAlpha(),0.0,0.2,0.0,frame.value.handle)
					if frame.gfx[1] then
						frame.gfx[1].handle=AnimateWindowAlpha(frame.gfx[1],frame.gfx[1]:GetAlpha(),0.0,0.2,0.0,frame.gfx[1].handle)
					end
					frame.disabled=true
				else
					local alpha = 1
					if frame.gfx[1] then
						frame.gfx[1].handle=AnimateWindowAlpha(frame.gfx[1],frame.gfx[1]:GetAlpha(),alpha,0.2,0.0,frame.gfx[1].handle)
					end
					frame.title.handle=AnimateWindowAlpha(frame.title,frame.title:GetAlpha(),alpha,0.2,delay,frame.title.handle)
					frame.value.handle=AnimateWindowAlpha(frame.value,frame.value:GetAlpha(),alpha,0.2,delay,frame.value.handle)
					frame.value:setTitle()
					frame.disabled=false
				end
			end
			i = i + 1
		end
	end
end


local function get_pc_controllers()

	local item=key_config[1] --options_controller[6]

	item.data={}
	for i=0,Input.GetNumControllers()-1 do
		table.insert(item.data,Input.GetControllerName(i))
	end

	item.action=change_controller_actionmap

end



local remapWindow


local function end_remap(controller)
	if remapWindow then
		Input.RemapEnd(controller)

		for k,v in pairs(W("inputhandler").options) do
			if v.frame then
				v.frame.value:setTitle()
			end
		end
		remap_active = false
		Input.SaveActionMap(controller)
		remapWindow=nil
		wm.SetExclusive(nil)
	end
end


start_remap = function(window,controller,button)

	remap_active = true

	if not remapWindow then
		remapWindow=window

		wm.SetExclusive(window)

		Input.RemapBegin(controller,button)
		remapWindow:setTitle(Input.CONTROLLER_REMAP_PENDING)
		wm.RepostEvent()
	else
		if Input.Remap(controller) ~= Input.CONTROLLER_REMAP_PENDING then
			end_remap(controller)
		else
			wm.RepostEvent()
		end

	end
end


local function enter_controller()
	GUI:HideMenuButtons()
	menu_options.in_controller=true
	GUI:SetHelpButtons(BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))

	Event:AddTimer(function()
						menu_options.items=menu_options.controlleritems
						GUI:InitMenuButtons(menu_options.items)
						GUI:SetActiveItem(Settings.Control.ControllerLayout+1)
						GUI:ShowMenuButtons()
					end, 0.4,nil,TRUE)
end

local function exit_controller()
	GUI:HideMenuButtons()
	menu_options.in_controller=nil
	GUI:SetHelpButtons(BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))

	Event:AddTimer(function()
						menu_options.items=menu_options.defaultitems
						GUI:InitMenuButtons(menu_options.items)
						GUI:SetActiveItem(3)
						GUI:ShowMenuButtons()
					end, 0.4,nil,TRUE)
end


set_custom_preset_parameter = function(param,newv)
	if Settings.Visual.QualityPreset == 3 then
		Settings["Visual"]["CustomPreset"..param] = newv
	end
end

get_custom_preset_parameter = function(param)
	return Settings["Visual"]["CustomPreset"..param]
end

local function set_visual_preset(oldv,newv)

	if newv == 3 then
		local preset = quality_presets[1]
		for k,v in ipairs(preset) do
			local w = W(v.window)
			
			if w then 
				w.disabled=false
				w.title:SetAlpha(1.0)
				w.value:SetAlpha(1.0)			
				if w.value.textvalue then
					w.value.textvalue:SetAlpha(1.0)
				end
				
				w.value:setValue(get_custom_preset_parameter(w.value.item.setting))
				w.value:setTitle()
			end
		end
	else
		local preset = quality_presets[newv+1]
		local options = options_visual_pc
		
		for k,v in ipairs(preset) do
			local w = W(v.window)
			
			if w then
				w.disabled=true
				w.value:setValue(v.value)
				w.value:setTitle()
				w.title:SetAlpha(0.7)
				w.value:SetAlpha(0.7)
				if w.value.textvalue then
					w.value.textvalue:SetAlpha(0.7)
				end		
			else
				OUTPUTDEBUGSTRING(string.format("preset:window %s not found",v.window))
			end
		end
	end
	

end


menu_options = CreateMenuFromTemplate("template_basic")




menu_options.options.title=TRANSLATOR(TITLE_OPTIONS)
menu_options.options.forgetselection=true 
menu_options.backmenuname="menu_mainmenu" 
menu_options.back=function() 
							if menu_options.in_controller then
								exit_controller()
							else
								GUI:SetVisualQualityParameters()							
								if menu_options.changed then   --if PC or menu_options.changed then
									if PS2 then
										if menu_options.old_channelmode ~= Settings.Audio.ChannelMode then
											AUDIO.ResetSpeakerMode()
										end
									end
									ProfileSave(Save.GetLastSaveSlotUsed(),entermenu(menu_options.backmenuname),entermenu("menu_options"))
								else 
									EnterMenu(menu_options.backmenuname) 
								end
							end
							menu_options.backmenuname="menu_mainmenu" -- reset it back to make sure main menu options still works
					end


local function set_focus(category)
	
	local w=W("inputhandler")
	w:SetFocus()
	w.item=nil
	w.undo=get_undo(options[category])

	w.category=category
	w.options=options[category]
	
	if category == CATEGORY_REMAP and Input.GetControllerType(Settings.Control.Controller) == Input.CONTROLLER_TYPE_XBOXGAMEPAD then
		show_options(options[category],false,1)
	else
		show_options(options[category],true)
	end
	
	w:activate(1)


	if category == CATEGORY_REMAP then
		local bd=W("bd_middle")
		bd.handle=AnimateWindowSize(bd,{ bd:GetSize() },SIZE(ChloeWidescreen_GetRight(),341),0.2,0.0,bd.handle)

		local bd=W("bd_lower")
		bd.handle=AnimateWindowPos(bd,{ bd:GetPosition() },POS(0,420),0.2,0.0,bd.handle)
	end

	GUI:HideMenuButtons()
	GUI:SetHelpButtons(BUTTON_BACK,TRANSLATOR(UI_BACK))

end


function menu_options.create(self)
	self.parent:create(self)

	local iconname="icon_xbox_vibration_on"

	if Input.GetControllerType(GUI:GetMenuController()-1) == Input.CONTROLLER_TYPE_WHEEL then
		self.is_wheel=true
	else
		self.is_wheel=nil
	end

	self:addResource("xbox_controller.tga",xbox_controller,xbox_controller_size)
	options_visual_pc[7].action = set_visual_preset

	self:loadResources()

	

	self.controlleritems = {
		MENUITEM(TRANSLATOR(ICON_OPTIONS_LAYOUT_1),function() Settings.Control.ControllerLayout=0; menu_options.changed=true; exit_controller() end,ICON(self,"icon_preset_1")),
		MENUITEM(TRANSLATOR(ICON_OPTIONS_LAYOUT_2),function() Settings.Control.ControllerLayout=1; menu_options.changed=true; exit_controller() end,ICON(self,"icon_preset_2")),
		MENUITEM(TRANSLATOR(UI_VIBRATION),toggle_forcefeedback,ICON(self,iconname))
	}

	self.defaultitems={}

	self.defaultitems[1]=MENUITEM(TRANSLATOR(ICON_OPTIONS_GAMEOPTIONS),function() set_focus(1) end,ICON(self,"icon_game_options"))
	self.defaultitems[2]=MENUITEM(TRANSLATOR(ICON_OPTIONS_VISUALOPTIONS),function() set_focus(2) end,ICON(self,"icon_game_options"))
	self.defaultitems[3]=MENUITEM(L("PLAYER OPTIONS"),function() set_focus(3) end,ICON(self,"icon_change_profiles"))
	self.defaultitems[4]=MENUITEM(TRANSLATOR(ICON_OPTIONS_SOUNDOPTIONS),function() set_focus(4) end,ICON(self,"icon_sound_options"))
	self.defaultitems[5]=MENUITEM(L("MUSIC OPTIONS"),function() set_focus(5) end,ICON(self,"icon_sound_options"))
	self.defaultitems[6]=MENUITEM(TRANSLATOR(ICON_OPTIONS_CONTROLLEROPTIONS),function() set_focus(6) end,ICON(self,"icon_controller_options"))
	self.defaultitems[CATEGORY_REMAP]=MENUITEM(TRANSLATOR(ICON_OPTIONS_CONFIGURECONTROLS),function() set_focus(CATEGORY_REMAP) end,ICON(self,"icon_controller_options"))
	self.defaultitems[8]=MENUITEM(L("ONLINE OPTIONS"),function() set_focus(8) end,ICON(self,"icon_online"))
	if not ChloeNet_IsConnected() then
		self.defaultitems[9]=MENUITEM(L("ENTER NAME"),function() EnterMenu("menu_options_playername") end,ICON(self,"icon_edit_events"))
	end

	options[1]=options_game_pc
	options[2]=options_visual_pc
	options[3]=options_player
	options[4]=options_sound
	options[5]=options_soundtrack
	options[6]=options_controller
	options[CATEGORY_REMAP]=key_config
	if ChloeNet_IsUsingZMenu() then
		options[8]=options_network_nozmenu
	else
		options[8]=options_network
	end

	get_pc_controllers()
	change_controller_actionmap(nil,Settings.Control.Controller)
	
	self.items = self.defaultitems

	menu_options.changed=nil

end

local old_remap

function menu_options.init(self)
	self.parent:init(self)



	Frame{Position=POS(ChloeWidescreen_GetLeft(),26),Size=SIZE(ChloeWidescreen_GetRight(),44)}:AttachResource(self:getResource("title_bd"))

	Frame{Name="bd_upper",Position=POS(ChloeWidescreen_GetLeft(),74),Size=SIZE(ChloeWidescreen_GetRight(),5)}:AttachResource(self:getResource("black75_bd"))
	Frame{Name="bd_middle",Position=POS(ChloeWidescreen_GetLeft(),79),Size=SIZE(ChloeWidescreen_GetRight(),300)}:AttachResource(self:getResource("black50_bd"))
	Frame{Name="bd_lower",Position=POS(ChloeWidescreen_GetLeft(),300+79),Size=SIZE(ChloeWidescreen_GetRight(),5)}:AttachResource(self:getResource("black75_bd"))

	FadingStaticText { Name="infotext", Title=L"", Font=fontextratiny(), Position=POS(320,430), Size=SIZE(500,38), Color=GetPaletteColor(34), Align=FONTF_CENTER }

	local tbl
	local prefix

	controller_layouts=xbox_layouts
	pad_layout=xbox_pad_layout
	tbl=xbox_controller
	prefix="xbox_"

	controller.pad=self:getResource("controller")

	self.leftarrow = CreateArrow(self, "leftarrow", "ingame_options_arrow_left")
	self.rightarrow = CreateArrow(self, "rightarrow", "ingame_options_arrow_right")
	self.leftarrow:HideWindow()
	self.rightarrow:HideWindow()

	for k,v in pairs(options) do
		create_options(v)
	end
	
	if self.is_wheel then
		create_options(options_controller_pad)
		hide_options(options_controller_pad)
	else
		create_options(options_controller_wheel)
		hide_options(options_controller_wheel)
	end

	local input=InputHandler{Name="inputhandler"}

	if PC then
		local w=Frame{Name="controller",Position=POS(226,162+43),Size=SIZE(189,131)}
		w:AttachResource(controller.pad)
		w:SetAlpha(0)

		--//StaticText{Name="vibration_title",Title=TRANSLATOR(UI_VIBRATION),Position=POS(302,315),Align=FONTF_RIGHT,Font=fontextratiny(),Color=GetPaletteColor(33)}:SetAlpha(0)
		--//StaticText{Name="vibration_status",Position=POS(340,315),Font=fontextratiny(),Color=GetPaletteColor(34)}:SetAlpha(0)

		create_layouts()
	end

	input.onKeyPressed = function(self,character,virtualkey,scancode)
	
		if virtualkey == KeyCodes.BUTTON_SELECT then
			self:deactivate(self.item)
			
			if not old_remap then
				menu_options.changed=menu_options.changed or settings_changed(self.options,self.undo)
				if self.category == CATEGORY_REMAP and Input.GetControllerType(Settings.Control.Controller) == Input.CONTROLLER_TYPE_XBOXGAMEPAD then
					show_options(options[self.category],false,1)
				else
					show_options(options[self.category])
				end
			
				
				playmenusound_back()
				GUI:SetActiveItem(self.category)
				
				GUI:ShowMenuButtons()
				GUI:SetHelpButtons(BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))
				self.undo=nil

				menu_options.leftarrow:HideWindow()
				menu_options.rightarrow:HideWindow()
				
				wm.GetWindow("infotext"):SetTitle(L"")
			else
				self:activate(self.item)
			end
		elseif virtualkey == KeyCodes.BUTTON_START then
			if self.options[self.item].frame.value.item.type ~= TYPE_KEY then
				playmenusound_action()
			end

			self.options[self.item].frame:onPressed()

		elseif virtualkey == KeyCodes.BUTTON_LEFT then
			playmenusound_move()
			self.options[self.item].frame:moveLeft()
		
			local infotext = wm.GetWindow("infotext")
			if self.options[self.item].descriptions then
				infotext:SetTitle(self.options[self.item].descriptions[self.options[self.item].frame.value:getValue()+1])
				infotext:WordWrap()
			end
		elseif virtualkey == KeyCodes.BUTTON_RIGHT then
			playmenusound_move()
			self.options[self.item].frame:moveRight()
			
			local infotext = wm.GetWindow("infotext")
			if self.options[self.item].descriptions then
				infotext:SetTitle(self.options[self.item].descriptions[self.options[self.item].frame.value:getValue()+1])
				infotext:WordWrap()
			end
		elseif virtualkey == KeyCodes.BUTTON_DOWN then
			local maxitems=table.getn(self.options)

			local value = self.item+1
			if value > maxitems then
				value=1
			end

			while not self.options[value] or not self.options[value].frame or self.options[value].frame.disabled or not self.options[value].title do
				value=value + 1
				if value > maxitems then
					value=0
				end
			end
			
			self:activate(value)
			
			playmenusound_move()

		elseif virtualkey == KeyCodes.BUTTON_UP then

			local value=self.item-1
			if value < 1 then
				value=table.getn(self.options)
			end

			while not self.options[value].frame or self.options[value].frame.disabled or not self.options[value].title do
				value=value-1

				if value < 1 then
					value=table.getn(self.options)
				end
			end
			
			self:activate(value)

			playmenusound_move()
		end
	end

	input.activate = function(self,item)

		local old_type

		if self.item then
			self:deactivate(self.item)
			old_type=self.options[self.item].type
		else
			--//old_type=self.options[item].type
		end


		self.item=item

		if old_type ~= self.options[item].type then
			if self.options[item].type == TYPE_COMMAND or self.options[item].type == TYPE_KEY then
				GUI:SetHelpButtons(BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))
			else
				GUI:SetHelpButtons(BUTTON_BACK,TRANSLATOR(UI_BACK))
			end
		end
		
		local infotext = wm.GetWindow("infotext")
		if self.options[item].descriptions then
			infotext:SetTitle(self.options[self.item].descriptions[self.options[self.item].frame.value:getValue()+1])
			infotext:WordWrap()
		elseif self.options[item].description then
			infotext:SetTitle(self.options[item].description)
			infotext:WordWrap()
		else
			infotext:SetTitle(L"")
		end

		self.options[item].frame:activate()

	end

	input.deactivate = function(self,item)
		if not item then return end

		self.options[item].frame:deactivate()
	end




	GUI:SetHelpButtons(BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))
	--//GUI:SetBackground("data/menu/canvas_bg.tga")
	GUI:SetBackgroundVideo("data/video/bg_main")
end


function menu_options.deinit(self)
	self.parent:deinit(self)
	

end

function menu_options.update(self, time)
	local oldwheel=self.is_wheel
	
	if old_remap ~= remap_active then
		old_remap = remap_active
	end
	

	if self.leftarrow:IsVisible() then
		self.leftarrow:AnimateAlpha(time)
	end
	if self.rightarrow:IsVisible() then
		self.rightarrow:AnimateAlpha(time)
	end

	--if ChloeWidescreen_WasWidescreenToggled() then
	--	for k,v in pairs(options) do
	--		recreate_options_for_widescreen(v)
	--	end
	--end
end

function menu_options.buttonChange(self,oldbutton,newbutton)
	
	self.current_button=newbutton

	local is_xbox_controller = false
	if Input.GetControllerType(Settings.Control.Controller) == Input.CONTROLLER_TYPE_XBOXGAMEPAD then
		is_xbox_controller=true
	end

	if menu_options.in_controller then
		show_layout(newbutton)
	else
		if newbutton == CATEGORY_REMAP  then
			if is_xbox_controller then
				W("controller").handle=AnimateWindowAlpha(W("controller"),W("controller"):GetAlpha(),1.0,0.2,0.0,W("controller").handle)
				show_layout(Settings.Control.ControllerLayout+1)
			else
				hide_layout()
				W("controller").handle=AnimateWindowAlpha(W("controller"),W("controller"):GetAlpha(),0.0,0.2,0.0,W("controller").handle)
			end
		else
			W("controller").handle=AnimateWindowAlpha(W("controller"),W("controller"):GetAlpha(),0.0,0.2,0.0,W("controller").handle)
			hide_layout()
		end

		for k,v in ipairs(options) do
			if k == newbutton then
				if newbutton == CATEGORY_REMAP and is_xbox_controller then
					show_options(v,false,1)
				else
					show_options(v)
				end
			else
				hide_options(v)
			end
		end
	end
end

menu_options_playername = CreateMenuFromTemplate("template_basic")

menu_options_playername.options.title=L("PLAYER NAME")

menu_options_playername.back=entermenu("menu_options")

function menu_options_playername.create(self)
	self.parent:create(self)

	self:loadResources()
end

function menu_options_playername.init(self)
	self.parent:init(self)

	self.checked=false
	
	ChloeInput_OpenInputWindow(L("PLAYER NAME"), 16)
	GUI:HideMenuButtons()

	GUI:SetBackgroundVideo("data/video/bg_main")
end

function menu_options_playername.deinit(self)
	self.parent:deinit(self)
	
	ChloeInput_CloseInputWindow()
end

function menu_options_playername.update(self)
	if ChloeInput_IsInputWindowCanceled() then
		self.checked=true
		EnterMenu("menu_options")
	else
		local r=ChloeInput_GetInputText()
		if not self.checked and r then
			PlayerProfile:SetName(r)
			self.checked=true
			self.timerhandle=Event:AddTimer(function() EnterMenu("menu_options") end,500,nil,TRUE)
		end
	end
end