--// 
--// ---------------------------------------------------------------------------------------------------------------------------------

local function create_option(item,parent)
	local o

	if item.type == TYPE_LABEL then
		parent.title=StaticText{Title=item.title,Position=POS(parent.itempos[1],2),Font=fontextratiny(),Align=FONTF_CENTER,Color=GetPaletteColor(33),Parent=parent}
	else
		parent.title=StaticText{Title=item.title,Position=POS(parent.itempos[1]-18,2),Font=fontextratiny(),Align=FONTF_RIGHT,Color=GetPaletteColor(33),Parent=parent}
	end


	parent.moveLeft = function(self)
		self.value:moveLeft()
	end

	parent.moveRight = function(self)
		self.value:moveRight()
	end


	if item.type == TYPE_VALUE then
		o=create_value(item,parent)
	elseif item.type == TYPE_SLIDER then
		o=create_slider(item,parent)
	elseif item.type == TYPE_COMMAND or item.type == TYPE_LABEL then
		o=create_command(item,parent)
	elseif item.type == TYPE_KEY then
		o=create_key(item,parent)
	else
		error("invalid option type")
	end

	parent.value=o
	parent.title:SetAlpha(0)

end




local function create_options(options,pos)
	
	local pos=pos or POS(0,84)
	local parent

	local itempos=POS(320,4)
	local gfxpos=POS(104,0)

	if options.title then
		options.titlewindow=StaticText{Title=options.title,Position=POS(320,30),Font=fonttitle(),Align=FONTF_CENTER,Color=GetPaletteColor(33)}
	end

	for k,v in ipairs(options) do
		if v.title then

		
			if v.ypos then
				pos[2]=v.ypos
			end
			
			parent=Frame{Name=v.name,Position=pos,Size=SIZE(640,18)}

			parent.gfx={}
			parent.gfx[1]=Frame{Position=POS(ChloeWidescreen_GetLeft(),0),Size=SIZE(ChloeWidescreen_GetRight(),18),Parent=parent}:AttachResource(menu_options:getResource("black50_bd"))
			parent.gfx[1]:SetAlpha(0)
			parent.gfx[2]=Frame{Position=POS(ChloeWidescreen_GetLeft(),0),Size=SIZE(ChloeWidescreen_GetRight(),18),Parent=parent}:AttachResource(menu_options:getResource("white_transparent"))
			parent.gfx[2]:SetAlpha(0)

			parent.itempos=CopyTable(itempos)

			parent.activate = function(self)
				self.gfx[2]:SetAlpha(0.3)

				self.value:activate()
			end

			parent.deactivate = function(self)
				self.gfx[2]:SetAlpha(0)

				self.value:deactivate()
			end

			parent.onPressed = function(self)
				if self.value.onPressed then
					self.value:onPressed()
				end
			end

			create_option(v,parent)

			v.frame=parent

			parent:deactivate()

		end

		pos[2] = pos[2] + 20
	end
end

local function recreate_options_for_widescreen(options,pos)
	for k,v in ipairs(options) do
		if v.title then
			v.frame.gfx[1].position[1] = ChloeWidescreen_GetLeft()
			v.frame.gfx[2].position[1] = ChloeWidescreen_GetLeft()
			v.frame.gfx[1].size[1] = ChloeWidescreen_GetRight()
			v.frame.gfx[2].size[1] = ChloeWidescreen_GetRight()
		end
	end
end

local function hide_options(options,shownum)
	
	if options.titlewindow then
		options.titlewindow.handle=AnimateWindowAlpha(options.titlewindow,options.titlewindow:GetAlpha(),0.0,0.2,0.0,options.titlewindow.handle)
	end

	for k,v in ipairs(options) do

		local frame=v.frame

		if not shownum or k > shownum then
			if frame then
				frame.handle=AnimateWindowAlpha(frame,frame:GetAlpha(),0.0,0.2,0.0,frame.handle)

				frame.title.handle=AnimateWindowAlpha(frame.title,frame.title:GetAlpha(),0.0,0.2,0.0,frame.title.handle)
				frame.value.handle=AnimateWindowAlpha(frame.value,frame.value:GetAlpha(),0.0,0.2,0.0,frame.value.handle)

				if frame.value.textvalue then
					frame.value.textvalue.handle=AnimateWindowAlpha(frame.value.textvalue,frame.value.textvalue:GetAlpha(),0.0,0.2,0.0,frame.value.textvalue.handle)
				end

				if frame.value.icon then
					frame.value.icon.handle=AnimateWindowAlpha(frame.value.icon,frame.value.icon:GetAlpha(),0.0,0.2,0.0,frame.value.icon.handle)
				end


				if frame.value.leftarrow then
					frame.value.leftarrow.handle=AnimateWindowAlpha(frame.value.leftarrow,frame.value.leftarrow:GetAlpha(),0.0,0.2,0.0,frame.value.leftarrow.handle)
					frame.value.rightarrow.handle=AnimateWindowAlpha(frame.value.rightarrow,frame.value.rightarrow:GetAlpha(),0.0,0.2,0.0,frame.value.rightarrow.handle)
				end

				if frame.gfx[1] then
					frame.gfx[1].handle=AnimateWindowAlpha(frame.gfx[1],frame.gfx[1]:GetAlpha(),0.0,0.2,0.0,frame.gfx[1].handle)
					--//frame.gfx[2].handle=AnimateWindowAlpha(frame.gfx[2],frame.gfx[2]:GetAlpha(),0.0,0.2,0.0,frame.gfx[2].handle)
					--//frame.gfx[3].handle=AnimateWindowAlpha(frame.gfx[3],frame.gfx[3]:GetAlpha(),0.0,0.2,0.0,frame.gfx[3].handle)
				end
			end
		end
	end
end


local function show_options(options,showall,showonly)

	if options.titlewindow then
		options.titlewindow.handle=AnimateWindowAlpha(options.titlewindow,options.titlewindow:GetAlpha(),1.0,0.2,0.0,options.titlewindow.handle)
	end

	for k,v in ipairs(options) do

		
		local frame=v.frame

		if frame then
			local alpha=1
			local delay=0.0

			if frame.disabled then
				alpha = 0.7
			end

			if options.hiddenitems then
				showonly = options.hiddenitems
			end
			
			if not showall and showonly and k > showonly then
				alpha=0
			end
			
			if showall then
				if showonly and k > showonly then
					delay = 0
					alpha = 0
				else
					delay=0.2
				end
			end

			frame.value:setTitle()
	
			
			if frame.value.item.action and menu_options.current_button == 2 then
				frame.value.item.action(frame.value:getValue(),frame.value:getValue())
			end

			--//frame.handle=AnimateWindowAlpha(frame,frame:GetAlpha(),alpha*0.2,0.2,0.0,frame.handle)

			frame.title.handle=AnimateWindowAlpha(frame.title,frame.title:GetAlpha(),alpha,0.2,delay,frame.title.handle)
			frame.value.handle=AnimateWindowAlpha(frame.value,frame.value:GetAlpha(),alpha,0.2,delay,frame.value.handle)

			if frame.value.textvalue then
				frame.value.textvalue.handle=AnimateWindowAlpha(frame.value.textvalue,frame.value.textvalue:GetAlpha(),alpha,0.2,delay,frame.value.textvalue.handle)
			end

			if frame.value.icon then
				frame.value.icon.handle=AnimateWindowAlpha(frame.value.icon,frame.value.icon:GetAlpha(),alpha,0.2,delay,frame.value.icon.handle)
			end


			if frame.value.leftarrow then
				frame.value.leftarrow.handle=AnimateWindowAlpha(frame.value.leftarrow,frame.value.leftarrow:GetAlpha(),alpha,0.2,delay,frame.value.leftarrow.handle)
				frame.value.rightarrow.handle=AnimateWindowAlpha(frame.value.rightarrow,frame.value.rightarrow:GetAlpha(),alpha,0.2,delay,frame.value.rightarrow.handle)
			end

			if frame.gfx[1] then
				frame.gfx[1].handle=AnimateWindowAlpha(frame.gfx[1],frame.gfx[1]:GetAlpha(),alpha,0.2,delay,frame.gfx[1].handle)
				--//frame.gfx[2].handle=AnimateWindowAlpha(frame.gfx[2],frame.gfx[2]:GetAlpha(),alpha,0.2,0.0,frame.gfx[2].handle)
				--//frame.gfx[3].handle=AnimateWindowAlpha(frame.gfx[3],frame.gfx[3]:GetAlpha(),alpha,0.2,0.0,frame.gfx[3].handle)
			end
			

		end
	end
end

local function create_layouts()
	for _,layout in pairs(controller_layouts) do

		for k,v in pairs(pad_layout) do
			if layout[v.key] then
				local pos=CopyTable(v.pos)
				pos[2] = pos[2] + 22

				local w=StaticText{Title=layout[v.key].title or L"",Position=pos,Font=fontextratiny(), Align=v.align}
				w:SetAlpha(0)
				local icon
				if v.icon then
					local iconpos = CopyTable(v.iconpos)
					iconpos[2] = iconpos[2] + 22
					icon=Frame{Position=iconpos,Size=v.iconsize}:AttachResource(menu_options:getResource(v.icon))
				end
				layout[v.key].window=w
				layout[v.key].icon=icon
			end
		end
	end
end

local function create_wheel_layouts()
	for _,layout in pairs(xbox_wheel_layouts) do

		for k,v in pairs(xbox_wheel_layout) do
			if layout[v.key] then
				local pos=CopyTable(v.pos)
				pos[2] = pos[2] + 22

				local w=StaticText{Title=layout[v.key].title or L"",Position=pos,Font=fontextratiny(), Align=v.align}
				w:SetAlpha(0)
				local icon
				if v.icon then
					local iconpos = CopyTable(v.iconpos)
					iconpos[2] = iconpos[2] + 22
					icon=Frame{Position=iconpos,Size=v.iconsize}:AttachResource(menu_options:getResource(v.icon))
				end
				layout[v.key].window=w
				layout[v.key].icon=icon
			end
		end
	end
end


show_layout = function(num)
	--//if num == 3 then return end

	for k,v in pairs(controller_layouts) do
		local alpha=0
		if k == num then
			alpha=1
		end
		
		for kk,vv in pairs(v) do
			if vv.window then
				vv.window.handle=AnimateWindowAlpha(vv.window,vv.window:GetAlpha(),alpha,0.2,0.0,vv.window.handle)
				if vv.icon then
					vv.icon.handle=AnimateWindowAlpha(vv.icon,vv.icon:GetAlpha(),alpha,0.2,0.0,vv.icon.handle)
				end
			end
		end
	end
end

