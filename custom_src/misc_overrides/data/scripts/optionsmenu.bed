local options = {}

--// ---------------------------------------------------------------------------------------------------------------------------------
--// 
--// ---------------------------------------------------------------------------------------------------------------------------------

local function create_value(item,parent)
	
	local value=0
	local o

	if item.category ~= "" and item.setting ~= "" then
		value=Settings[item.category][item.setting]
	end
	if value == true then
		value=1 
	else
		value=0
	end



	local arrowsize=GetResourceSize(menu_options:getResource("ingame_options_arrow_left_glow"))
	local parentsize={ parent:GetSize() }

	local optTitle = nil
	if item.isStuntSoundtrack then
		optTitle=ChloeOST_GetStuntSoundtrackName(value)
	elseif item.isMenuSoundtrack then
		optTitle=ChloeOST_GetMenuSoundtrackName(value)
	elseif item.isSoundtrack then
		optTitle=ChloeOST_GetSoundtrackName(value)
	elseif item.isPacenoteSpeech then
		optTitle=ChloePacenotes_GetSpeechName(value)
	elseif item.isPacenoteVisual then
		optTitle=ChloePacenotes_GetVisualName(value)
	else
		optTitle=item.data[value+1]
	end
	
	o=StaticText{Title=optTitle or TRANSLATOR(MULTIPLAYER_MESSAGE_ERROR), Position=POS(parent.itempos[1]+20+arrowsize[1],2),Color=GetPaletteColor(34),Font=fontextratiny(),Parent=parent}

	o.item=item
	o.parent=parent
	
	o.getNumItems = function(self)
		if self.item.isStuntSoundtrack then
			return ChloeOST_GetNumStuntSoundtracks()
		elseif self.item.isMenuSoundtrack then
			return ChloeOST_GetNumMenuSoundtracks()
		elseif self.item.isSoundtrack then
			return ChloeOST_GetNumSoundtracks()
		elseif self.item.isPacenoteSpeech then
			return ChloePacenotes_GetNumSpeechTypes()
		elseif self.item.isPacenoteVisual then
			return ChloePacenotes_GetNumVisualTypes()
		else
			return table.getn(self.item.data)
		end
	end

	o.activate = function(self)
		self:SetColor(GetPaletteColor(33),false)

		if self.getNumItems(self) > 1 then
			local x,y = self.parent:GetPosition()
			local arrowsize=GetResourceSize(menu_options:getResource("ingame_options_arrow_left_glow"))
			local textw=wm.GetTextWidth(self:GetTitle(),fontextratiny())

			menu_options.leftarrow:SetPosition(self.parent.itempos[1]+20,y+2)--+(parentsize[2]/2-arrowsize[2]/2))
			menu_options.rightarrow:SetPosition(self.parent.itempos[1]+18+arrowsize[1]+4+textw+4,y+2)--+(parentsize[2]/2-arrowsize[2]/2))
			menu_options.leftarrow:ShowWindow()
			menu_options.rightarrow:ShowWindow()
		end
	end

	o.deactivate = function(self)
		self:SetColor(GetPaletteColor(1),false)
		menu_options.leftarrow:StopFlash()
		menu_options.rightarrow:StopFlash()

	end

	o.moveLeft = function(self)
		if self.item.isStuntSoundtrack or self.item.isMenuSoundtrack or self.item.isSoundtrack then
			ChloeCollection_AwardAchievement("CHANGE_MUSIC")
		end
		
		local value=self:getValue()

		if value > 0 then
			self:setValue(value-1)
		else
			self:setValue(self.getNumItems(self)-1)
		end

		playmenusound_move()
		self:setTitle()
		menu_options.leftarrow:Flash(-1)
	end

	o.moveRight = function(self)
		if self.item.isStuntSoundtrack or self.item.isMenuSoundtrack or self.item.isSoundtrack then
			ChloeCollection_AwardAchievement("CHANGE_MUSIC")
		end
		
		local value=self:getValue()

		if value < self.getNumItems(self)-1 then
			self:setValue(value+1)
		else
			self:setValue(0)
		end

		playmenusound_move()
		self:setTitle()
		menu_options.rightarrow:Flash(1)
	end

	o.setTitle = function(self)
		local value=self:getValue() or 0

		if self.item.isStuntSoundtrack then
			self:SetTitle(ChloeOST_GetStuntSoundtrackName(value))
		elseif self.item.isMenuSoundtrack then
			self:SetTitle(ChloeOST_GetMenuSoundtrackName(value))
		elseif self.item.isSoundtrack then
			self:SetTitle(ChloeOST_GetSoundtrackName(value))
		elseif self.item.isPacenoteSpeech then
			self:SetTitle(ChloePacenotes_GetSpeechName(value))
		elseif self.item.isPacenoteVisual then
			self:SetTitle(ChloePacenotes_GetVisualName(value))
		else
			self:SetTitle(self.item.data[value+1] or TRANSLATOR(MULTIPLAYER_MESSAGE_ERROR))
		end
		
		local textw=wm.GetTextWidth(self:GetTitle(),fontextratiny())

		local _,y=self.parent:GetPosition()--menu_singleplayer_trackselection.rightarrow:GetPosition()
		local arrowsize=GetResourceSize(menu_options:getResource("ingame_options_arrow_left_glow"))

		menu_options.rightarrow:SetPosition(self.parent.itempos[1]+18+arrowsize[1]+4+textw+4,y+2)

	end

	o.setValue = function(self,value)

		if self.item.category ~= "" and self.item.setting ~= "" then
			Settings[self.item.category][self.item.setting]=value
		end

		if self.item.action then
			self.item.action(self:getValue(),value)
		end
	end


	o.getValue = function(self)
		local value=0
		if self.item.category ~= "" and self.item.setting ~= "" then
			value=Settings[self.item.category][self.item.setting]
		end
		if type(value) == "boolean" then
			if value == true then
				value=1
			else
				value=0
			end
		end

		return value
	end

	o:setTitle()
	o:SetAlpha(0)


	return o
end


local function create_slider(item,parent)

	
	local value=0
	local o

	local arrowsize=GetResourceSize(menu_options:getResource("ingame_options_arrow_left_glow"))
	local parentsize={ parent:GetSize() }

	if item.category ~= "" and item.setting ~= "" then
		value=Settings[item.category][item.setting]
	end

	local bgcolor={ 0,0,0,0.5*MAX_VERTEXCOLOR_A }
	o=ProgressBar{Position=POS(parent.itempos[1]+20+arrowsize[1]+2,5.5),Size=SIZE(102,8),DrawGradient=FALSE,
							Color=GetPaletteColor(22),BackgroundColor=bgcolor,
							Ticks=item.data[1],Value=0,Parent=parent}


	o.textvalue=StaticText{Title=L"", Position=POS(parent.itempos[1]+20+arrowsize[1]+4+102+4+arrowsize[1]+4,2),Font=fontextratiny(),Color=GetPaletteColor(34),Parent=parent}

	o.parent=parent

	o.item=item

	o.activate = function(self) 
		local _,y=self.parent:GetPosition()

		menu_options.leftarrow:SetPosition(self.parent.itempos[1]+20,y+2)--+(parentsize[2]/2-arrowsize[2]/2))
		menu_options.rightarrow:SetPosition(self.parent.itempos[1]+20+arrowsize[1]+4+102+4,y+2)
		menu_options.leftarrow:ShowWindow()
		menu_options.rightarrow:ShowWindow()
	end

	o.deactivate = function(self) 
		menu_options.leftarrow:StopFlash()
		menu_options.rightarrow:StopFlash()
	end

	o.moveLeft = function(self)
		local value=self:getValue()
		local adj=self.item.data[1]/20

		value = math.max(value-adj,0)

		self:setValue(value)
		playmenusound_move()
	
		self:setTitle()
	end

	o.moveRight = function(self)
		local value=self:getValue()
		local adj=self.item.data[1]/20

		value = math.min(value + adj,self.item.data[1])
		self:setValue(value)
		playmenusound_move()

		self:setTitle()
	end

	o.setTitle = function(self)
		local value=self:getValue()		

		self:SetValue(value)
		self.textvalue:SetTitle(ConvertToWString(string.format("%d%%",value)))

--		local _,y=menu_options.rightarrow:GetPosition()
--		local arrowsize=GetResourceSize(menu_options:getResource("ingame_options_arrow_left_glow"))

--		menu_options.rightarrow:SetPosition(self.parent.itempos[1]+20+arrowsize[1]+4+102+4,y)
	end

	o.setValue = function(self,value)
		if self.item.category ~= "" and self.item.setting ~= "" then
			if self.item.setting == "InterfaceMusicVolume" then
				if value == 0 then
					Event:PostEvent(event(EVENT_MUSIC_STOP))
				elseif Settings[self.item.category][self.item.setting] == 0 and value > 0 then
					Event:PostEvent(event(EVENT_MUSIC_PLAY_TITLE))
				end
			end
			Settings[self.item.category][self.item.setting]=value
			
			if self.item.action then
				self.item.action(self:getValue(),value)
			end
		end
	end


	o.getValue = function(self)
		local value=0
		if self.item.category ~= "" and self.item.setting ~= "" then
			value=Settings[self.item.category][self.item.setting]
		end

		return value
	end

	o:setTitle()
	o:SetAlpha(0)
	o.textvalue:SetAlpha(0)

	return o
end


local function create_command(item,parent)

	titlew=wm.GetTextWidth(parent.title:GetTitle(),fontextratiny())

	local arrowsize=GetResourceSize(menu_options:getResource("white_arrow_right"))
	local parentsize={ parent:GetSize() }

	arrowsize[1] = arrowsize[1] / 2
	arrowsize[2] = arrowsize[2] / 2 

	local o=Frame{Position=POS((parent.itempos[1]-18)-(titlew+arrowsize[1]),parentsize[2]/2-arrowsize[2]/2),Size=arrowsize,Parent=parent}
	--//o:AttachResource(menu_options:getResource("white_arrow_right"))


	o.item=item

	o.activate = function(self)
		self:SetColor(GetPaletteColor(33),false)
		menu_options.leftarrow:HideWindow()
		menu_options.rightarrow:HideWindow()
	end

	o.deactivate = emptyfunction()
	o.moveLeft = emptyfunction()
	o.moveRight = emptyfunction()
	o.setTitle = emptyfunction()
	o.getValue = function(self) return 0 end
	o.setValue = emptyfunction()

	o.onPressed = function(self)
		if type(self.item.data) == "function" then
			self.item.data()
		end
	end

	o:SetAlpha(0)

	return o
end

local function create_key(item,parent)


	local o=StaticText{Position=POS(parent.itempos[1]+20,0),Font=fontextratiny(),Parent=parent,Color=GetPaletteColor(1)}

	o.item=item
	

	if item.icon then
		local res = menu_options:getResource(item.icon)
		local size = GetResourceSize(res)
		size[1] = size[1] / 1.5
		size[2] = size[2] / 1.5
		local parentsize = { parent:GetSize() }
		o.icon = Frame{Position=POS(parent.itempos[1]-10,(parentsize[2]-size[2])/2),Size=size,Parent=parent};
		o.icon:AttachResource(res)
	end	

	o.activate = function(self)
		self:SetColor(GetPaletteColor(33),false)
	end

	o.deactivate = function(self)
		self:SetColor(GetPaletteColor(1),false)
		--self:SetColor(GetPaletteColor(34),false)
	end

	o.setTitle = function(self,status) 
		if Input.GetControllerType(Settings.Control.Controller) ~= Input.CONTROLLER_TYPE_XBOXGAMEPAD then
			if status == Input.CONTROLLER_REMAP_PENDING then
				self:SetTitle(L"???")
			else
				self:SetTitle(Input.GetButtonName(Settings.Control.Controller,self.item.data[1]))
			end
		end
	end


	o.moveLeft = emptyfunction()
	o.moveRight = emptyfunction()

	o.getValue = function(self) 
	
		return 
	end
	o.setValue = function(self,value)


	end

	o.onPressed = function(self)
		start_remap(self,Settings.Control.Controller,self.item.data[1])
	end

	o:setTitle()
	o:SetAlpha(0)

	return o
end

