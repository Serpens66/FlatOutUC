function EnterCreateGameMenu(backmenu, list_play)
	menu_multiplayer_creategame.backmenu = backmenu
	menu_multiplayer_lobby.backmenu = backmenu
	if list_play==nil then
		db.GameFlow.MultiplayerOptions.ListPlay=false
	else
		db.GameFlow.MultiplayerOptions.ListPlay=list_play
	end
	EnterMenu("menu_multiplayer_creategame")
end

