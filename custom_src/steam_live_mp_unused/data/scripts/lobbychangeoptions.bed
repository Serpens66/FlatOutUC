-- OptionItem item indexes
local Label=1
local ItemLabels=2
local ItemValues=3
local SelectedItem=4
local Enabled=5
local OnChanged=6
local Descriptions=7
local Hidden=8

-- OptionItem indexes
local SessionType=1
local GameType=2
local CarType=3
local DamageLevel=4
local DerbyDamageLevel=5
local HandlingDamage=6
local Upgrades=7
local NitroRegen=8
local NitroRegenType=9
local GhostMode=10
local Players=11
local Reserved=12

local NumOptions=12

local function GetEnabled(RowNr)
	return OptionItems[RowNr][Enabled]
end

local function SetEnabled(RowNr, Enable)
	OptionItems[RowNr][Enabled]=Enable
	if Enable then
		OptionItems[RowNr][Hidden]=false
	end
end

local function SetHidden(RowNr, Hide)
	OptionItems[RowNr][Hidden] = Hide
	if Hide then
		OptionItems[RowNr][Enabled] = false
	end	
end

local function GetHidden(RowNr)
	return OptionItems[RowNr][Hidden]
end

local function GetSelectedItem(RowNr)
	return OptionItems[RowNr][SelectedItem]
end

local function SetSelectedItem(RowNr, Item)
	OptionItems[RowNr][SelectedItem]=Item
end

local function SetSelectedItemByValue(RowNr, Value)
	for i,j in ipairs(OptionItems[RowNr][ItemValues]) do
		if j == Value then
			SetSelectedItem(RowNr, i)
			break
		end
	end
end

local function GetSelectedItemValue(rowNr)
	return OptionItems[rowNr][ItemValues][OptionItems[rowNr][SelectedItem] ]
end

local function GetSelectedItemLabel(rowNr)
	return OptionItems[rowNr][ItemLabels][OptionItems[rowNr][SelectedItem] ]
end

local function GetNumItems(RowNr)
	return table.getn(OptionItems[RowNr][ItemValues])
end

local function GetRealRowNr(RowNr)
	local realRowNr=nil
	local currentRow=0
	for i=1, table.getn(OptionItems) do
		if GetHidden(i) ~= true then
			currentRow = currentRow + 1
			if currentRow == RowNr then
				realRowNr = i
				break
			end
		end
	end
	return realRowNr
end

local function GetRealNumRows()
	local currentRow=0
	for i=1, table.getn(OptionItems) do
		if GetHidden(i) ~= true then
			currentRow = currentRow + 1
		end
	end
	return currentRow
end

local function UpdateArrows(self)
	local row = wm.GetWindow("optionlist"):GetSelectedRow()
	local y = Layout.ListTop + (Layout.RowHeight + Layout.RowPadding) * (row - 1)
	
	local leftArrowSize = wm.GetResourceSize(self:getResource("ingame_options_arrow_left_glow"))
	local rightArrowSize = wm.GetResourceSize(self:getResource("ingame_options_arrow_right_glow"))

	local value = wm.GetWindow("optionvalue_row"..row)
	local xpos,_ = value:GetPosition()
	self.leftarrow:SetPosition(xpos - 5 - leftArrowSize[1], y + 2)

	local w,_ = wm.GetTextExtents(value:GetTitle(), Layout.ListFont)
	self.rightarrow:SetPosition(xpos + w + 9, y + 2)
end

local function UpdateInfoText()
	local selectedRow = GetRealRowNr(wm.GetWindow("optionlist"):GetSelectedRow())
	local descs = OptionItems[selectedRow][Descriptions]
	if descs ~= nil then
		local desc
		if type(descs) == "table" then
			desc = descs[GetSelectedItem(selectedRow)]
		else
			desc = descs
		end
		
		local infotext = wm.GetWindow("infotext")
		if desc then
			infotext:SetTitle(desc)
			infotext:WordWrap()
			--local w,h = wm.GetTextExtents(infotext:GetTitle(), Layout.DescFont)
			--local w2,h2 = infotext:GetParent():GetSize()
			--infotext:SetPosition(320, (h2-h)/2)
		else
			infotext:SetTitle(L"")
		end
	end
end

OnNumPlayersChanged = function()
	if XBOX then
		local numPlayers = GetSelectedItem(Players)
		if GetSelectedItemValue(Reserved) > GetSelectedItemValue(Players) - 1 then
			-- Players is 2-8, Reserved is 0-7, Reserved must be lower than Players
			SetSelectedItem(Reserved, GetSelectedItem(Players) + 1)
		end
	end
end

OnReservedChanged = function()
	-- There be kludges here
	if GetSelectedItemValue(Reserved) == -1 then
		SetSelectedItem(Reserved, GetSelectedItem(Players) + 1)
	elseif GetSelectedItemValue(Reserved) > GetSelectedItemValue(Players) - 1 then
		SetSelectedItem(Reserved, 1)
	end
end

OnGameTypeChanged = function()
	local gameType = GetSelectedItemValue(GameType)

	if gameType == 1 then
		SetEnabled(NitroRegen, true)
		SetEnabled(Upgrades, true)
		SetEnabled(DamageLevel, true)
		SetHidden(DerbyDamageLevel, true)
		SetEnabled(GhostMode, true)
		SetEnabled(NitroRegenType, true)
		SetEnabled(HandlingDamage, true)
	elseif gameType == 2 then
		SetHidden(NitroRegen, true)
		SetHidden(Upgrades, true)
		SetHidden(DamageLevel, true)
		SetHidden(DerbyDamageLevel, true)
		SetHidden(GhostMode, true)
		SetHidden(NitroRegenType, true)
		SetHidden(HandlingDamage, true)
	elseif gameType == 3 then
		SetEnabled(NitroRegen, true)
		SetEnabled(Upgrades, true)
		SetHidden(DamageLevel, true)
		SetEnabled(DerbyDamageLevel, true)
		SetHidden(GhostMode, true)
		SetHidden(NitroRegenType, true)
		SetEnabled(HandlingDamage, true)
	else
		SetEnabled(NitroRegen, true)
		SetEnabled(Upgrades, true)
		SetEnabled(DamageLevel, true)
		SetEnabled(DerbyDamageLevel, true)
		SetEnabled(GhostMode, true)
		SetEnabled(NitroRegenType, true)
		SetEnabled(HandlingDamage, true)
	end
	
	if gameType == 2 then
		OptionItems[CarType][ItemLabels] = { MULTIPLAYER_CARTYPE_STUNT, MULTIPLAYER_CAR_SAMEHOST }
		OptionItems[CarType][ItemValues] = { ReplicatedSession.CARCLASS_STUNT, -1 }
		OptionItems[CarType][Descriptions] = { MULTIPLAYER_CARTYPE_STUNT_DESCRIPTION, MULTIPLAYER_CAR_SAMEHOST_DESC }
		OptionItems[CarType][SelectedItem] = 1
	else
		OptionItems[CarType][ItemLabels] = { MULTIPLAYER_CARTYPE_ANY, MULTIPLAYER_OPTION_NOBONUS, MULTIPLAYER_CARTYPE_DERBY, MULTIPLAYER_CARTYPE_RACING, MULTIPLAYER_CARTYPE_STREET, MULTIPLAYER_OPTION_BONUS, MULTIPLAYER_CAR_SAMEHOST }
		OptionItems[CarType][ItemValues] = { ReplicatedSession.CARCLASS_ANY, ReplicatedSession.CARCLASS_NOBONUS, ReplicatedSession.CARCLASS_DERBY, ReplicatedSession.CARCLASS_RACING, ReplicatedSession.CARCLASS_STREET, ReplicatedSession.CARCLASS_BONUS, -1 }
		OptionItems[CarType][Descriptions] = { MULTIPLAYER_CARTYPE_ANY_DESCRIPTION, MULTIPLAYER_OPTION_NOBONUS_DESC, MULTIPLAYER_CARTYPE_DERBY_DESCRIPTION, MULTIPLAYER_CARTYPE_RACING_DESCRIPTION, MULTIPLAYER_CARTYPE_STREET_DESCRIPTION, MULTIPLAYER_OPTION_BONUS_DESC, MULTIPLAYER_CAR_SAMEHOST_DESC }
		OptionItems[CarType][SelectedItem] = 1
	end
end

local function ChangeOptions(events, carindex, carskin)
	local info=Session:GetInfo()
	
	if GetSelectedItemValue(SessionType) == 1 then
		info.IsTournament = false
	else
		info.IsTournament = true
	end
	
	local cartype = GetSelectedItemValue(CarType)
	if cartype == -1 then
		if carindex ~= nil and info.CarClass ~= ReplicatedSession.CARCLASS_SAMEASHOST + carindex then
			info.CarClass = ReplicatedSession.CARCLASS_SAMEASHOST + carindex
		end
	elseif info.CarClass ~= GetSelectedItemValue(CarType) then
		info.CarClass = GetSelectedItemValue(CarType)
	end

	if info.CarUpgrades ~= GetSelectedItemValue(Upgrades) then
		info.CarUpgrades = GetSelectedItemValue(Upgrades)
	end

	if info.NitroRegen ~= GetSelectedItemValue(NitroRegen) then
		info.NitroRegen = GetSelectedItemValue(NitroRegen)
	end
	
	if info.WrongWayGhostMode ~= GetSelectedItemValue(GhostMode) then
		info.WrongWayGhostMode = GetSelectedItemValue(GhostMode)
	end

	if info.NitroRegenType ~= GetSelectedItemValue(NitroRegenType) then
		info.NitroRegenType		= GetSelectedItemValue(NitroRegenType)
	end
	
	if info.HandlingDamage ~= GetSelectedItemValue(HandlingDamage) then
		info.HandlingDamage	= GetSelectedItemValue(HandlingDamage)
	end
	
	if XBOX then
		info.MaxPublicSlots	= GetSelectedItemValue(Players) - GetSelectedItemValue(Reserved)
		info.MaxPrivateSlots= GetSelectedItemValue(Reserved)
	else
		info.MaxPublicSlots	= GetSelectedItemValue(Players)
		info.MaxPrivateSlots= 0
	end

	info.DamageLevel		= GetSelectedItemValue(DamageLevel)
	info.DerbyDamageLevel	= GetSelectedItemValue(DerbyDamageLevel)
	
	if events then
		Session:ClearAllRaces()
		for i,ev in ipairs(events) do
			Session:AddRace()
			info.Races[i].StageNr = ev.trackid
			info.Races[i].TrackType = ev.rules
			info.Races[i].EventType = ev.rules
			info.Races[i].LapsOrTimeLimit = ev.lapsOrTimeLimit
			info.Races[i].Raced = false
		end	
		info.NextRace = 1
	end

	menu_multiplayer_lobby_changeoptions.back()
end

local function SelectHostCar(events)
	local carlist = { }
	local rules
	
	if events then
		rules = events[1].rules
	else
		rules = Session:GetInfo().Races[Session:GetInfo().NextRace].EventType
	end
	
	if rules == ReplicatedSession.GAMETYPE_STUNT then
		carlist = CarlistStuntCars()
	else
		local function SplitString(str)
			local t={}		
			for w in string.gfind(str,"(%w+)%.?") do
				table.insert(t,w)
			end
			return t
		end
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			local path = SplitString(string.lower(car:GetFullPath()))

			if path[3] ~= "stunt" and path[3] ~= "ai" and IsValidCar(i) then --// ChloeCustom Steam: only modpack cars (IsValidCar), unfiltered lists contain removed cars and crash the car selection
				table.insert(carlist, {index = i})
			end
		end
		SortCarsByClass(carlist)
	end

	EnterCarSelection(
		function(car, skin)
			ChangeOptions(events, car, skin)
		end,
		function()
			EnterMenu("menu_multiplayer_lobby_changeoptions")
		end,
		carlist,
		false,
		true,
		false,
		false,
		false,
		false,
		true
	)
end

function menu_multiplayer_lobby_changeoptions.init(self)
	self.parent:init(self)
	
	GUI:SetBackground("data/menu/career_race_rewards_background.tga")

	local res = self:getResource("title_bd")
	Frame { Position=Layout.TitleFramePos, Size=Layout.TitleFrameSize }:AttachResource(res)
	StaticText { Title=TITLE_MULTIPLAYER_GAMEOPTIONS, Font=Layout.TitleFont, Color=Layout.TitleColor, Position=Layout.TitlePos, Size=Layout.TitleSize, Align=FONTF_CENTER }
	
	res = self:getResource("black75_bd")
	Frame { Position=Layout.ListBdTopPos, Size=Layout.ListBdTopSize }:AttachResource(res)
	Frame { Position=Layout.ListBdBotPos, Size=Layout.ListBdBotSize }:AttachResource(res)
	
	res = self:getResource("black50_bd")
	Frame { Position=Layout.ListBdMidPos, Size=Layout.ListBdMidSize, Layer=2 }:AttachResource(res)
	Frame { Position=Layout.DescTitleFramePos, Size=Layout.DescTitleFrameSize, Layer=2 }:AttachResource(res)
	local frame = Frame { Position=Layout.DescFramePos, Size=Layout.DescFrameSize }:AttachResource(res)
	
	FadingStaticText { Name="infotext", Title=L"", Font=Layout.DescFont, Position=Layout.DescPos, Size=Layout.DescSize, Color=Layout.DescColor, Align=FONTF_CENTER, Parent=frame }

	local listboxParams = {
		ListBoxTemplate	= { Name="optionlist" },
		Left			= Layout.ListLeft,
		Top				= Layout.ListTop,
		LeftPadding		= 0,
		RightPadding	= 0,
		TopPadding		= 0,
		BottomPadding	= 0,
		RowWidth		= 640,
		RowHeight		= Layout.RowHeight,
		RowPadding		= Layout.RowPadding,
		RowTemplate		= { DrawBackgroundColor=FALSE, TitleCentering=TITLE_CENTER_Y, Layer=3 },
		RowTemplateType	= "Button",
		RowTemplateCust	= function(Row, RowNr)
			Row:AttachResource(self:getResource("black50_bd"))
		end,
		NumRows	= NumOptions,
		Coloumns = {
			[1] = {
				Name				= "optiontitle", -- _row# is added
				ColoumnTemplate		= { Font=Layout.ListFont, Color=Layout.LabelFontColor, Position=POS(Layout.LabelX, 1), Size=SIZE(Layout.OptionWidth, Layout.RowHeight), Align=FONTF_RIGHT, Layer=4 },
				ColoumnTemplateType	= "StaticText",
				ColoumnTemplateCust	= function(Coloumn, RowNr, ColoumnNr)
				end
			},
			[2] = {
				Name				= "optionvalue", -- _row# is added
				ColoumnTemplate		= { Font=Layout.ListFont, Color=Layout.OptionFontColor, Position=POS(Layout.OptionX, 1), Size=SIZE(Layout.OptionWidth, Layout.RowHeight), Layer=4 },
				ColoumnTemplateType	= "StaticText",
				ColoumnTemplateCust	= function(Coloumn, RowNr, ColoumnNr)
				end
			},
		}
	}
	
	local flashLeftArrow = false
	local flashRightArrow = false
	local optionlist = CreateMultiColoumnListBox(listboxParams)
	optionlist:SetNumRows(NumOptions)
	optionlist:SetSelectedRow(1)
	optionlist.onNeedData = function(Self, RowObject, RowNr, ControlRowNr)
		local title = wm.GetWindow("optiontitle_row"..RowNr)
		local value = wm.GetWindow("optionvalue_row"..RowNr)
		
		local realRowNr = GetRealRowNr(RowNr)
		
		if realRowNr then
			if OptionItems[realRowNr][Hidden] == true then
				value:HideWindow()
				title:HideWindow()
			else
				local color
				if RowNr == optionlist:GetSelectedRow() then
					color = Layout.OptionSelectedFontColor
				else
					color = Layout.OptionFontColor
				end
				
				title:SetTitle(OptionItems[realRowNr][Label])
				value:SetTitle(GetSelectedItemLabel(realRowNr))
				value:SetColor(color, false)
				title:ShowWindow()
				value:ShowWindow()
				if OptionItems[realRowNr][Enabled] then
					value:SetLayer(4)
					title:SetLayer(4)
				else
					value:SetLayer(2)
					title:SetLayer(2)
				end
			end
		else
			value:SetLayer(2)
			title:SetLayer(2)
			value:SetTitle(L"")
			value:HideWindow()
			title:HideWindow()	
		end

		if RowNr == optionlist:GetSelectedRow() then
			UpdateArrows(self)
			if flashLeftArrow then
				flashLeftArrow = false
				self.leftarrow:Flash(-1)
			end
			if flashRightArrow then
				flashRightArrow = false
				self.rightarrow:Flash(1)
			end
		end
	end

	self.leftarrow = CreateArrow(self, "leftarrow", "ingame_options_arrow_left")
	self.rightarrow = CreateArrow(self, "rightarrow", "ingame_options_arrow_right")
	
	local info = Session:GetInfo()
	
	local sesstype
	if info.IsTournament then
		sesstype = 2
	else
		sesstype = 1
	end
	SetSelectedItem(SessionType, sesstype)
	if info.NextRace > 1 then
		SetEnabled(SessionType, false)
	end
	
	if USE_LIVE then
		if info.TournamentType == ReplicatedSession.GAMETYPE_RACE then
			SetSelectedItem(GameType, 1)
		elseif info.TournamentType == ReplicatedSession.GAMETYPE_STUNT then
			SetSelectedItem(GameType, 2)
		elseif info.TournamentType == ReplicatedSession.GAMETYPE_DERBY_WRECKING then
			SetSelectedItem(GameType, 3)
		else
			SetSelectedItem(GameType, 4)
		end
		SetEnabled(GameType, false)
		SetEnabled(Reserved, false)
	end
	
	OnGameTypeChanged()
	
	SetEnabled(Players, false)
	
	if info.TournamentType == ReplicatedSession.GAMETYPE_STUNT then
		OptionItems[CarType][ItemLabels] = { MULTIPLAYER_CARTYPE_STUNT, MULTIPLAYER_CAR_SAMEHOST }
		OptionItems[CarType][ItemValues] = { ReplicatedSession.CARCLASS_STUNT, -1 }
		OptionItems[CarType][Descriptions] = { MULTIPLAYER_CARTYPE_STUNT_DESCRIPTION, MULTIPLAYER_CAR_SAMEHOST_DESC }
	else
		OptionItems[CarType][ItemLabels] = { MULTIPLAYER_CARTYPE_ANY, MULTIPLAYER_OPTION_NOBONUS, MULTIPLAYER_CARTYPE_DERBY, MULTIPLAYER_CARTYPE_RACING, MULTIPLAYER_CARTYPE_STREET, MULTIPLAYER_OPTION_BONUS, MULTIPLAYER_CAR_SAMEHOST }
		OptionItems[CarType][ItemValues] = { ReplicatedSession.CARCLASS_ANY, ReplicatedSession.CARCLASS_NOBONUS, ReplicatedSession.CARCLASS_DERBY, ReplicatedSession.CARCLASS_RACING, ReplicatedSession.CARCLASS_STREET, ReplicatedSession.CARCLASS_BONUS, -1 }
		OptionItems[CarType][Descriptions] = { MULTIPLAYER_CARTYPE_ANY_DESCRIPTION, MULTIPLAYER_OPTION_NOBONUS_DESC, MULTIPLAYER_CARTYPE_DERBY_DESCRIPTION, MULTIPLAYER_CARTYPE_RACING_DESCRIPTION, MULTIPLAYER_CARTYPE_STREET_DESCRIPTION, MULTIPLAYER_OPTION_BONUS_DESC, MULTIPLAYER_CAR_SAMEHOST_DESC }
	end

	if info.CarClass < ReplicatedSession.CARCLASS_SAMEASHOST then
		SetSelectedItemByValue(CarType, info.CarClass)
	else
		SetSelectedItem(CarType, table.getn(OptionItems[CarType][ItemValues]))
	end
	
	SetSelectedItemByValue(Upgrades, info.CarUpgrades)
	SetSelectedItemByValue(NitroRegen, info.NitroRegen)
	SetSelectedItemByValue(DamageLevel, info.DamageLevel)
	SetSelectedItemByValue(DerbyDamageLevel, info.DerbyDamageLevel)
	SetSelectedItemByValue(HandlingDamage, info.HandlingDamage)
	SetSelectedItemByValue(NitroRegenType, info.NitroRegenType)
	SetSelectedItemByValue(GhostMode, info.WrongWayGhostMode)

	SetSelectedItem(Players, info.MaxPublicSlots + info.MaxPrivateSlots - 1)
	if USE_LIVE then
		SetSelectedItem(Reserved, info.MaxPrivateSlots + 1)
	end
	
	if GetEnabled(SessionType) then
		optionlist:SetSelectedRow(1)
	else
		optionlist:SetSelectedRow(3)
	end
	
	local handler = InputHandler { Name="inputhandler" }
	handler.onKeyPressed = function(Self, Character, VirtualKey, ScanCode)
		local selectedRow = GetRealRowNr(optionlist:GetSelectedRow())
		if VirtualKey == KeyCodes["BUTTON_START"] then
			local tournamenttype
			local gametype = GetSelectedItemValue(GameType)
			if gametype == 1 then
				tournamenttype = ReplicatedSession.GAMETYPE_RACE
			elseif gametype == 2 then
				tournamenttype = ReplicatedSession.GAMETYPE_STUNT
			elseif gametype == 3 then
				tournamenttype = ReplicatedSession.GAMETYPE_DERBY_WRECKING
			else
				tournamenttype = ReplicatedSession.GAMETYPE_TOURNAMENT
			end

			if not Session:GetInfo().IsTournament and GetSelectedItemValue(SessionType) == 2 then
				-- Build tournament
				EnterBuildTournamentMenu(
					tournamenttype,
					function(tournamentEvents)
						if GetSelectedItemValue(CarType) == -1 and info.CarClass < ReplicatedSession.CARCLASS_SAMEASHOST then
							SelectHostCar(tournamentEvents)
						else
							ChangeOptions(tournamentEvents)
						end
					end,
					entermenu("menu_multiplayer_lobby_changeoptions"),
					false,
					GetSelectedItemValue(Players)
				)
			elseif Session:GetInfo().IsTournament and GetSelectedItemValue(SessionType) == 1 then
				-- Single race
				EnterMultiplayerRaceSelection(
					tournamenttype, 
					function(event)
						if GetSelectedItemValue(CarType) == -1 and info.CarClass < ReplicatedSession.CARCLASS_SAMEASHOST then
							SelectHostCar( { event } )
						else
							ChangeOptions( { event } )
						end
					end,
					entermenu("menu_multiplayer_lobby_changeoptions"),
					GetSelectedItemValue(Players)
				)
			else
				if GetSelectedItemValue(CarType) == -1 and info.CarClass < ReplicatedSession.CARCLASS_SAMEASHOST then
					SelectHostCar()
				else
					ChangeOptions()
					menu_multiplayer_lobby_changeoptions.back()
				end
				playmenusound_action()
			end			
		elseif VirtualKey == KeyCodes["BUTTON_SELECT"] then
			menu_multiplayer_lobby_changeoptions.back()
			playmenusound_back()
		elseif VirtualKey == KeyCodes["BUTTON_LEFT"] then
			if selectedRow then
				if GetEnabled(selectedRow) then
					local selectedItem = GetSelectedItem(selectedRow) - 1
					local numItems = GetNumItems(selectedRow)
					if selectedItem < 1 then
						selectedItem = numItems
					end
					SetSelectedItem(selectedRow,selectedItem)

					local onChanged = OptionItems[selectedRow][OnChanged]
					if onChanged ~= nil then
						onChanged(selectedRow)
					end
					
					flashLeftArrow = true
					optionlist:Refresh()
					UpdateInfoText()
					playmenusound_move()
				end
			end
		elseif VirtualKey == KeyCodes["BUTTON_RIGHT"] then
			if selectedRow then
				if GetEnabled(selectedRow) then
					local selectedItem = GetSelectedItem(selectedRow) + 1
					local numItems = GetNumItems(selectedRow)
					if selectedItem > numItems then
						selectedItem = 1
					end
					SetSelectedItem(selectedRow,selectedItem)

					local onChanged = OptionItems[selectedRow][OnChanged]
					if onChanged ~= nil then
						onChanged(selectedRow)
					end
					
					flashRightArrow = true
					optionlist:Refresh()
					UpdateInfoText()
					playmenusound_move()
				end
			end
		elseif VirtualKey == KeyCodes["BUTTON_DOWN"] then
			self.leftarrow:StopFlash()
			self.rightarrow:StopFlash()
			-- Skip any disabled rows
			local numoptions = GetRealNumRows()
			local row = optionlist:GetSelectedRow()
			local realrow
			repeat
				row = row + 1
				realrow = GetRealRowNr(row)
			until GetEnabled(realrow) == true or row == numoptions
			if row == numoptions and OptionItems[realrow][Enabled] == false then
				optionlist:SetSelectedRow(1)
			else
				optionlist:SetSelectedRow(row)
			end
			
			UpdateArrows(self)
			UpdateInfoText()
			playmenusound_move()
		elseif VirtualKey == KeyCodes["BUTTON_UP"] then
			self.leftarrow:StopFlash()
			self.rightarrow:StopFlash()
			-- Skip any disabled rows
			local row = optionlist:GetSelectedRow()
			if row == 1 then
				row = GetRealNumRows() + 1
			end
			local realrow
			repeat
				row = row - 1
				realrow = GetRealRowNr(row)
			until OptionItems[realrow][Enabled] == true or row == 1
			if not (row == 1 and OptionItems[realrow][Enabled] == false) then
				optionlist:SetSelectedRow(row)
			end

			UpdateArrows(self)
			UpdateInfoText()
			playmenusound_move()
		end
	end
	
	GUI:SetHelpButtons(BUTTON_OK, UI_ACCEPT, BUTTON_BACK, UI_BACK)
	UpdateInfoText()
	
	handler:SetFocus()
end
	
function menu_multiplayer_lobby_changeoptions.deinit(self)
	self.parent:deinit(self)
end

function menu_multiplayer_lobby_changeoptions.update(self,time)
	self.parent:update(self,time)

	self.leftarrow:AnimateAlpha(time)
	self.rightarrow:AnimateAlpha(time)
end

end --//USE_NETWORK