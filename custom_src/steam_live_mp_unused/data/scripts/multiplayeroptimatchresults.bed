local GameInfo1 = {
	{ name="cars", label=MULTIPLAYER_FOUNDGAMES_CARS, enabled=true },
	{ name="upgrades", label=MULTIPLAYER_FOUNDGAMES_UPGRADES, enabled=true },
	{ name="nitrolevel", label=MULTIPLAYER_NITRO, enabled=true },
