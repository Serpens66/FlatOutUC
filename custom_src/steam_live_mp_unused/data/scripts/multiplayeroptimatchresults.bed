}

local GameInfo2 = {
	{ name="damage", label=MULTIPLAYER_DAMAGE, enabled=true },
	{ name="derbydamage", label=MULTIPLAYER_DERBYDAMAGE, enabled=true },
	{ name="handlingdamage", label=TRANSLATOR(MULTIPLAYER_HANDLINGDAMAGE), enabled=true },
