emit_min = 140
emit_max = 200

local sparkhandle
local stophandle
local function RandomMenuSpark()

	local randomspark = function(event)
		sparkhandle=nil
		local stoptime = math.random(50)
		
		local stopspark = function(event)
			stophandle=nil
			local emitter=db.Data.Effect.Emitter.MenuFireSpray

			if emitter and emitter.Fx1 then
				emitter.Fx1.Count = 0
			end

		end

		local emitter=db.Data.Effect.Emitter.MenuFireSpray

		local emit_min = emit_min or 2
		local emit_max = emit_max or 20

		if emitter and emitter.Fx1 then
			emitter.Fx1.Count = emit_min + math.random(emit_max-emit_min)
		end

		stophandle=Event:AddTimer(stopspark,stoptime,nil,true,true)

		RandomMenuSpark()
	end

	local time=1000+math.random(9000)

	sparkhandle=Event:AddTimer(randomspark,time,nil,true,true)
end


function InitRandomMenuSpark()
	--//random menuspark
	--//set initial count to 0
	if sparkhandle then
		Event:RemoveTimer(sparkhandle)
	end

	if stophandle then
		Event:RemoveTimer(stophandle)
	end

	local emitter=db.Data.Effect.Emitter.MenuFireSpray
	if emitter and emitter.Fx1 then
		emitter.Fx1.Count = 0
	end
	RandomMenuSpark()
end

function RemoveRandomMenuSpark()
	if sparkhandle then	
		Event:RemoveTimer(sparkhandle)
	end

	if stophandle then
		Event:RemoveTimer(stophandle)
	end

	local emitter=db.Data.Effect.Emitter.MenuFireSpray
	if emitter and emitter.Fx1 then
		emitter.Fx1.Count = 0
	end
end


local eventhandlers = {
	[EVENT_MENU_LOADED] = function(event)
							InitRandomMenuSpark()
							LoadRandomMenuCar()

							if not IsGameStarted() then
								if not CommandLine["-host"] and not CommandLine["-join"] and not CommandLine["-profilenr"] then
									EnterMenu("menu_startscreen")
								else
									StartGame()
									--//EnterMenu("menu_profiles")
									EnterMenu("menu_mainmenu")
								end
							elseif not USE_NETWORK or not CheckGameInvite() then
								local result=raceresult[db.GameFlow.PostRace.Result]
								if result then 
									result()
								else
									LOG("invalid db.GameFlow.PostRace.Result")
									EnterMenu("menu_mainmenu")
								end
							end
						  end,
	[EVENT_MENU_MENUENTERED] = function(event)
								MenuScene:AllowCameraRotate(FALSE)
								if NewMenuEntered(event.data) then
									CurrentMenu=event.data
								end
							end,
	[EVENT_TIMER] = function(event)
					end,
	[EVENT_MENU_TRIGGER_REF] = function(event)
						local menu=getref(event.data)						
						if menu and menu.trigger then
							menu:trigger(event.arg)
						end
					end,
	[EVENT_MENU_MONEY_UPDATED] = function(event)
						MenubarMoneyUpdate()
					end,
--[[--/*
	[EVENT_SAVEFLOW_SAVEPLAYERPROFILE_END] = function(event)
						HandleLoadSaveEvent(event)
					end,
	[EVENT_SAVEFLOW_LOADPLAYERPROFILE_END] = function(event)
						HandleLoadSaveEvent(event)
					end,
	[EVENT_SAVEFLOW_SHOW_DEVICESELECTOR_START] = function(event)
						HandleLoadSaveEvent(event)
					end,
	[EVENT_SAVEFLOW_SHOW_DEVICESELECTOR_END] = function(event)
						HandleLoadSaveEvent(event)
					end,
--]]--*/
}


function SetEventHandler(eventid,handler)
	eventhandlers[eventid]=handler
end


function EventHandler(event)
	local handler=eventhandlers[event.id]

	if handler then
		handler(event)
	end

	if CurrentMenu and _G[CurrentMenu] then
		local menu=_G[CurrentMenu]
		if menu.eventhandler then
			menu:eventhandler(event)
		end
	end
end

function loadmenufile(file)
	if DEV then
		devmenufiles = devmenufiles or {}

		local t = {}
		local f = loadfile(file)
			setmetatable(t,{ __index = _G })

		setfenv(f,t)
		f()

		for k,v in pairs(t) do
			if type(v) == "table" and v.create and v.init then
				devmenufiles[k]=file
			end
		end
	end

	return dofile(file)
end

function where(name)
	if not DEV or not devmenufiles then return end


	if devmenufiles[name] then
		print(devmenufiles[name])
	else
		print(string.format("'%s' not found",name))
	end
end

--// ChloeCustom Steam: FlatOutUCChloeCollection_gcp.asi removes the Lua names of the engine enums
--// ReplicatedSession.CARCLASS_* and ReplicatedSession.GAMETYPE_* (Chloe multiplayer uses its own globals).
--// The vanilla multiplayer menus need them. Values = engine registration order (counter restarts at each NEW_ENUM, Fouc.exe 0x543D90).
local function ChloeCustomSteam_RestoreSessionEnums()
	if not ReplicatedSession then
		LOG("ChloeCustom Steam: ReplicatedSession not available")
		return
	end
	local enums = {
		CARCLASS_ANY=0, CARCLASS_DERBY=1, CARCLASS_RACING=2, CARCLASS_STREET=3,
		CARCLASS_STUNT=4, CARCLASS_NOBONUS=5, CARCLASS_BONUS=6, CARCLASS_SAMEASHOST=7,
		GAMETYPE_TOURNAMENT_RACE=0, GAMETYPE_TOURNAMENT_DERBY=1, GAMETYPE_STUNT=2, GAMETYPE_TOURNAMENT=3,
		GAMETYPE_RACE=4, GAMETYPE_PONGRACE=5, GAMETYPE_DERBY_WRECKING=6, GAMETYPE_DERBY_LMS=7,
		GAMETYPE_DERBY_FRAG=8, GAMETYPE_ARCADE_ADVENTURE=9, GAMETYPE_HUNTER_PREY=10,
	}
	local ok, err = pcall(function()
		for k,v in pairs(enums) do
			ReplicatedSession[k] = v
		end
	end)
	if not ok then
		LOG("ChloeCustom Steam: could not restore ReplicatedSession enums: %s", tostring(err))
	end
end

--// ChloeCustom Steam: online sessions of this modpack carry a tag at the start of the session name
--// (start, so a truncated long Steam name keeps it). The search lists only tagged sessions.
--// Lua wide strings are UTF-16LE byte strings incl. a 2-byte terminator. If anything is unexpected,
--// nothing is tagged/filtered (fail open).
ChloeCustomSteam_SessionTag = "[ModFO2] "
ChloeCustomSteam_HiddenSessions = 0

local function ChloeCustomSteam_WideTag()
	local ok, w = pcall(L, ChloeCustomSteam_SessionTag)
	if not ok or type(w) ~= "string" then return nil end
	local z = string.char(0, 0)
	while string.len(w) >= 2 and string.sub(w, -2) == z do
		w = string.sub(w, 1, -3)
	end
	return w
end

function ChloeCustomSteam_TagSessionName(name)
	local tag = ChloeCustomSteam_WideTag()
	if not tag or type(name) ~= "string" then return name end
	if string.sub(name, 1, string.len(tag)) == tag then return name end
	return tag .. name
end

--// ChloeCustom Steam: players of this modpack carry a trailing space in their online name (invisible, Steam names
--// never end with a space). The host removes players without it from the lobby, because a game without the modpack
--// has other cars/tracks/handling and can crash or desync. Set to false to disable the automatic kick.
ChloeCustomSteam_KickForeignPlayers = true
ChloeCustomSteam_MaxNameChars = 15   -- incl. the marker; Live gamertags have at most 15 characters

local function ChloeCustomSteam_WideCore(w)
	local z = string.char(0, 0)
	while string.len(w) >= 2 and string.sub(w, -2) == z do
		w = string.sub(w, 1, -3)
	end
	return w
end

function ChloeCustomSteam_TagPlayerName(name)
	if type(name) ~= "string" or not ChloeCustomSteam_WideTag() then return name end
	local core = ChloeCustomSteam_WideCore(name)
	local space = string.char(32, 0)
	if string.sub(core, -2) == space then return name end
	local maxbytes = (ChloeCustomSteam_MaxNameChars - 1) * 2
	if string.len(core) > maxbytes then core = string.sub(core, 1, maxbytes) end
	return core .. space .. string.char(0, 0)
end

--// true = modpack player, false = no modpack, nil = unknown (name not received yet or check not possible)
function ChloeCustomSteam_IsModPlayerName(name)
	if type(name) ~= "string" or not ChloeCustomSteam_WideTag() then return nil end
	local core = ChloeCustomSteam_WideCore(name)
	if string.len(core) < 2 then return nil end
	return string.sub(core, -2) == string.char(32, 0)
end

function ChloeCustomSteam_IsModSession(sessionNr)
	local tag = ChloeCustomSteam_WideTag()
	if not tag then return true end
	local ok, name = pcall(function()
		SessionList:SetSessionNum(sessionNr)
		return SessionList:GetSessionInfo().SessionName
	end)
	if not ok or type(name) ~= "string" then return true end
	return string.sub(name, 1, string.len(tag)) == tag
end

function LoadMenuFiles()
	local k,v

	ChloeCustomSteam_RestoreSessionEnums()

	local numfiles

	numfiles=table.getn(resourcefiles) + table.getn(menufiles)

	if XBOX then
		numfiles = numfiles + table.getn(xbox_menufiles)
	elseif PS2 then
		numfiles = numfiles + table.getn(ps2_menufiles)
	elseif PC then
		numfiles = numfiles + table.getn(xbox_menufiles)
		numfiles = numfiles + table.getn(pc_menufiles)
	end


	for k,v in pairs(resourcefiles) do
		dofile("data/menu/"..v)

		UpdateLoadingBar(1.0 / numfiles)
	end

	if PC then
		dofile("data/menu/pc_buttons.bed")

		control_keys.button_ok=enter_btn
		control_keys.button_back=esc_btn
	elseif XBOX then
		control_keys.button_ok=ps2_cross
		control_keys.button_back=ps2_triangle
	elseif PS2 then
		control_keys.button_ok=ps2_cross
		control_keys.button_back=ps2_triangle
	end

	MergeTable(globalresources,CreateSubImages("common.tga",common,common_size))
	MergeTable(globalresources,CreateSubImages("control_keys.tga",control_keys,control_keys_size))
	MergeTable(globalresources,CreateSubImages("main_menu_elements.tga",main_menu_elements,main_menu_elements_size))
	MergeTable(globalresources,CreateSubImages("menu_icons_normal.tga",menu_icons_normal,menu_icons_normal_size,BITMAP_INACTIVE))
	MergeTable(globalresources,CreateSubImages("menu_icons_normal_2.tga",menu_icons_normal_2,menu_icons_normal_2_size,BITMAP_INACTIVE))
	MergeTable(globalresources,CreateSubImages("menu_icons_normal_3.tga",menu_icons_normal_3,menu_icons_normal_3_size,BITMAP_INACTIVE))
	MergeTable(globalresources,CreateSubImages("menu_icons_glow.tga",menu_icons_glow,menu_icons_glow_size,BITMAP_ACTIVE))
	MergeTable(globalresources,CreateSubImages("menu_icons_glow_2.tga",menu_icons_glow_2,menu_icons_glow_2_size,BITMAP_ACTIVE))
	MergeTable(globalresources,CreateSubImages("menu_icons_glow_3.tga",menu_icons_glow_3,menu_icons_glow_3_size,BITMAP_ACTIVE))

	MergeTable(globalresources,CreateSubImages("track_images_wide_small_1.tga",track_images_wide_small_1,track_images_wide_small_1_size))
	MergeTable(globalresources,CreateSubImages("track_images_wide_small_2.tga",track_images_wide_small_2,track_images_wide_small_2_size))
	MergeTable(globalresources,CreateSubImages("track_images_wide_small_3.tga",track_images_wide_small_3,track_images_wide_small_3_size))
	MergeTable(globalresources,CreateSubImages("track_images_wide_small_4.tga",track_images_wide_small_4,track_images_wide_small_4_size))
	MergeTable(globalresources,CreateSubImages("track_images_wide_small_5.tga",track_images_wide_small_5,track_images_wide_small_5_size))
	MergeTable(globalresources,CreateSubImages("track_images_wide_small_6.tga",track_images_wide_small_6,track_images_wide_small_6_size))
	MergeTable(globalresources,CreateSubImages("track_images_wide_small_7.tga",track_images_wide_small_7,track_images_wide_small_7_size))

	if PC then
		MergeTable(globalresources,CreateSubImages("pc_buttons.tga",pc_buttons,pc_buttons_size))
	end

	for k,v in pairs(menufiles) do
		loadmenufile(menufilepath..v)

		UpdateLoadingBar(1.0 / numfiles)
	end
	
	if XBOX then
		for k,v in pairs(xbox_menufiles) do
			loadmenufile(menufilepath..v)

			UpdateLoadingBar(1.0 / numfiles)
		end
	elseif PS2 then
		for k,v in pairs(ps2_menufiles) do
			loadmenufile(menufilepath..v)

			UpdateLoadingBar(1.0 / numfiles)
		end
	elseif PC then
		for k,v in pairs(xbox_menufiles) do
			loadmenufile(menufilepath..v)

			UpdateLoadingBar(1.0 / numfiles)
		end
		for k,v in pairs(pc_menufiles) do
			loadmenufile(menufilepath..v)

			UpdateLoadingBar(1.0 / numfiles)
		end
	end	
end

function InitGlobalResources()
	LoadResources(globalresources)
	LOG("Global resources loaded")
end


function musictest()
	Event:PostEvent(event(EVENT_MUSIC_SHOWARTIST))
end

function BuildClassLevelReferences()
	
	for _,cur_class in pairs(Classes) do
		cur_class.ClassLevels={}
		cur_class.Levels={}
		for __,cup in pairs(cur_class.Cups or {}) do
		for k,race in pairs(cup.Races or {}) do
				table.insert(cur_class.Levels,race.Level)
				cur_class.ClassLevels[race.Level]=true
			end
		end
		for __,event in pairs(cur_class.Events or {}) do
				for k,race in pairs(event.Races or {}) do
				table.insert(cur_class.Levels,race.Level)
				cur_class.ClassLevels[race.Level]=true
			end
		end
	end

end

function BuildCarClassReferences()

	StuntCars={}
	Classes[1].ClassCars={}
	Classes[2].ClassCars={}
	Classes[3].ClassCars={}

	local classes = {
		["beginner"] = Classes[1],
		["amateur"] = Classes[2],
		["professional"] = Classes[3],
	}

	local function SplitString(str)
		local t={}		
		for w in string.gfind(str,"(%w+)%.?") do
			table.insert(t,w)
		end
		return t
	end

	--//get stunt cars
	for i=0,db.FlatOut2.Cars:GetPropertyArraySize("Car")-1 do
		local car=db.FlatOut2.Cars:GetProperty("Car",i)
		
		local path=SplitString(string.lower(car:GetFullPath()))

		if path[3] ~= "ai" and path[3] ~= "menu" then
			if path[3] == "stunt" then
				table.insert(StuntCars,i)
			else
				local cur_class=classes[path[3]]
				if cur_class then
					table.insert(cur_class.ClassCars,i)
				end
			end
		end
	end
end



