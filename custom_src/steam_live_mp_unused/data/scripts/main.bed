local current_menucar
local current_menucar_loaded

function SetCurrentMenuCar()
	local data = current_menucar

	set_weather("Menu_NEW_JP")
	SetDummiesByName(data.dummy)
	MenuScene:AllowCameraRotate(FALSE)
	MenuScene:CameraRotate(FALSE)

	if not current_menucar_loaded then
		MenuScene:LoadMenuCar(data.car,data.skin,data.car_dummy)
		current_menucar_loaded=true
	end
end


local function LoadRandomMenuCar()
	
	local index = math.random(3)

	local data = menucars[index]

	current_menucar = current_menucar or data

	SetCurrentMenuCar()
end



local function race_finished()
	Event:PostEvent(event(EVENT_MUSIC_MENU))
	
	if ChloeNet_IsConnected() then
		EnterMenu("menu_chloemultiplayer_lobby")
	elseif ChloeRally_GetIsCareerRally() then
		PrepareRewardMenuQueue(entermenu("menu_rally"))
		NextRewardMenu()
	elseif db.GameFlow.PreRace.Mode == GM_PARTY then
		EnterMenu("menu_partymode_results")
	elseif db.GameFlow.PreRace.Mode == GM_SPLITSCREEN then
		XBoxLive.GetRichPresence():SetContextValue(X_CONTEXT_PRESENCE, CONTEXT_PRESENCE_PRESENCE_MENU)
		SplitScreenSelectNextRace()
	elseif db.GameFlow.PreRace.Mode == GM_CAREER then
		PrepareRewardMenuQueue(entermenu("menu_career"))
		NextRewardMenu()
	elseif db.GameFlow.PreRace.Mode == GM_ARCADE_CAREER then
		PrepareRewardMenuQueue(ArcadeCareerReturnFromRace)
		--//ArcadeCareerReturnFromRace()
		NextRewardMenu()
	elseif db.GameFlow.PreRace.Mode == GM_ONLINE_MULTIPLAYER then
		if Session then
			if Session:IsLive() or Session:IsListPlay() then
				MultiplayerMode = MPMODE_XBOXLIVE
				if Network:GetShouldExitLive() then
					Network:SetShouldExitLive(false)
					Network:SetShouldExitSession(false)
					Network:StopMultiplayer()
					EnterMenu("menu_mainmenu")
				elseif Network:GetShouldExitSession() then
					Network:SetShouldExitSession(false)
					Network:StopMultiplayer()
					EnterMenu("menu_xboxlive")
				elseif db.GameFlow.MultiplayerOptions.SearchModeAfterLobby~=0 and MultiplayerFunctions.GetSearchParam("RankedGame") == true then
					EnterMenu("menu_multiplayer_optimatch")
				else
					if Session:GetNumRaces() > 1 then
						ShowTournamentStandings("menu_xboxlive")
					else
						ShowLobby("menu_xboxlive")
					end
				end
			elseif Session:IsGameSpy() then
				MultiplayerMode = MPMODE_GAMESPY
				if Network:GetShouldExitSession() then
					Network:SetShouldExitSession(false)
					EnterMenu("menu_multiplayer_gamespy")
				else
					if Session:GetNumRaces() > 1 then
						ShowTournamentStandings("menu_multiplayer_gamespy")
					else
						ShowLobby("menu_multiplayer_gamespy")
					end
				end
			else
				MultiplayerMode = MPMODE_LAN
				if Network:GetShouldExitSession() then
					Network:SetShouldExitSession(false)
					EnterMenu("menu_lan_modeselect")
				else
					if Session:GetNumRaces() > 1 then
						ShowTournamentStandings("menu_lan_modeselect")
					else
						ShowLobby("menu_lan_modeselect")
					end
				end
			end
		else
			EnterMenu("menu_mainmenu")
		end
	elseif db.GameFlow.PreRace.Mode == GM_TEST then
		ReturnFromTestTrack()
	elseif db.GameFlow.PreRace.Mode == GM_SINGLE_RACE then
		XBoxLive.GetRichPresence():SetContextValue(X_CONTEXT_PRESENCE, CONTEXT_PRESENCE_PRESENCE_MENU)
		if PRESSBUILD then
			EnterPressMenu()
		else
			PrepareRewardMenuQueue(entermenu("menu_singleplayer_events"))
			NextRewardMenu()
		end
		--//EnterMenu("menu_singleplayer")
	elseif db.GameFlow.PreRace.Mode == GM_INSTANT_ACTION then
		XBoxLive.GetRichPresence():SetContextValue(X_CONTEXT_PRESENCE, CONTEXT_PRESENCE_PRESENCE_MENU)
		PrepareRewardMenuQueue(entermenu("menu_mainmenu"))
		NextRewardMenu()
		--//EnterMenu("menu_mainmenu")
	else
		XBoxLive.GetRichPresence():SetContextValue(X_CONTEXT_PRESENCE, CONTEXT_PRESENCE_PRESENCE_MENU)
		if PRESSBUILD then
			EnterPressMenu()
		else
			EnterMenu("menu_mainmenu")
		end
	end


end

local function race_aborted()
	Event:PostEvent(event(EVENT_MUSIC_MENU))

	local isCareerRally = ChloeRally_GetIsCareerRally()
	ChloeRally_SetIsCareerRally(0)
		
	local mode=db.GameFlow.PreRace.Mode
	if ChloeNet_IsConnected() then
		EnterMenu("menu_chloemultiplayer_lobby")
	elseif isCareerRally then
		EnterMenu("menu_rally")
	elseif mode == GM_CAREER then
		PrepareRewardMenuQueue(entermenu("menu_career"),true)
		NextRewardMenu()
		--//EnterMenu("menu_career")
	elseif mode == GM_ARCADE_CAREER then
		ArcadeCareerReturnFromRace()
	elseif mode == GM_PARTY then
		EnterMenu("menu_partymode")
	elseif mode == GM_SINGLE_RACE then
		XBoxLive.GetRichPresence():SetContextValue(X_CONTEXT_PRESENCE, CONTEXT_PRESENCE_PRESENCE_MENU)
		--//PrepareRewardMenuQueue(entermenu("menu_singleplayer"),true)
		if PRESSBUILD then
			EnterPressMenu()
		else
			PrepareRewardMenuQueue(entermenu("menu_singleplayer_events"),true) --//EnterSingleRaceSelection(entermenu("menu_mainmenu")) end,true)
			NextRewardMenu()
		end
		--//EnterMenu("menu_singleplayer")
	elseif mode == GM_INSTANT_ACTION then
		XBoxLive.GetRichPresence():SetContextValue(X_CONTEXT_PRESENCE, CONTEXT_PRESENCE_PRESENCE_MENU)
		PrepareRewardMenuQueue(entermenu("menu_mainmenu"),true)
		NextRewardMenu()
	elseif mode == GM_TEST then
		ReturnFromTestTrack()
	elseif mode == GM_ONLINE_MULTIPLAYER then
		if Session then
			if Network:GetShouldExitLive() then
					Network:SetShouldExitLive(false)
					Network:SetShouldExitSession(false)
					Network:StopMultiplayer()
					EnterMenu("menu_mainmenu")
			elseif Network:GetShouldExitSession() then
					Network:SetShouldExitSession(false)
					Network:StopMultiplayer()
					EnterMenu("menu_xboxlive")
			elseif Session:IsLive() or Session:IsListPlay() then
				MultiplayerMode = MPMODE_XBOXLIVE
				if db.GameFlow.MultiplayerOptions.SearchModeAfterLobby~=0 and MultiplayerFunctions.GetSearchParam("RankedGame") == true then
					EnterMenu("menu_multiplayer_optimatch")
				else
					if Session:GetNumRaces() > 1 then
						ShowTournamentStandings("menu_xboxlive")
					else
						ShowLobby("menu_xboxlive")
					end
				end
			elseif Session:IsGameSpy() then
				MultiplayerMode = MPMODE_GAMESPY
				EnterMenu("menu_multiplayer_gamespy")
			else
				MultiplayerMode = MPMODE_LAN
				EnterMenu("menu_lan_modeselect")
			end
		else
			EnterMenu("menu_mainmenu")
		end
	else
		XBoxLive.GetRichPresence():SetContextValue(X_CONTEXT_PRESENCE, CONTEXT_PRESENCE_PRESENCE_MENU)
		EnterMenu("menu_mainmenu")
	end
end


