local MULTIPLAYER_TOURNAMENT_ICON_PRESET = ICON_MULTIPLAYER_PRESET
local MULTIPLAYER_TOURNAMENT_ICON_CUSTOM = ICON_LIVE_BUILD_EDITTRACK
local MULTIPLAYER_TOURNAMENT_TITLE = TITLE_MULTIPLAYER_BUILDTOURNAMENT
local MULTIPLAYER_TOURNAMENT_CUSTOMEVENTS = MULTIPLAYER_CUSTOMEVENTS_DESCRIPTION
local MULTIPLAYER_TOURNAMENT_PRESETS = MULTIPLAYER_PRESETS_DESCRIPTION

local state={}

local BuildMenuButtons
local RefreshEventGrid
local ShowPresetEvents

local TourneyEvents = { }
local TourneyIconDescs = { }
local ShowPresets
local EventGrid = { }
local ValidPresets = { }
local PresetSelection

local CurrentEvent
local CurRow
local CurCol

local ValidTracks
local SelectedTrack = 1

menu_chloecustom_buildtournament = CreateMenuFromTemplate("template_multiplayer")
menu_chloecustom_buildtournament.options.title = L""
menu_chloecustom_buildtournament.back = function() menu_chloecustom_buildtournament.backaction() end

-- ChloeCustom Tourney: 8 presets (8 icons), built when used (LevelIndex and GAMETYPE_* must exist)
local function GetPresets()
	return {
		{ name=PRESETS_NAME_OUTDOOR, desc=PRESETS_OUTDOOR, type=GAMETYPE_RACE, events={
			{ trackid=LevelIndex.Forest1A },
			{ trackid=LevelIndex.Desert1B },
			{ trackid=LevelIndex.Fields1A },
			{ trackid=LevelIndex.Forest1C },
