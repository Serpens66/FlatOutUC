--///////////////////////////////////////////////////////////////////////////
--// chloecustom_tournament.bed  (ChloeCustom Tourney, Steam package only)
--//
--// Tournament for Chloe's multiplayer: the host builds a list of events (editor = copy of the vanilla
--// MultiplayerBuildTournament.bed, below), the events are played one after another (or in random order), every
--// driver (players and AI) gets points per event (vanilla table 10-8-6-5-4-3-2-1). AI drivers get 4 points for
--// stunt events (stunts have no AI). Only the host counts; the standings are shared with all players through the
--// Steam lobby data (ChloeSteam_SetLobbyValue / ChloeSteam_GetLobbyValue of ChloeSteamNet.asi).
--// Hooks in chloemultiplayer_lobby.bed (all guarded with "if ChloeCustomTourney_... then"):
--//   create: ChloeCustomTourney_CaptureResults() before GameFlow.ClearRace()
--//   StartRace: ChloeCustomTourney_OnStartRace()
--//   BuildLobbyMenuButtons: ChloeCustomTourney_AddLobbyButtons(menu)
--//   update: ChloeCustomTourney_LobbyUpdate(menu, time)
--//   player list: ChloeCustomTourney_RowText(playerId, ping)
--//   leaving the lobby: ChloeCustomTourney_Reset()
--///////////////////////////////////////////////////////////////////////////

local TOURNEY_POINTS = { 10, 8, 6, 5, 4, 3, 2, 1 }
local TOURNEY_AI_STUNT_POINTS = 4
local TOURNEY_LOBBY_KEY = "tourney"
local TOURNEY_FORMAT = "CCT2"

ChloeCustomTourney = {
	id = 0,
	active = false,
	finished = false,
	events = { },		-- host only: list of events (format of the track selection / SetEvents)
	queue = { },		-- host only: order of the event indices
	played = 0,			-- number of counted events
	stuntsPlayed = 0,	-- host only: number of counted stunt events
	total = 0,
	standings = { },	-- { key = hex name, points, ai, last }
	raceStarted = false,
	pendingApply = false,
	dirty = false,
	lastValue = nil,
	lastPoll = nil,
	shownKey = nil,		-- "id:played" of the standings shown last (shown once after every counted event)
	nextTrack = 0,		-- track id of the next event (for the standings screen)
	random = false,
	loaded = false,
	stuntPending = nil,	-- host only: tag "id:played" of a stunt event whose results are still collected
	stuntWaitStart = nil,
}
-- The menu scripts are loaded again after every race (Fouc.exe runs main.bed when the menus start), so the state is
-- kept in ChloeSteamNet.asi (ChloeSteam_StoreSet/StoreGet) and restored by EnsureLoaded().

local function TourneyAvailable()
	return ChloeSteam_IsAvailable ~= nil and ChloeSteam_SetLobbyValue ~= nil and ChloeSteam_IsAvailable()
end

-- names are wide strings (UTF-16LE bytes, terminated by two zero bytes); the key is their hex text without terminator.
-- At most 15 characters: the race results come from GameFlow.PlayerInfo (name = wchar[16]), lobby names may be longer.
-- A string without any zero byte is taken as a narrow string (one byte per character).
local TOURNEY_NAME_CHARS = 15
local function NameKey(w)
	if type(w) ~= "string" then
		return ""
	end
	local t = { }
	local n = string.len(w)
	if string.find(w, "\0", 1, true) == nil then
		for i = 1, n do
			if i > TOURNEY_NAME_CHARS then
				break
			end
			table.insert(t, string.format("%02x00", string.byte(w, i)))
		end
		return table.concat(t)
	end
	local i = 1
	while i < n and table.getn(t) < TOURNEY_NAME_CHARS do
		local a = string.byte(w, i)
		local b = string.byte(w, i + 1)
		if a == 0 and b == 0 then
			break
		end
		table.insert(t, string.format("%02x%02x", a, b))
		i = i + 2
	end
	return table.concat(t)
end

-- readable ASCII form of a key for the log
local function KeyToAscii(k)
	local t = { }
	local n = string.len(k)
	local i = 1
	while i + 3 <= n do
		local lo = tonumber(string.sub(k, i, i + 1), 16) or 63
		local hi = tonumber(string.sub(k, i + 2, i + 3), 16) or 0
		if hi == 0 and lo >= 32 and lo < 127 and lo ~= 124 then
			table.insert(t, string.char(lo))
		else
			table.insert(t, "?")
		end
		i = i + 4
	end
	return table.concat(t)
end

local function TourneyLog(s)
	if ChloeSteam_Log ~= nil then
		ChloeSteam_Log("tourney: " .. s)
	end
end

local function KeyToName(k)
	local t = { }
	local n = string.len(k)
	local i = 1
	while i < n do
		table.insert(t, string.char(tonumber(string.sub(k, i, i + 1), 16) or 63))
		i = i + 2
	end
	return table.concat(t) .. "\0\0"
end

local function Split(s, sep)
	local t = { }
	local start = 1
	while true do
		local a = string.find(s, sep, start, true)
		if a == nil then
			table.insert(t, string.sub(s, start))
			return t
		end
		table.insert(t, string.sub(s, start, a - 1))
		start = a + 1
	end
end

local function FindEntry(key)
	for _, e in ipairs(ChloeCustomTourney.standings) do
		if e.key == key then
			return e
		end
	end
	return nil
end

local function AddEntry(key, ai)
	-- AI drivers first seen after stunt events still get the stunt points of those events
	local points = 0
	if ai then
		points = TOURNEY_AI_STUNT_POINTS * ChloeCustomTourney.stuntsPlayed
	end
	local e = { key = key, points = points, ai = ai, last = nil }
	table.insert(ChloeCustomTourney.standings, e)
	return e
end

local function LobbyPlayerKeys()
	local keys = { }
	for i = 1, ChloeNet_GetNumPlayers() do
		if ChloeNet_IsPlayerValid(i) then
			local k = NameKey(ChloeNet_GetPlayerName(i))
			if k ~= "" then
				keys[k] = true
			end
		end
	end
	return keys
end

-- PlayerPosition can contain 1,1,3 after a tie. PlayerVisualPosition contains the game's
-- complete ordered result list, with one position per driver even when scores are equal.
local function ResultIdsByPosition(count)
	local ids = {}
	for slot = 0, 31 do
		local position = db.GameFlow.PostRace:GetProperty("PlayerVisualPosition", slot)
		if position and position >= 1 and position <= count then
			ids[position] = slot + 1  -- GameFlow.GetPlayerName uses one-based indices
		end
	end
	return ids
end

local function IsStuntEvent(ev)
	if ev == nil then
		return false
	end
	return ev.rules == GAMETYPE_STUNT or (Levels[ev.trackid] ~= nil and Levels[ev.trackid].Rules == GR_STUNT)
end

-- sorted copy of the standings with ranks (equal points = equal rank)
function ChloeCustomTourney_GetSortedStandings()
	local list = { }
	for _, e in ipairs(ChloeCustomTourney.standings) do
		table.insert(list, e)
	end
	table.sort(list, function(a, b)
		if a.points ~= b.points then
			return a.points > b.points
		end
		if a.ai ~= b.ai then
			return not a.ai
		end
		return a.key < b.key
	end)
	for i, e in ipairs(list) do
		if i > 1 and list[i - 1].points == e.points then
			e.rank = list[i - 1].rank
		else
			e.rank = i
		end
	end
	return list
end

function ChloeCustomTourney_Reset()
	local T = ChloeCustomTourney
	T.active = false
	T.finished = false
	T.events = { }
	T.queue = { }
	T.played = 0
	T.stuntsPlayed = 0
	T.total = 0
	T.standings = { }
	T.raceStarted = false
	T.pendingApply = false
	T.dirty = false
	T.lastValue = nil
	T.lastPoll = nil
	T.nextTrack = 0
	T.stuntPending = nil
	T.stuntWaitStart = nil
	T.loaded = true		-- nothing to restore any more
	if ChloeSteam_ClearStuntResults ~= nil then
		ChloeSteam_ClearStuntResults()
	end
	if ChloeSteam_StoreSet ~= nil then
		ChloeSteam_StoreSet("tourney_pub", nil)
		ChloeSteam_StoreSet("tourney_host", nil)
	end
end

-- --- sharing the state (host writes, everybody else reads) ------------------------------------------------------

local function Serialize()
	local T = ChloeCustomTourney
	if table.getn(T.events) > 0 then	-- host: next event from its list
		T.nextTrack = 0
		local ev = T.events[T.queue[T.played + 1] or 0]
		if T.active and ev ~= nil then
			T.nextTrack = ev.trackid or 0
		end
	end
	local parts = { TOURNEY_FORMAT, T.id, T.active and 1 or 0, T.finished and 1 or 0, T.played, T.total, T.nextTrack or 0 }
	for _, e in ipairs(T.standings) do
		local last = e.last
		if last == nil then
			last = -1
		end
		table.insert(parts, e.key .. "," .. e.points .. "," .. (e.ai and 1 or 0) .. "," .. last)
	end
	return table.concat(parts, "|")
end

local function Parse(s)
	local f = Split(s, "|")
	if f[1] ~= TOURNEY_FORMAT or table.getn(f) < 7 then
		return
	end
	local T = ChloeCustomTourney
	T.id = tonumber(f[2]) or 0
	T.active = f[3] == "1"
	T.finished = f[4] == "1"
	T.played = tonumber(f[5]) or 0
	T.total = tonumber(f[6]) or 0
	T.nextTrack = tonumber(f[7]) or 0
	T.standings = { }
	for i = 8, table.getn(f) do
		local v = Split(f[i], ",")
		if table.getn(v) >= 4 and v[1] ~= "" then
			local last = tonumber(v[4])
			if last ~= nil and last < 0 then
				last = nil
			end
			table.insert(T.standings, { key = v[1], points = tonumber(v[2]) or 0, ai = v[3] == "1", last = last })
		end
	end
end

-- --- keeping the state while the menu scripts are reloaded (ChloeSteamNet.asi) ------------------------------------

local function NumField(v)
	if v == nil then
		return ""
	end
	return tostring(v)
end

local function SaveState()
	if ChloeSteam_StoreSet == nil then
		return
	end
	local T = ChloeCustomTourney
	if not T.active and not T.finished and table.getn(T.events) == 0 then
		ChloeSteam_StoreSet("tourney_pub", nil)
		ChloeSteam_StoreSet("tourney_host", nil)
	else
		ChloeSteam_StoreSet("tourney_pub", Serialize())
		local ev = { }
		for _, e in ipairs(T.events) do
			table.insert(ev, NumField(e.trackid) .. "," .. NumField(e.rules) .. "," .. NumField(e.lapsOrTimeLimit) .. "," .. NumField(e.weather) .. "," .. NumField(e.tracktype))
		end
		local q = { }
		for _, v in ipairs(T.queue) do
			table.insert(q, tostring(v))
		end
		ChloeSteam_StoreSet("tourney_host", table.concat({ "H1", tostring(T.stuntsPlayed), T.raceStarted and "1" or "0",
			T.pendingApply and "1" or "0", T.random and "1" or "0", table.concat(q, ","), table.concat(ev, ";"), T.stuntPending or "" }, "|"))
	end
	ChloeSteam_StoreSet("tourney_shown", T.shownKey)
end

local function EnsureLoaded()
	local T = ChloeCustomTourney
	if T.loaded or ChloeSteam_StoreGet == nil then
		return
	end
	T.loaded = true
	local pub = ChloeSteam_StoreGet("tourney_pub")
	if pub ~= nil then
		Parse(pub)
	end
	local host = ChloeSteam_StoreGet("tourney_host")
	if host ~= nil then
		local f = Split(host, "|")
		if f[1] == "H1" and table.getn(f) >= 7 then
			T.stuntsPlayed = tonumber(f[2]) or 0
			T.raceStarted = f[3] == "1"
			T.pendingApply = f[4] == "1"
			T.random = f[5] == "1"
			T.queue = { }
			if f[6] ~= "" then
				for _, v in ipairs(Split(f[6], ",")) do
					table.insert(T.queue, tonumber(v))
				end
			end
			T.events = { }
			if f[7] ~= "" then
				for _, s in ipairs(Split(f[7], ";")) do
					local v = Split(s, ",")
					table.insert(T.events, { trackid = tonumber(v[1]), rules = tonumber(v[2]), lapsOrTimeLimit = tonumber(v[3]),
						weather = tonumber(v[4]), tracktype = tonumber(v[5]) })
				end
			end
			if f[8] ~= nil and f[8] ~= "" then
				T.stuntPending = f[8]
			end
		end
	end
	T.shownKey = ChloeSteam_StoreGet("tourney_shown")
	if T.active or T.finished then
		TourneyLog("state restored: event " .. T.played .. "/" .. T.total .. ", race started " .. tostring(T.raceStarted) .. ", " .. table.getn(T.standings) .. " drivers")
	end
end

local function Publish()
	ChloeCustomTourney.dirty = false
	ChloeSteam_SetLobbyValue(TOURNEY_LOBBY_KEY, Serialize())
	SaveState()
end

-- --- host: events and points ------------------------------------------------------------------------------------

local function NormalizedEvent(e)
	local ev = { }
	for k, v in pairs(e) do
		ev[k] = v
	end
	local level = Levels[ev.trackid] or { }
	if ev.rules == nil then
		ev.rules = GAMETYPE_RACE
	end
	if ev.weather == nil then
		ev.weather = 0
	end
	if ev.lapsOrTimeLimit == nil then
		ev.lapsOrTimeLimit = level.Laps or 3
	end
	if ev.tracktype == nil then
		ev.tracktype = level.TrackType
	end
	ev.num = nil
	return ev
end

-- inLobby: called from the lobby's update. Chloe's SetEvents ends with EnterMenu("menu_chloemultiplayer_lobby"),
-- re-entering the running lobby from its own update is avoided (other menus, e.g. the car selection for stunts, open
-- normally).
local function ApplyCurrentEvent(inLobby)
	local T = ChloeCustomTourney
	local ev = T.events[T.queue[T.played + 1]]
	if ev == nil or ChloeCustomTourney_SetEvents == nil then
		if not inLobby then
			EnterMenu("menu_chloemultiplayer_lobby")
		end
		return
	end
	ev = NormalizedEvent(ev)
	TourneyLog("event " .. (T.played + 1) .. "/" .. T.total .. ": track " .. tostring(ev.trackid) .. ", rules " .. tostring(ev.rules))
	if inLobby then
		local realEnterMenu = EnterMenu
		local skipped = false
		EnterMenu = function(name)
			if name == "menu_chloemultiplayer_lobby" then
				skipped = true
			else
				realEnterMenu(name)
			end
		end
		local ok, err = pcall(ChloeCustomTourney_SetEvents, { ev })
		EnterMenu = realEnterMenu
		if not ok then
			TourneyLog("SetEvents failed: " .. tostring(err))
		end
		if skipped and BuildLobbyMenuButtons ~= nil then
			BuildLobbyMenuButtons()
		end
	else
		ChloeCustomTourney_SetEvents({ ev })	-- enters the lobby (or the car selection)
	end
end

function ChloeCustomTourney_Start(events, random)
	local T = ChloeCustomTourney
	local previousId = T.id or 0
	ChloeCustomTourney_Reset()
	T.id = previousId + 1 + ChloeCollection_GetRandom(1000) * 1000	-- differs from the previous tournament
	T.random = random
	for i, e in ipairs(events) do
		T.events[i] = NormalizedEvent(e)
		T.queue[i] = i
	end
	T.total = table.getn(T.events)
	if random then
		for i = T.total, 2, -1 do
			local j = ChloeCollection_GetRandom(i) + 1
			T.queue[i], T.queue[j] = T.queue[j], T.queue[i]
		end
	end
	local names = { }
	for k, _ in pairs(LobbyPlayerKeys()) do
		AddEntry(k, false)
		table.insert(names, KeyToAscii(k))
	end
	TourneyLog("started, " .. table.getn(T.events) .. " events, random " .. tostring(random) .. ", players: " .. table.concat(names, ", "))
	if T.total == 0 then
		ChloeCustomTourney_Reset()
		EnterMenu("menu_chloemultiplayer_lobby")
		return
	end
	T.active = true
	T.dirty = true
	SaveState()
	ApplyCurrentEvent()
end

function ChloeCustomTourney_OnStartRace()
	EnsureLoaded()
	if ChloeNet_IsServer() and ChloeCustomTourney.active then
		ChloeCustomTourney.raceStarted = true
		SaveState()	-- the menu scripts are reloaded after the race
	end
end

local function FinishEvent()
	local T = ChloeCustomTourney
	T.played = T.played + 1
	if T.played >= T.total then
		T.active = false
		T.finished = true
	else
		T.pendingApply = true
	end
	T.dirty = true
	SaveState()
end

-- Stunts: every player does the attempts at its own pace. A PC that finished before the others ranks them without
-- their last attempts, so every PC sends its ranking (players only) and the number of records it was missing
-- (ChloeSteamNet.asi); the host counts the event with the most complete ranking once everybody is back in the lobby.
local TOURNEY_STUNT_WAIT = 15	-- seconds after the last player is back, for rankings still on their way

local function StuntTag()
	return ChloeCustomTourney.id .. ":" .. ChloeCustomTourney.played
end

local function SendStuntResult()
	if ChloeSteam_GetLastStuntMissing == nil then
		return
	end
	local missing = ChloeSteam_GetLastStuntMissing()	-- nil if the plugin saw no final stunt ranking
	local n = GameFlow.GetNumResults() or 0
	local level = Levels[ChloeNet_GetLevelId()]
	local stunt = ChloeNet_GetGameRules() == GR_STUNT or (level ~= nil and level.Rules == GR_STUNT)
	if not stunt or n <= 0 or not ChloeCustomTourney.active then
		return
	end
	if missing == nil then
		missing = 999	-- still usable if nothing better arrives
	end
	if not ChloeNet_IsServer() and ChloeSteam_GetLobbyValue ~= nil then
		-- the event number of the tag must be the host's current one (the last poll may be older, e.g. after a sub menu)
		local v = ChloeSteam_GetLobbyValue(TOURNEY_LOBBY_KEY)
		if type(v) == "string" then
			Parse(v)
		end
	end
	local humans = LobbyPlayerKeys()
	local keys = { }
	local seen = { }
	local ids = ResultIdsByPosition(n)
	for i = 1, n do
		local id = ids[i]
		if id ~= nil then
			local key = NameKey(GameFlow.GetPlayerName(id))
			if humans[key] and not seen[key] then
				seen[key] = true
				table.insert(keys, key)
			end
		end
	end
	ChloeSteam_SendStuntResult(StuntTag() .. "|" .. missing .. "|" .. table.concat(keys, ","))
	TourneyLog("stunt ranking sent, " .. missing .. " records missing")
end

-- host: the rankings received for the pending stunt event (empty ones skipped) and the best of them:
-- fewest missing records, then most names, then the text (the same choice on every call)
local function ReadStuntRankings()
	local T = ChloeCustomTourney
	local list = { }
	local best = nil
	local maxNames = 0
	local all = ""
	if ChloeSteam_GetStuntResults ~= nil then
		all = ChloeSteam_GetStuntResults() or ""
	end
	for _, line in ipairs(Split(all, "\n")) do
		local f = Split(line, "|")
		if f[1] == T.stuntPending and table.getn(f) >= 3 and f[3] ~= "" then
			local r = { missing = tonumber(f[2]) or 999, names = 0, text = f[3] }
			for _, key in ipairs(Split(f[3], ",")) do
				if key ~= "" then
					r.names = r.names + 1
				end
			end
			table.insert(list, r)
			if r.names > maxNames then
				maxNames = r.names
			end
			if best == nil or r.missing < best.missing or (r.missing == best.missing and (r.names > best.names
				or (r.names == best.names and r.text < best.text))) then
				best = r
			end
		end
	end
	return list, best, maxNames
end

-- host: count the stunt event from the rankings received so far
local function CountStuntEvent()
	local T = ChloeCustomTourney
	local list, bestRanking = ReadStuntRankings()
	local results = table.getn(list)
	local best = nil
	local bestMissing = nil
	if bestRanking ~= nil then
		best = bestRanking.text
		bestMissing = bestRanking.missing
	end
	for _, e in ipairs(T.standings) do
		e.last = nil
	end
	local logparts = { }
	if best ~= nil and best ~= "" then
		local rank = 0
		for _, key in ipairs(Split(best, ",")) do
			if key ~= "" then
				local e = FindEntry(key)
				if e == nil then
					e = AddEntry(key, false)
				end
				rank = rank + 1
				local p = TOURNEY_POINTS[rank] or 0
				e.points = e.points + p
				e.last = p
				table.insert(logparts, rank .. ". " .. KeyToAscii(key))
			end
		end
	end
	for _, e in ipairs(T.standings) do
		if e.ai then
			e.points = e.points + TOURNEY_AI_STUNT_POINTS
			e.last = TOURNEY_AI_STUNT_POINTS
		end
	end
	T.stuntsPlayed = T.stuntsPlayed + 1
	TourneyLog("stunt event " .. (T.played + 1) .. " counted from " .. results .. " ranking(s), " .. tostring(bestMissing) .. " records missing: " .. table.concat(logparts, ", "))
	T.stuntPending = nil
	T.stuntWaitStart = nil
	if ChloeSteam_ClearStuntResults ~= nil then
		ChloeSteam_ClearStuntResults()
	end
	FinishEvent()
	-- no BuildLobbyMenuButtons here: the standings screen opens in the next update, and coming back to the lobby
	-- builds the buttons again (START RACE included)
end

-- enough rankings: one without missing records that names everybody, or one from every player of the stunt
-- (the longest ranking = the players of the stunt; players who joined during it do not count)
local function StuntResultsComplete()
	if ChloeSteam_GetStuntResults == nil then
		return true
	end
	local list, best, maxNames = ReadStuntRankings()
	if best ~= nil and best.missing == 0 and best.names >= maxNames then
		return true
	end
	return maxNames > 0 and table.getn(list) >= maxNames
end

-- the host's question (STOP TOURNAMENT) or the lobby's quit question is open: no screen change now
ChloeCustomTourney_DialogOpen = false

-- called when the lobby is created after a race, before GameFlow.ClearRace() (results are still available)
function ChloeCustomTourney_CaptureResults()
	EnsureLoaded()
	local T = ChloeCustomTourney
	SendStuntResult()	-- every PC (stunt events only)
	if not T.active or not T.raceStarted or not ChloeNet_IsServer() then
		return
	end
	local n = GameFlow.GetNumResults() or 0
	if n <= 0 then
		TourneyLog("lobby entered without race results")
		return
	end
	T.raceStarted = false

	local ev = T.events[T.queue[T.played + 1]]
	local stunt = IsStuntEvent(ev)
	if stunt and ChloeSteam_GetStuntResults ~= nil then
		T.stuntPending = StuntTag()
		T.stuntWaitStart = nil
		TourneyLog("stunt event " .. (T.played + 1) .. ": waiting for the rankings of all players")
		SaveState()
		return
	end
	local humans = LobbyPlayerKeys()
	for _, e in ipairs(T.standings) do
		e.last = nil
	end

	local rank = 0
	local counted = { }
	local logparts = { }
	local ids = ResultIdsByPosition(n)
	for i = 1, n do
		local id = ids[i]
		local key = ""
		if id ~= nil then
			key = NameKey(GameFlow.GetPlayerName(id))
		end
		table.insert(logparts, i .. ". " .. KeyToAscii(key) .. (humans[key] and " (player)" or ""))
		if key ~= "" and not counted[key] then
			local e = FindEntry(key)
			local human = humans[key] or (e ~= nil and not e.ai)
			-- stunts: only the players are ranked (simulated drivers do not belong to the tournament)
			if not stunt or human then
				counted[key] = true
				if e == nil then
					e = AddEntry(key, not human)
				end
				rank = rank + 1
				local p = TOURNEY_POINTS[stunt and rank or i] or 0
				e.points = e.points + p
				e.last = p
			end
		end
	end
	if stunt then
		for _, e in ipairs(T.standings) do
			if e.ai then
				e.points = e.points + TOURNEY_AI_STUNT_POINTS
				e.last = TOURNEY_AI_STUNT_POINTS
			end
		end
		T.stuntsPlayed = T.stuntsPlayed + 1
	end
	TourneyLog("event " .. (T.played + 1) .. " counted, stunt " .. tostring(stunt) .. ", results: " .. table.concat(logparts, ", "))
	FinishEvent()
end

-- host: count a waiting stunt event now with the rankings received so far (e.g. a player hangs in the race)
local function CountStuntNow()
	GUI:HideMenuButtons()
	ChloeCustomTourney_DialogOpen = true
	MessageBox(L"COUNT THE STUNT NOW WITH THE RESULTS RECEIVED SO FAR?", MESSAGEBOX_YESNO, function(value)
		ChloeCustomTourney_DialogOpen = false
		if value == TRUE and ChloeCustomTourney.stuntPending ~= nil then
			TourneyLog("stunt event counted by the host (COUNT STUNT NOW)")
			CountStuntEvent()
		end
		EnterMenu("menu_chloemultiplayer_lobby")
	end)
end

local function StopTournament()
	GUI:HideMenuButtons()
	ChloeCustomTourney_DialogOpen = true
	MessageBox(L"STOP THE TOURNAMENT?", MESSAGEBOX_YESNO, function(value)
		ChloeCustomTourney_DialogOpen = false
		if value == TRUE then
			ChloeCustomTourney_Reset()
			Publish()
		end
		EnterMenu("menu_chloemultiplayer_lobby")
	end)
end

local function OpenBuilder()
	ChloeNet_SetPlayerChangingTrack(1)
	ChloeCustomTourney_EnterBuilder(GAMETYPE_TOURNAMENT,
		function(events, random)
			ChloeCustomTourney_Start(events, random)
		end,
		function()
			EnterMenu("menu_chloemultiplayer_lobby")
		end,
		false,
		table.getn(ChloeCustomTourney.events) > 0)
end

-- --- lobby hooks ------------------------------------------------------------------------------------------------

function ChloeCustomTourney_IsActive()
	EnsureLoaded()
	return TourneyAvailable() and ChloeCustomTourney.active
end

function ChloeCustomTourney_AddLobbyButtons(menu)
	if not TourneyAvailable() then
		return
	end
	EnsureLoaded()
	local T = ChloeCustomTourney
	local items = menu.items
	local new = { }
	local startRemoved = false
	if ChloeNet_IsServer() then
		if T.active then
			for i = table.getn(items), 1, -1 do
				if items[i][1] == MULTIPLAYER_ICON_CHANGETRACK then
					table.remove(items, i)
				elseif T.stuntPending ~= nil and items[i][1] == ICON_MULTIPLAYER_STARTRACE then
					table.remove(items, i)	-- no new start while the last stunt is not counted yet
					startRemoved = true
				end
			end
			if T.stuntPending ~= nil then
				table.insert(new, { L("COUNT STUNT NOW"), CountStuntNow, ICON(menu, "icon_go_race") })
			end
			table.insert(new, { L("STOP TOURNAMENT"), StopTournament, ICON(menu, "icon_profile_x") })
		else
			table.insert(new, { L("TOURNAMENT"), OpenBuilder, ICON(menu, "icon_change_track") })
		end
	end
	if T.active or T.finished then
		table.insert(new, { L("STANDINGS"), function() ChloeCustomTourney_ShowStandings() end, ICON(menu, "icon_session_details") })
	end
	-- before the last button (START RACE / READY / UNREADY)
	local pos = table.getn(items)
	if startRemoved then
		pos = pos + 1	-- no START RACE: at the end
	end
	if pos < 1 then
		pos = 1
	end
	for i, item in ipairs(new) do
		table.insert(items, pos + i - 1, item)
	end
end

function ChloeCustomTourney_RowText(playerId, ping)
	EnsureLoaded()
	local T = ChloeCustomTourney
	if not TourneyAvailable() or not (T.active or T.finished) then
		return ConvertToWString(ping)
	end
	local e = FindEntry(NameKey(ChloeNet_GetPlayerName(playerId)))
	local points = 0
	if e ~= nil then
		points = e.points
	end
	return L(points .. "  (" .. tostring(ping) .. ")")
end

-- inLobbyMode: the lobby shows its own buttons (no player selection, kick or ban question open)
function ChloeCustomTourney_LobbyUpdate(menu, time, inLobbyMode)
	if not TourneyAvailable() then
		return
	end
	EnsureLoaded()
	local T = ChloeCustomTourney
	if ChloeNet_IsServer() then
		if T.dirty then
			Publish()
		end
	elseif T.lastPoll == nil or time < T.lastPoll or time - T.lastPoll > 0.5 then
		T.lastPoll = time
		local v = ChloeSteam_GetLobbyValue(TOURNEY_LOBBY_KEY)
		if v ~= T.lastValue then
			local wasActive = T.active or T.finished
			T.lastValue = v
			if v == nil then
				ChloeCustomTourney_Reset()
			else
				Parse(v)
				SaveState()
			end
			if wasActive ~= (T.active or T.finished) and BuildLobbyMenuButtons ~= nil then
				BuildLobbyMenuButtons()
			end
		end
	end

	-- screen changes and counting only while the lobby is free (no question or sub mode open)
	local free = inLobbyMode ~= false and not ChloeCustomTourney_DialogOpen

	-- after every counted event: standings screen (once per event, like the vanilla screen after a tournament race)
	if free and (T.active or T.finished) and T.played > 0 then
		local key = T.id .. ":" .. T.played
		if T.shownKey ~= key then
			T.shownKey = key
			SaveState()
			ChloeCustomTourney_ShowStandings()
			return
		end
	end

	-- host: stunt event counted when everybody is back and the rankings are there (or after a short wait)
	if ChloeNet_IsServer() and T.stuntPending ~= nil then
		if ChloeNet_IsLobbyInGame() then
			T.stuntWaitStart = nil
		else
			if T.stuntWaitStart == nil or time < T.stuntWaitStart then
				T.stuntWaitStart = time
			end
			if free and (StuntResultsComplete() or time - T.stuntWaitStart > TOURNEY_STUNT_WAIT) then
				CountStuntEvent()
				return
			end
		end
	end

	-- host: next event, as soon as nobody is racing any more
	if free and ChloeNet_IsServer() and T.pendingApply and not ChloeNet_IsLobbyInGame() then
		T.pendingApply = false
		SaveState()
		ApplyCurrentEvent(true)
	end

	local header = W("chloecustom_pingheader")
	if T.active or T.finished then
		W("sessiondetails_bd"):ShowWindow()
		W("eventnum_title"):SetTitle(L"TOURNAMENT:")
		if T.finished then
			W("eventnum"):SetTitle(L("FINISHED (" .. T.total .. " EVENTS)"))
		elseif T.stuntPending ~= nil and ChloeNet_IsServer() then
			W("eventnum"):SetTitle(L("WAITING FOR STUNT RESULTS"))
		else
			W("eventnum"):SetTitle(L("EVENT " .. (T.played + 1) .. " OF " .. T.total))
		end
		W("eventnum_title"):ShowWindow()
		W("eventnum"):ShowWindow()
		if header then
			header:SetTitle(L"PTS (PING)")
		end
	elseif header then
		header:SetTitle(L"PING")
	end
end

-- --- standings menu -----------------------------------------------------------------------------------------------

menu_chloecustom_tourney_standings = CreateMenuFromTemplate("template_multiplayer")
menu_chloecustom_tourney_standings.options.title = L""
menu_chloecustom_tourney_standings.back = function() EnterMenu("menu_chloemultiplayer_lobby") end

function ChloeCustomTourney_ShowStandings()
	EnterMenu("menu_chloecustom_tourney_standings")
end

function menu_chloecustom_tourney_standings.create(self)
	self.parent:create(self)
	self:addResource("cup_next_race_elements.tga", cup_next_race_elements, cup_next_race_elements_size)
	self:loadResources()
end

local function LocalPlayerKey()
	for i = 1, ChloeNet_GetNumPlayers() do
		if ChloeNet_IsPlayerValid(i) and ChloeNet_IsPlayerLocalPlayer(i) then
			return NameKey(ChloeNet_GetPlayerName(i))
		end
	end
	return nil
end

-- layout like the vanilla MultiplayerTournamentStandings.bed (shown after each tournament race); one list for up to
-- 12 drivers, two columns for more (with AI there can be up to 32)
function menu_chloecustom_tourney_standings.init(self)
	self.parent:init(self)
	EnsureLoaded()
	local T = ChloeCustomTourney

	Frame { Position=LEFTPOS(0,66), Size=SIZE(ChloeWidescreen_GetRight(),44) }:AttachResource(self:getResource("cup_title_bd"))
	StaticText { Title=L"TOURNAMENT STANDINGS", Font=fonttitle(), Color=GetPaletteColor(33), Position=POS(320,67), Size=SIZE(400,22), Align=FONTF_CENTER }

	local info
	if T.finished then
		info = L("FINAL RESULT AFTER " .. T.total .. " EVENTS")
	elseif T.active then
		info = L("AFTER EVENT " .. T.played .. " OF " .. T.total)
		local level = Levels[T.nextTrack or 0]
		if level ~= nil and level.Name ~= nil then
			info = WStringConcat(info, L("   -   NEXT: " .. level.Name))
		end
	else
		info = L"NO TOURNAMENT"
	end
	StaticText { Title=info, Font=fontsmall(), Color=GetPaletteColor(34), Position=POS(320,112), Size=SIZE(500,14), Align=FONTF_CENTER }

	local list = ChloeCustomTourney_GetSortedStandings()
	if T.finished and list[1] ~= nil then
		local winner = WStringConcat(L"WINNER: ", EscapeString(KeyToName(list[1].key)))
		StaticText { Title=winner, Font=fontmedium(), Color=GetPaletteColor(33), Position=POS(320,122), Size=SIZE(500,16), Align=FONTF_CENTER }
	end

	local localKey = LocalPlayerKey()
	local num = table.getn(list)
	local twoColumns = num > 12
	local rowh, pad, perColumn, colWidth
	if twoColumns then
		rowh, pad, perColumn, colWidth = 14, 1, 16, 300
	else
		rowh, pad, perColumn, colWidth = 18, 3, 12, 600
	end

	-- column titles
	for col = 0, (twoColumns and 1 or 0) do
		local x = 20 + col * (colWidth + 20)
		StaticText { Title=L"#", Font=fontsmall(), Color=GetPaletteColor(33), Position=POS(x + 4,140), Size=SIZE(20,13), Align=FONTF_CENTER }
		StaticText { Title=MULTIPLAYER_NAME, Font=fontsmall(), Color=GetPaletteColor(33), Position=POS(x + 30,140), Size=SIZE(200,13) }
		StaticText { Title=L"LAST", Font=fontsmall(), Color=GetPaletteColor(33), Position=POS(x + colWidth - 75,140), Size=SIZE(40,13), Align=FONTF_CENTER }
		StaticText { Title=MULTIPLAYER_POINTS, Font=fontsmall(), Color=GetPaletteColor(33), Position=POS(x + colWidth - 25,140), Size=SIZE(50,13), Align=FONTF_CENTER }
	end

	for i, e in ipairs(list) do
		if i > perColumn * 2 then
			break
		end
		local col = math.floor((i - 1) / perColumn)
		local row = math.mod(i - 1, perColumn)
		local x = 20 + col * (colWidth + 20)
		local y = 157 + row * (rowh + pad)
		local bg = Frame { Position=POS(x - 6, y), Size=SIZE(colWidth + 12, rowh), DrawBackgroundColor=TRUE, Layer=1 }
		if e.key == localKey then
			bg:SetColor(GetPaletteColor(33), false)
			bg:SetAlpha(0.35)
		else
			bg:SetColor({0,0,0,MAX_VERTEXCOLOR_A}, false)
			bg:SetAlpha(0.5)
		end
		local color = GetPaletteColor(34)
		local name = EscapeString(KeyToName(e.key))
		if e.ai then
			name = WStringConcat(name, L"  (AI)")
		end
		local last = L""
		if e.last ~= nil then
			last = L("+" .. e.last)
		end
		local ty = y + (rowh - 13) / 2
		StaticText { Title=L(e.rank .. "."), Font=fontsmall(), Color=GetPaletteColor(34), Position=POS(x + 4,ty), Size=SIZE(20,13), Align=FONTF_CENTER, Layer=2 }
		StaticText { Title=name, Font=fontsmall(), Color=color, Position=POS(x + 30,ty), Size=SIZE(colWidth - 110,13), Layer=2 }
		StaticText { Title=last, Font=fontsmall(), Color=GetPaletteColor(34), Position=POS(x + colWidth - 75,ty), Size=SIZE(40,13), Align=FONTF_CENTER, Layer=2 }
		StaticText { Title=L(e.points), Font=fontsmall(), Color=GetPaletteColor(1), Position=POS(x + colWidth - 25,ty), Size=SIZE(50,13), Align=FONTF_CENTER, Layer=2 }
	end

	self.items = { { ICON_MULTIPLAYER_CONTINUE, function() EnterMenu("menu_chloemultiplayer_lobby") end, ICON(self, "icon_continue"), ICON(self, "icon_continue_s") } }
	GUI:InitMenuButtons(self.items)
	GUI:SetActiveItem(1)
	GUI:ShowMenuButtons()
	GUI:SetHelpButtons(BUTTON_OK, TRANSLATOR(UI_CONTINUE), BUTTON_BACK, UI_BACK)
end

function menu_chloecustom_tourney_standings.update(self, time)
	self.parent:update(self, time)
	if not ChloeNet_IsConnected() then
		ChloeCustomTourney_Reset()
		EnterMenu("menu_chloemultiplayer")
	end
end

function menu_chloecustom_tourney_standings.deinit(self)
	self.parent:deinit(self)
end

