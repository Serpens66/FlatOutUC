--///////////////////////////////////////////////////////////////////////////
--// chloecustom_tournament.bed  (ChloeCustom Tourney, Steam package only)
--//
--// Tournament for Chloe's multiplayer: the host builds a list of events (editor = copy of the vanilla
--// MultiplayerBuildTournament.bed, below), the events are played one after another (or in random order), every
--// driver (players and AI) gets points per event (vanilla table 10-8-6-5-4-3-2-1). AI drivers get 4 points for
--// stunt events (stunts have no AI). Only the host counts; the standings are shared with all players through the
--// Steam lobby data (ChloeSteam_SetLobbyValue / ChloeSteam_GetLobbyValue of ChloeSteamNet.asi).
--// Hooks in chloemultiplayer_lobby.bed (all guarded with "if ChloeCustomTourney_... then"):
--//   create: ChloeCustomTourney_CaptureResults() before GameFlow.ClearRace()
--//   StartRace: ChloeCustomTourney_OnStartRace()
--//   BuildLobbyMenuButtons: ChloeCustomTourney_AddLobbyButtons(menu)
--//   update: ChloeCustomTourney_LobbyUpdate(menu, time)
--//   player list: ChloeCustomTourney_RowText(playerId, ping)
--//   leaving the lobby: ChloeCustomTourney_Reset()
--///////////////////////////////////////////////////////////////////////////

local TOURNEY_POINTS = { 10, 8, 6, 5, 4, 3, 2, 1 }
local TOURNEY_AI_STUNT_POINTS = 4
local TOURNEY_LOBBY_KEY = "tourney"
local TOURNEY_FORMAT = "CCT1"

ChloeCustomTourney = {
	id = 0,
	active = false,
	finished = false,
	events = { },		-- host only: list of events (format of the track selection / SetEvents)
	queue = { },		-- host only: order of the event indices
	played = 0,			-- number of counted events
	stuntsPlayed = 0,	-- host only: number of counted stunt events
	total = 0,
	standings = { },	-- { key = hex name, points, ai, last }
	raceStarted = false,
	pendingApply = false,
	dirty = false,
	lastValue = nil,
	lastPoll = nil,
	finalShownId = nil,
	random = false,
}

local function TourneyAvailable()
	return ChloeSteam_IsAvailable ~= nil and ChloeSteam_SetLobbyValue ~= nil and ChloeSteam_IsAvailable()
end

-- names are wide strings (UTF-16LE bytes, terminated by two zero bytes); the key is their hex text without terminator.
-- At most 15 characters: the race results come from GameFlow.PlayerInfo (name = wchar[16]), lobby names may be longer.
-- A string without any zero byte is taken as a narrow string (one byte per character).
local TOURNEY_NAME_CHARS = 15
local function NameKey(w)
	if type(w) ~= "string" then
		return ""
	end
	local t = { }
	local n = string.len(w)
	if string.find(w, "\0", 1, true) == nil then
		for i = 1, n do
			if i > TOURNEY_NAME_CHARS then
				break
			end
			table.insert(t, string.format("%02x00", string.byte(w, i)))
		end
		return table.concat(t)
	end
	local i = 1
	while i < n and table.getn(t) < TOURNEY_NAME_CHARS do
		local a = string.byte(w, i)
		local b = string.byte(w, i + 1)
		if a == 0 and b == 0 then
			break
		end
		table.insert(t, string.format("%02x%02x", a, b))
		i = i + 2
	end
	return table.concat(t)
end

-- readable ASCII form of a key for the log
local function KeyToAscii(k)
	local t = { }
	local n = string.len(k)
	local i = 1
	while i + 3 <= n do
		local lo = tonumber(string.sub(k, i, i + 1), 16) or 63
		local hi = tonumber(string.sub(k, i + 2, i + 3), 16) or 0
		if hi == 0 and lo >= 32 and lo < 127 and lo ~= 124 then
			table.insert(t, string.char(lo))
		else
			table.insert(t, "?")
		end
		i = i + 4
	end
	return table.concat(t)
end

local function TourneyLog(s)
	if ChloeSteam_Log ~= nil then
		ChloeSteam_Log("tourney: " .. s)
	end
end

local function KeyToName(k)
	local t = { }
	local n = string.len(k)
	local i = 1
	while i < n do
		table.insert(t, string.char(tonumber(string.sub(k, i, i + 1), 16) or 63))
		i = i + 2
	end
	return table.concat(t) .. "\0\0"
end

local function Split(s, sep)
	local t = { }
	local start = 1
	while true do
		local a = string.find(s, sep, start, true)
		if a == nil then
			table.insert(t, string.sub(s, start))
			return t
		end
		table.insert(t, string.sub(s, start, a - 1))
		start = a + 1
	end
end

local function FindEntry(key)
	for _, e in ipairs(ChloeCustomTourney.standings) do
		if e.key == key then
			return e
		end
	end
	return nil
end

local function AddEntry(key, ai)
	-- AI drivers first seen after stunt events still get the stunt points of those events
	local points = 0
	if ai then
		points = TOURNEY_AI_STUNT_POINTS * ChloeCustomTourney.stuntsPlayed
	end
	local e = { key = key, points = points, ai = ai, last = nil }
	table.insert(ChloeCustomTourney.standings, e)
	return e
end

local function LobbyPlayerKeys()
	local keys = { }
	for i = 1, ChloeNet_GetNumPlayers() do
		if ChloeNet_IsPlayerValid(i) then
			local k = NameKey(ChloeNet_GetPlayerName(i))
			if k ~= "" then
				keys[k] = true
			end
		end
	end
	return keys
end

local function IsStuntEvent(ev)
	if ev == nil then
		return false
	end
	return ev.rules == GAMETYPE_STUNT or (Levels[ev.trackid] ~= nil and Levels[ev.trackid].Rules == GR_STUNT)
end

-- sorted copy of the standings with ranks (equal points = equal rank)
function ChloeCustomTourney_GetSortedStandings()
	local list = { }
	for _, e in ipairs(ChloeCustomTourney.standings) do
		table.insert(list, e)
	end
	table.sort(list, function(a, b)
		if a.points ~= b.points then
			return a.points > b.points
		end
		if a.ai ~= b.ai then
			return not a.ai
		end
		return a.key < b.key
	end)
	for i, e in ipairs(list) do
		if i > 1 and list[i - 1].points == e.points then
			e.rank = list[i - 1].rank
		else
			e.rank = i
		end
	end
	return list
end

function ChloeCustomTourney_Reset()
	local T = ChloeCustomTourney
	T.active = false
	T.finished = false
	T.events = { }
	T.queue = { }
	T.played = 0
	T.stuntsPlayed = 0
	T.total = 0
	T.standings = { }
	T.raceStarted = false
	T.pendingApply = false
	T.dirty = false
	T.lastValue = nil
	T.lastPoll = nil
end

-- --- sharing the state (host writes, everybody else reads) ------------------------------------------------------

local function Serialize()
	local T = ChloeCustomTourney
	local parts = { TOURNEY_FORMAT, T.id, T.active and 1 or 0, T.finished and 1 or 0, T.played, T.total }
	for _, e in ipairs(T.standings) do
		local last = e.last
		if last == nil then
			last = -1
		end
		table.insert(parts, e.key .. "," .. e.points .. "," .. (e.ai and 1 or 0) .. "," .. last)
	end
	return table.concat(parts, "|")
end

local function Parse(s)
	local f = Split(s, "|")
	if f[1] ~= TOURNEY_FORMAT or table.getn(f) < 6 then
		return
	end
	local T = ChloeCustomTourney
	T.id = tonumber(f[2]) or 0
	T.active = f[3] == "1"
	T.finished = f[4] == "1"
	T.played = tonumber(f[5]) or 0
	T.total = tonumber(f[6]) or 0
	T.standings = { }
	for i = 7, table.getn(f) do
		local v = Split(f[i], ",")
		if table.getn(v) >= 4 and v[1] ~= "" then
			local last = tonumber(v[4])
			if last ~= nil and last < 0 then
				last = nil
			end
			table.insert(T.standings, { key = v[1], points = tonumber(v[2]) or 0, ai = v[3] == "1", last = last })
		end
	end
end

local function Publish()
	ChloeCustomTourney.dirty = false
	ChloeSteam_SetLobbyValue(TOURNEY_LOBBY_KEY, Serialize())
end

-- --- host: events and points ------------------------------------------------------------------------------------

local function NormalizedEvent(e)
	local ev = { }
	for k, v in pairs(e) do
		ev[k] = v
	end
	local level = Levels[ev.trackid] or { }
	if ev.rules == nil then
		ev.rules = GAMETYPE_RACE
	end
	if ev.weather == nil then
		ev.weather = 0
	end
	if ev.lapsOrTimeLimit == nil then
		ev.lapsOrTimeLimit = level.Laps or 3
	end
	if ev.tracktype == nil then
		ev.tracktype = level.TrackType
	end
	ev.num = nil
	return ev
end

-- inLobby: called from the lobby's update. Chloe's SetEvents ends with EnterMenu("menu_chloemultiplayer_lobby"),
-- re-entering the running lobby from its own update is avoided (other menus, e.g. the car selection for stunts, open
-- normally).
local function ApplyCurrentEvent(inLobby)
	local T = ChloeCustomTourney
	local ev = T.events[T.queue[T.played + 1]]
	if ev == nil or ChloeCustomTourney_SetEvents == nil then
		if not inLobby then
			EnterMenu("menu_chloemultiplayer_lobby")
		end
		return
	end
	ev = NormalizedEvent(ev)
	TourneyLog("event " .. (T.played + 1) .. "/" .. T.total .. ": track " .. tostring(ev.trackid) .. ", rules " .. tostring(ev.rules))
	if inLobby then
		local realEnterMenu = EnterMenu
		local skipped = false
		EnterMenu = function(name)
			if name == "menu_chloemultiplayer_lobby" then
				skipped = true
			else
				realEnterMenu(name)
			end
		end
		local ok, err = pcall(ChloeCustomTourney_SetEvents, { ev })
		EnterMenu = realEnterMenu
		if not ok then
			TourneyLog("SetEvents failed: " .. tostring(err))
		end
		if skipped and BuildLobbyMenuButtons ~= nil then
			BuildLobbyMenuButtons()
		end
	else
		ChloeCustomTourney_SetEvents({ ev })	-- enters the lobby (or the car selection)
	end
end

function ChloeCustomTourney_Start(events, random)
	local T = ChloeCustomTourney
	local previousId = T.id or 0
	ChloeCustomTourney_Reset()
	T.id = previousId + 1 + ChloeCollection_GetRandom(1000) * 1000	-- differs from the previous tournament
	T.random = random
	for i, e in ipairs(events) do
		T.events[i] = NormalizedEvent(e)
		T.queue[i] = i
	end
	T.total = table.getn(T.events)
	if random then
		for i = T.total, 2, -1 do
			local j = ChloeCollection_GetRandom(i) + 1
			T.queue[i], T.queue[j] = T.queue[j], T.queue[i]
		end
	end
	local names = { }
	for k, _ in pairs(LobbyPlayerKeys()) do
		AddEntry(k, false)
		table.insert(names, KeyToAscii(k))
	end
	TourneyLog("started, " .. table.getn(T.events) .. " events, random " .. tostring(random) .. ", players: " .. table.concat(names, ", "))
	if T.total == 0 then
		ChloeCustomTourney_Reset()
		EnterMenu("menu_chloemultiplayer_lobby")
		return
	end
	T.active = true
	T.dirty = true
	ApplyCurrentEvent()
end

function ChloeCustomTourney_OnStartRace()
	if ChloeNet_IsServer() and ChloeCustomTourney.active then
		ChloeCustomTourney.raceStarted = true
	end
end

-- called when the lobby is created after a race, before GameFlow.ClearRace() (results are still available)
function ChloeCustomTourney_CaptureResults()
	local T = ChloeCustomTourney
	if not T.active or not T.raceStarted or not ChloeNet_IsServer() then
		return
	end
	local n = GameFlow.GetNumResults() or 0
	if n <= 0 then
		TourneyLog("lobby entered without race results")
		return
	end
	T.raceStarted = false

	local ev = T.events[T.queue[T.played + 1]]
	local stunt = IsStuntEvent(ev)
	local humans = LobbyPlayerKeys()
	for _, e in ipairs(T.standings) do
		e.last = nil
	end

	local rank = 0
	local counted = { }
	local logparts = { }
	for i = 1, n do
		local id = GameFlow.GetPlayerIdByPosition(i)
		local key = ""
		if id ~= nil then
			key = NameKey(GameFlow.GetPlayerName(id))
		end
		table.insert(logparts, i .. ". " .. KeyToAscii(key) .. (humans[key] and " (player)" or ""))
		if key ~= "" and not counted[key] then
			local e = FindEntry(key)
			local human = humans[key] or (e ~= nil and not e.ai)
			-- stunts: only the players are ranked (simulated drivers do not belong to the tournament)
			if not stunt or human then
				counted[key] = true
				if e == nil then
					e = AddEntry(key, not human)
				end
				rank = rank + 1
				local p = TOURNEY_POINTS[rank] or 0
				e.points = e.points + p
				e.last = p
			end
		end
	end
	if stunt then
		for _, e in ipairs(T.standings) do
			if e.ai then
				e.points = e.points + TOURNEY_AI_STUNT_POINTS
				e.last = TOURNEY_AI_STUNT_POINTS
			end
		end
		T.stuntsPlayed = T.stuntsPlayed + 1
	end
	TourneyLog("event " .. (T.played + 1) .. " counted, stunt " .. tostring(stunt) .. ", results: " .. table.concat(logparts, ", "))

	T.played = T.played + 1
	if T.played >= T.total then
		T.active = false
		T.finished = true
	else
		T.pendingApply = true
	end
	T.dirty = true
end

local function StopTournament()
	GUI:HideMenuButtons()
	MessageBox(L"STOP THE TOURNAMENT?", MESSAGEBOX_YESNO, function(value)
		if value == TRUE then
			ChloeCustomTourney_Reset()
			Publish()
		end
		EnterMenu("menu_chloemultiplayer_lobby")
	end)
end

local function OpenBuilder()
	ChloeNet_SetPlayerChangingTrack(1)
	ChloeCustomTourney_EnterBuilder(GAMETYPE_TOURNAMENT,
		function(events, random)
			ChloeCustomTourney_Start(events, random)
		end,
		function()
			EnterMenu("menu_chloemultiplayer_lobby")
		end,
		false,
		table.getn(ChloeCustomTourney.events) > 0)
end

-- --- lobby hooks ------------------------------------------------------------------------------------------------

function ChloeCustomTourney_IsActive()
	return TourneyAvailable() and ChloeCustomTourney.active
end

function ChloeCustomTourney_AddLobbyButtons(menu)
	if not TourneyAvailable() then
		return
	end
	local T = ChloeCustomTourney
	local items = menu.items
	local new = { }
	if ChloeNet_IsServer() then
		if T.active then
			for i = table.getn(items), 1, -1 do
				if items[i][1] == MULTIPLAYER_ICON_CHANGETRACK then
					table.remove(items, i)
				end
			end
			table.insert(new, { L("STOP TOURNAMENT"), StopTournament, ICON(menu, "icon_profile_x") })
		else
			table.insert(new, { L("TOURNAMENT"), OpenBuilder, ICON(menu, "icon_change_track") })
		end
	end
	if T.active or T.finished then
		table.insert(new, { L("STANDINGS"), function() ChloeCustomTourney_ShowStandings() end, ICON(menu, "icon_session_details") })
	end
	-- before the last button (START RACE / READY / UNREADY)
	local pos = table.getn(items)
	if pos < 1 then
		pos = 1
	end
	for i, item in ipairs(new) do
		table.insert(items, pos + i - 1, item)
	end
end

function ChloeCustomTourney_RowText(playerId, ping)
	local T = ChloeCustomTourney
	if not TourneyAvailable() or not (T.active or T.finished) then
		return ConvertToWString(ping)
	end
	local e = FindEntry(NameKey(ChloeNet_GetPlayerName(playerId)))
	local points = 0
	if e ~= nil then
		points = e.points
	end
	return L(points .. "  (" .. tostring(ping) .. ")")
end

function ChloeCustomTourney_LobbyUpdate(menu, time)
	if not TourneyAvailable() then
		return
	end
	local T = ChloeCustomTourney
	if ChloeNet_IsServer() then
		if T.dirty then
			Publish()
		end
		if T.pendingApply and not ChloeNet_IsLobbyInGame() then
			T.pendingApply = false
			ApplyCurrentEvent(true)
		end
	elseif T.lastPoll == nil or time < T.lastPoll or time - T.lastPoll > 0.5 then
		T.lastPoll = time
		local v = ChloeSteam_GetLobbyValue(TOURNEY_LOBBY_KEY)
		if v ~= T.lastValue then
			local wasActive = T.active or T.finished
			T.lastValue = v
			if v == nil then
				ChloeCustomTourney_Reset()
			else
				Parse(v)
			end
			if wasActive ~= (T.active or T.finished) and BuildLobbyMenuButtons ~= nil then
				BuildLobbyMenuButtons()
			end
		end
	end

	local header = W("chloecustom_pingheader")
	if T.active or T.finished then
		W("sessiondetails_bd"):ShowWindow()
		W("eventnum_title"):SetTitle(L"TOURNAMENT:")
		if T.finished then
			W("eventnum"):SetTitle(L("FINISHED (" .. T.total .. " EVENTS)"))
		else
			W("eventnum"):SetTitle(L("EVENT " .. (T.played + 1) .. " OF " .. T.total))
		end
		W("eventnum_title"):ShowWindow()
		W("eventnum"):ShowWindow()
		if header then
			header:SetTitle(L"PTS (PING)")
		end
	elseif header then
		header:SetTitle(L"PING")
	end

	if T.finished and T.finalShownId ~= T.id then
		T.finalShownId = T.id
		ChloeCustomTourney_ShowStandings()
	end
end

-- --- standings menu -----------------------------------------------------------------------------------------------

menu_chloecustom_tourney_standings = CreateMenuFromTemplate("template_multiplayer")
menu_chloecustom_tourney_standings.options.title = L""
menu_chloecustom_tourney_standings.back = function() EnterMenu("menu_chloemultiplayer_lobby") end

function ChloeCustomTourney_ShowStandings()
	EnterMenu("menu_chloecustom_tourney_standings")
end

function menu_chloecustom_tourney_standings.create(self)
	self.parent:create(self)
	self:addResource("cup_next_race_elements.tga", cup_next_race_elements, cup_next_race_elements_size)
	self:loadResources()
end

function menu_chloecustom_tourney_standings.init(self)
	self.parent:init(self)
	local T = ChloeCustomTourney

	Frame { Position=LEFTPOS(0,39), Size=SIZE(ChloeWidescreen_GetRight(),42) }:AttachResource(self:getResource("cup_title_bd"))
	StaticText { Title=L"TOURNAMENT STANDINGS", Font=fonttitle(), Color=GetPaletteColor(33), Position=POS(320,40), Size=SIZE(320,33), Align=FONTF_CENTER }

	local info
	if T.finished then
		info = "FINAL RESULT AFTER " .. T.total .. " EVENTS"
	elseif T.active then
		info = "AFTER " .. T.played .. " OF " .. T.total .. " EVENTS"
	else
		info = "NO TOURNAMENT"
	end
	StaticText { Title=L(info), Font=fontsmall(), Color=GetPaletteColor(34), Position=POS(320,86), Size=SIZE(400,16), Align=FONTF_CENTER }

	local list = ChloeCustomTourney_GetSortedStandings()
	if T.finished and list[1] ~= nil then
		local winner = WStringConcat(L"WINNER: ", EscapeString(KeyToName(list[1].key)))
		StaticText { Title=winner, Font=fontlarge(), Color=GetPaletteColor(33), Position=POS(320,104), Size=SIZE(400,20), Align=FONTF_CENTER }
	end

	-- two columns with 16 rows each
	local top = 132
	local rowh = 16
	for i, e in ipairs(list) do
		if i > 32 then
			break
		end
		local col = math.floor((i - 1) / 16)
		local row = math.mod(i - 1, 16)
		local x = 40 + col * 300
		local y = top + row * rowh
		local color = GetPaletteColor(34)
		if e.rank == 1 then
			color = GetPaletteColor(33)
		end
		local name = EscapeString(KeyToName(e.key))
		if e.ai then
			name = WStringConcat(name, L" (AI)")
		end
		local last = L""
		if e.last ~= nil then
			last = L("+" .. e.last)
		end
		StaticText { Title=L(e.rank .. "."), Font=fontsmall(), Color=color, Position=POS(x,y), Size=SIZE(24,rowh) }
		StaticText { Title=name, Font=fontsmall(), Color=color, Position=POS(x + 26,y), Size=SIZE(190,rowh) }
		StaticText { Title=L(e.points), Font=fontsmall(), Color=color, Position=POS(x + 240,y), Size=SIZE(30,rowh), Align=FONTF_RIGHT }
		StaticText { Title=last, Font=fontsmall(), Color=GetPaletteColor(34), Position=POS(x + 275,y), Size=SIZE(24,rowh), Align=FONTF_RIGHT }
	end

	self.items = { { ICON_MULTIPLAYER_CONTINUE, function() EnterMenu("menu_chloemultiplayer_lobby") end, ICON(self, "icon_continue"), ICON(self, "icon_continue_s") } }
	GUI:InitMenuButtons(self.items)
	GUI:SetActiveItem(1)
	GUI:ShowMenuButtons()
	GUI:SetHelpButtons(BUTTON_OK, UI_SELECT, BUTTON_BACK, UI_BACK)
end

function menu_chloecustom_tourney_standings.update(self, time)
	self.parent:update(self, time)
	if not ChloeNet_IsConnected() then
		ChloeCustomTourney_Reset()
		EnterMenu("menu_chloemultiplayer")
	end
end

function menu_chloecustom_tourney_standings.deinit(self)
	self.parent:deinit(self)
end

