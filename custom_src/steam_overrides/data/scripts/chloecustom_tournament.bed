local function UpdateInfo(newButton)
	local desc = TourneyIconDescs[newButton]
	if desc ~= nil then
		W("info1"):SetTitle(desc)
	else
		W("info1"):SetTitle(L"")
	end
end

local function SetValidPresets()
	local ttype = menu_chloecustom_buildtournament.type
	ValidPresets = { }
	for k,p in pairs(GetPresets()) do
		local add = false
		if ttype == GAMETYPE_TOURNAMENT_DERBY and (p.type == GAMETYPE_DERBY_FRAG or p.type == GAMETYPE_DERBY_LMS or p.type == GAMETYPE_DERBY_WRECKING or p.type == GAMETYPE_HUNTER_PREY) then
			add = true
		elseif ttype == GAMETYPE_TOURNAMENT_RACE and (p.type == GAMETYPE_PONGRACE or p.type == GAMETYPE_RACE) then
			add = true
		elseif ttype == GAMETYPE_TOURNAMENT then
			add = true
		elseif ttype == p.type then
			add = true
		end

		if add then
			local preset = { }
			preset.name = p.name
			preset.desc = p.desc
			preset.type = p.type
			preset.events = { }
			
			-- Copy events and set missing event parameters where needed
			for pk,e in pairs(p.events) do
				local event = { }
				for ek,ev in pairs(e) do
					event[ek] = ev
				end
				if event.rules == nil then
					event.rules = p.type
				end
				if event.lapsOrTimeLimit == nil and Levels[event.trackid].Laps ~= nil then
					event.lapsOrTimeLimit = Levels[event.trackid].Laps
				end
				local race = false
				local derby = false
				if event.rules == GAMETYPE_RACE or event.rules == GAMETYPE_PONGRACE then
					race = true
				elseif event.rules == GAMETYPE_DERBY_WRECKING or event.rules == GAMETYPE_DERBY_FRAG then
					derby = true
				end
				if event.tracktype == nil and (race or derby) then
					local level = Levels[event.trackid]
					event.tracktype = level.TrackType
				end
				table.insert(preset.events, event)
			end
			table.insert(ValidPresets, preset)
			
			-- Limit the number of presets to 8, because we only have 8 icons
			if table.getn(ValidPresets) == 8 then
				return
			end
		end
	end
end

local function InitEvents()
	for i = 1, 12 do
		TourneyEvents[i] = nil
	end
end

function ChloeCustomTourney_EnterBuilder(tournamenttype, okaction, backaction, editEvent, editTournament)
	menu_chloecustom_buildtournament.okaction = okaction
	local f = function()
		--backaction()
		if menu_chloecustom_buildtournament.editTournament and PresetSelection then
			PresetSelection = false
			RefreshEventGrid(menu_chloecustom_buildtournament, TourneyEvents)
			BuildMenuButtons()
			--UpdateInfo(1)
		else
			backaction()
		end
	end
	menu_chloecustom_buildtournament.backaction = f
	menu_chloecustom_buildtournament.type = tournamenttype
	menu_chloecustom_buildtournament.numplayers = ChloeNet_GetMaxPlayers()
	menu_chloecustom_buildtournament.partymode = false
	menu_chloecustom_buildtournament.editEvent = false
	menu_chloecustom_buildtournament.editTournament = editTournament
	
	SetValidPresets()

	InitEvents()
	
	-- ChloeCustom Tourney: start from the previous tournament
	if editTournament then
		for i, e in ipairs(ChloeCustomTourney.events) do
			if i <= 12 then
				local copy = { }
				for k, v in pairs(e) do
					copy[k] = v
				end
				TourneyEvents[i] = copy
			end
		end
	end
	EnterMenu("menu_chloecustom_buildtournament")
end

function ChloeCustomTourney_EnterBuilderAfterEdit(currentevent)
	CurrentEvent = currentevent
	menu_chloecustom_buildtournament.editEvent = true
	EnterMenu("menu_chloecustom_buildtournament")
	if menu_chloecustom_buildtournament.partymode and menu_chloecustom_buildtournament.partycar ~= nil then
		UpdateCarInfo(menu_chloecustom_buildtournament.partycar, menu_chloecustom_buildtournament, false, 1)
	end
end


local function ShowEventWindows(posanim)
	local startdelay = 0
	local delay = startdelay
	local num_windows=table.getn(state.eventwindows)

	for i=1,num_windows do
		local w=state.eventwindows[i]
		
		if posanim then
			w.image:SetAlpha(1)
			w.info:SetAlpha(1)
			local animstartpos = POS(640 - 290 + w.position[1], w.position[2])
			w.animhandle = AnimateWindowPos(w,animstartpos,w.position,0.3,delay,w.animhandle)
			
			if i == CurrentEvent then
				local hilite = W("highlight")
				if hilite then
					local pos = { hilite:GetPosition() }
					local animstartpos = POS(640 - 290 + pos[1], pos[2])
					hilite:SetPosition(animstartpos[1], animstartpos[2])
					hilite.animhandle = AnimateWindowPos(hilite, animstartpos, pos, 0.3, delay, hilite.animhandle)
				end
			end
		else
			w.image.animhandle = AnimateWindowAlpha(w.image,0.0,1.0,0.2,delay,w.image.animhandle)
			w.info.animhandle = AnimateWindowAlpha(w.info,0.0,1.0,0.2,delay,w.info.animhandle)
		end
		
		delay=delay+0.05
	end
end

local function HideEventWindows()
end

local TrackTypeOffsets = {
	[TRACKTYPE_FOREST] = LevelIndex.Forest1A - 1,
	[TRACKTYPE_FIELDS] = LevelIndex.Fields1A - 1,
	[TRACKTYPE_DESERT] = LevelIndex.Desert1A - 1,
	[TRACKTYPE_CANAL] = LevelIndex.Canal1A - 1,
	[TRACKTYPE_CITY] = LevelIndex.City1A - 1,
	[TRACKTYPE_RACING] = LevelIndex.Racing1A - 1,
}

local function GetTrackIndex(tracknum)
	local trackindex
	if tracknum >= LevelIndex.CURLING and tracknum <= LevelIndex.ROYALFLUSH then
		trackindex = tracknum - LevelIndex.CURLING + 1
	elseif tracknum >= LevelIndex.SKIJUMP and tracknum <= LevelIndex.SOCCER then
		trackindex = tracknum - LevelIndex.SKIJUMP + 1 + 6
	elseif tracknum >= LevelIndex.Arena1 and tracknum <= LevelIndex.Arena6 then
		trackindex = tracknum - LevelIndex.Arena1 + 1
	elseif tracknum >= LevelIndex.Derby1A and tracknum <= LevelIndex.Derby6A then
		trackindex = tracknum - LevelIndex.Derby1A + 1
	elseif tracknum >= LevelIndex.Nascar1A and tracknum <= LevelIndex.Nascar1C then
		trackindex = tracknum - LevelIndex.Nascar1A + 1
	else
		trackindex = tracknum - TrackTypeOffsets[Levels[tracknum].TrackType]
	end
	return trackindex
end

RefreshEventGrid = function(self, events, hidewindows)
	for i = 1, 12 do
		local event
		if events ~= nil then
			event = events[i]
		else
			event = nil
		end
		local iconwin = W("event_icon_"..i)
		if event == nil then
			local res = self:getResource("track_images1_empty_box")
			local ressize = wm.GetResourceSize(res)
			iconwin:AttachResource(res)
			iconwin:SetSize(ressize[1], ressize[2])
			iconwin:SetPosition(0, 0)
			W("event_info_"..i):SetTitle(L"")
		else
			local res = self:getResource(Levels[event.trackid].TrackIcon)
			local ressize = wm.GetResourceSize(res)
			iconwin:AttachResource(res)
			iconwin:SetSize(ressize[1], ressize[2])
			local boxsize = wm.GetResourceSize(self:getResource("track_images1_empty_box"))
			iconwin:SetPosition((boxsize[1] - ressize[1]) / 2 + 2, (boxsize[2] - ressize[2]) / 2 - 1)
			if event.rules == GAMETYPE_STUNT or event.rules == GAMETYPE_DERBY_LMS then
				W("event_info_"..i):SetTitle(L"")
			else
				W("event_info_"..i):SetTitle(L(event.lapsOrTimeLimit))
			end
		end
		if hidewindows then
			W("event_icon_"..i):SetAlpha(0)
			W("event_info_"..i):SetAlpha(0)
		end
	end
end

local EventVarNames =
{
	[GAMETYPE_RACE] = MULTIPLAYER_LAPS,
	[GAMETYPE_PONGRACE] = MULTIPLAYER_TURNS,
	[GAMETYPE_DERBY_FRAG] = MULTIPLAYER_ROUNDTIME,
	[GAMETYPE_HUNTER_PREY] = MULTIPLAYER_ROUNDTIME,
}

local function UpdateEventInfo(showAddEvent)
	local event = TourneyEvents[CurrentEvent]
	if event == nil then
		if showAddEvent then
			W("eventnum"):SetTitle(TRANSLATOR(UI_ADDEVENT))
		else
			W("eventnum"):SetTitle(L"")
		end
		W("eventtype"):SetTitle(L"")
		W("trackname"):SetTitle(L"")
		W("eventdetails"):SetTitle(L"")
		return
	end
	
	local eventnum = WStringConcat(MULTIPLAYER_EVENT, L(" "..CurrentEvent..":"))
	W("eventnum"):SetTitle(eventnum)
	W("eventtype"):SetTitle(GameModeNames[event.rules] or L"")
	
	--[[local title = WStringConcat(L"#33", eventnum)
	title = WStringConcat(title, L"#34")
	title = WStringConcat(title, GameModeNames[event.rules])
	W("info1"):SetTitle(title)--]]

	title=L""
	if event.rules == GAMETYPE_RACE then
		if event.tracktype==TRACKTYPE_REVERSED then
			title=WStringConcat(GetPhrase(TRANSLATOR(RACETRACKTYPE_REVERSED)), L" ")
		end
	end
	title = WStringConcat(title, L(Levels[event.trackid].Name))
	W("trackname"):SetTitle(title)

	local lapstxt = nil
	if event.rules == GAMETYPE_RACE or event.rules == GAMETYPE_PONGRACE then
		lapstxt = MULTIPLAYER_LAPS
	elseif event.rules == GAMETYPE_DERBY_WRECKING or event.rules == GAMETYPE_DERBY_FRAG then
		lapstxt = MULTIPLAYER_MINUTES
	end
	
	title = L""
	if lapstxt ~= nil then
		title = WStringConcat(L(event.lapsOrTimeLimit.." "), lapstxt)
	end
	W("eventdetails"):SetTitle(title)
end

local function UpdateHilitePos()
	local self = menu_chloecustom_buildtournament
	local x,y = W("event_icon_frame_"..CurrentEvent):GetPosition()
	local boxsize = wm.GetResourceSize(self:getResource("track_images1_empty_box"))
	local hlsize = wm.GetResourceSize(self:getResource("track_imagesl_selection_glow"))
	W("highlight"):SetPosition(x + (boxsize[1] - hlsize[1]) / 2, y + (boxsize[2] - hlsize[2]) / 2)
end

local function StartEditEvents(eventnum)
	GUI:HideMenuButtons()
	if eventnum ~= nil then
		CurrentEvent = eventnum
		CurRow = math.floor((CurrentEvent-1) / 3)
		CurCol = math.mod(CurrentEvent-1, 3)
	else
		CurRow = 0
		CurCol = 0
		CurrentEvent = 1
	end
	UpdateHilitePos()
	W("highlight"):ShowWindow()
	UpdateEventInfo(true)
	W("edit_handler"):SetFocus()
	
	W("textparent"):HideWindow()
	W("infobd"):ShowWindow()
	
	if TourneyEvents[CurrentEvent] == nil then
		GUI:SetHelpButtons(BUTTON_OK, TRANSLATOR(UI_ADDEVENT), BUTTON_BACK, TRANSLATOR(UI_BACK))
	else
		GUI:SetHelpButtons(BUTTON_OK, TRANSLATOR(UI_EDITEVENT), BUTTON_BACK, TRANSLATOR(UI_BACK), BUTTON_EXTRA, TRANSLATOR(UI_DELETE), BUTTON_XBOX_X, TRANSLATOR(UI_MOVEEVENT))
	end
	--GUI:SetHelpButtons(BUTTON_OK, UI_SELECT, BUTTON_BACK, UI_BACK, BUTTON_EXTRA, UI_DELETE, BUTTON_X, UI_MOVE)
end

local function CreateTournament()
	GUI:HideMenuButtons()
	-- Compact event table
	local evnum = 1
	for i = 1, 12 do
		if TourneyEvents[i] ~= nil then
			if evnum ~= i then
				TourneyEvents[evnum] = TourneyEvents[i]
				TourneyEvents[i] = nil
			end
			evnum = evnum + 1
		end
	end
	-- ChloeCustom Tourney: ask for the order of the events
	local events = { }
	for i = 1, 12 do
		if TourneyEvents[i] ~= nil then
			table.insert(events, TourneyEvents[i])
		end
	end
	MessageBox(L"PLAY THE EVENTS IN RANDOM ORDER?", MESSAGEBOX_YESNO, function(value)
		menu_chloecustom_buildtournament.okaction(events, value == TRUE)
	end)
end

local function SelectPreset(presetNum)
	W("textparent"):HideWindow()
	PresetSelection = false
	if presetNum ~= nil then
		TourneyEvents = ValidPresets[presetNum].events
	else
		TourneyEvents = { }
	end
	BuildMenuButtons()
	if presetNum == nil then
		-- Set "Edit queue" button as active when custom preset is selected
		GUI:SetActiveItem(2)
	end
	--W("title"):SetTitle(TRANSLATOR(MULTIPLAYER_TOURNAMENT_TITLE))
end

ShowPresets = function()
	PresetSelection = true
	menu_chloecustom_buildtournament.items = { }

	for i = 1, table.getn(ValidPresets) do
		table.insert(menu_chloecustom_buildtournament.items,
			{ WStringConcat(MULTIPLAYER_TOURNAMENT_ICON_PRESET, L(" "..i)), function() SelectPreset(i) end, ICON(menu_chloecustom_buildtournament,"icon_profile_"..i) } )
	end

	table.insert(menu_chloecustom_buildtournament.items,
		{ ICON_MULTIPLAYER_CUSTOM, function() SelectPreset(nil) end, ICON(menu_chloecustom_buildtournament,"icon_profile_x") } )

	GUI:InitMenuButtons(menu_chloecustom_buildtournament.items)
	GUI:SetActiveItem(1)
	GUI:ShowMenuButtons()

	RefreshEventGrid(menu_chloecustom_buildtournament, ValidPresets[1].events, true)
	ShowEventWindows()
	W("textparent"):ShowWindow()
	W("info1"):SetTitle(ValidPresets[1].desc)
	W("info1"):WordWrap()
end

BuildMenuButtons = function()
	menu_chloecustom_buildtournament.items = { }
	TourneyIconDescs = { }
	
	for i = 1, 12 do
		if TourneyEvents[i] ~= nil then
			if menu_chloecustom_buildtournament.partymode == true then
				iconLabel = INGAME_START_STUNT
				icon = "icon_go_race"
				iconDesc = nil
			else
				iconLabel = ICON_MULTIPLAYER_CONTINUE
				icon = "icon_continue"
				iconDesc = nil
			end
			table.insert(menu_chloecustom_buildtournament.items,
					{ iconLabel, function() CreateTournament() end, ICON(menu_chloecustom_buildtournament, icon), ICON(menu_chloecustom_buildtournament, icon.."_s") } )
--			table.insert(TourneyIconDescs, iconDesc)
			break
		end
	end

	if table.getn(ValidPresets) > 0 then
		table.insert(menu_chloecustom_buildtournament.items,
				{ ICON_PARTY_PRESETS, function() --[[W("title"):SetTitle(TRANSLATOR(TITLE_LIVE_PRESETS));--]] ShowPresets(); end, ICON(menu_chloecustom_buildtournament,"icon_presets") } )
--		table.insert(TourneyIconDescs, MULTIPLAYER_TOURNAMENT_PRESETS)
	end
	
	table.insert(menu_chloecustom_buildtournament.items,
			{ MULTIPLAYER_TOURNAMENT_ICON_CUSTOM, function() StartEditEvents() end, ICON(menu_chloecustom_buildtournament,"icon_profile_x") } )
--	table.insert(TourneyIconDescs, MULTIPLAYER_TOURNAMENT_CUSTOM)
	
	GUI:InitMenuButtons(menu_chloecustom_buildtournament.items)
	GUI:SetActiveItem(1)
	GUI:ShowMenuButtons()
end

function menu_chloecustom_buildtournament.create(self)
	self.parent:create(self)

	self:addResource("backdrops2.tga", backdrops2, backdrops2_size)
	self:addResource("garage_elements_2.tga", garage_elements_2, garage_elements_2_size)
	self:addResource("track_images.tga", track_images, track_images_size)
	self:addResource("game_mode_selector_ws.tga", game_mode_selector, game_mode_selector_size)
	self:addResource("cup_next_race_elements.tga", cup_next_race_elements, cup_next_race_elements_size)

	self:loadResources()
	
	self.items = { }
end

ShowPresetEvents = function(self, presetNum)
	local preset = ValidPresets[presetNum]
	for i = 1, 12 do
		local event
		if preset ~= nil then
			event = preset.events[i]
		else
			event = nil
		end
		local iconwin = W("event_icon_"..i)
		if event == nil then
			local res = self:getResource("track_images1_empty_box")
			local ressize = wm.GetResourceSize(res)
			iconwin:AttachResource(res)
			iconwin:SetSize(ressize[1], ressize[2])
			iconwin:SetPosition(0, 0)
			W("event_icon_"..i):AttachResource(self:getResource("track_images1_empty_box"))
			W("event_info_"..i):SetTitle(L"")
		else
			local res = self:getResource(Levels[event.trackid].TrackIcon)
			local ressize = wm.GetResourceSize(res)
			iconwin:AttachResource(res)
			iconwin:SetSize(ressize[1], ressize[2])
			iconwin:SetPosition(-1, -4.5)
			W("event_icon_"..i):AttachResource(self:getResource(Levels[event.trackid].TrackIcon))
			if event.rules == GAMETYPE_STUNT or event.rules == GAMETYPE_DERBY_LMS then
				W("event_info_"..i):SetTitle(L"")
			else
				W("event_info_"..i):SetTitle(L(event.lapsOrTimeLimit))
			end
		end
	end
	
	if preset ~= nil then
		W("info1"):SetTitle(preset.desc)
	else
		W("info1"):SetTitle(TRANSLATOR(MULTIPLAYER_TOURNAMENT_CUSTOMEVENTS))
	end
	W("info1"):WordWrap()
end

local function CreateEditRaceItems(self)
	local origPos
	
	-- "Edit events" inputhandler
	local handler = InputHandler { Name="edit_handler" }
	handler.onKeyPressed = function(Self, Character, VirtualKey, ScanCode)
		local prevSel = CurrentEvent
		if VirtualKey == KeyCodes["BUTTON_START"] then
			if menu_chloecustom_buildtournament.partymode then
				local okfunc = function(raceinfo)
					if raceinfo then
						TourneyEvents[CurrentEvent] = { trackid=raceinfo.Level, rules = GAMETYPE_STUNT }
					end
					ChloeCustomTourney_EnterBuilderAfterEdit(CurrentEvent)
				end
				local backfunc = function()
					ChloeCustomTourney_EnterBuilderAfterEdit(CurrentEvent)
				end
				EnterSingleRaceSelection(
					backfunc,	
					TRACKTYPE_STUNT,
					okfunc,
					nil
				)
			else
				if TourneyEvents[CurrentEvent] == nil then
					-- Add event
					EnterMultiplayerRaceSelection(
						menu_chloecustom_buildtournament.type,
						function(event)
							if event then
								TourneyEvents[CurrentEvent] = event
							end
							ChloeCustomTourney_EnterBuilderAfterEdit(CurrentEvent)
						end,
						function()
							ChloeCustomTourney_EnterBuilderAfterEdit(CurrentEvent)
						end,		
						menu_chloecustom_buildtournament.numplayers
					)
				else
					-- Edit event
					TourneyEvents[CurrentEvent].num = CurrentEvent
					EnterMultiplayerRaceEdit(
						menu_chloecustom_buildtournament.type,
						TourneyEvents[CurrentEvent],
						function(event)
							local eventnum = event.num
							event.num = nil
							TourneyEvents[eventnum] = event
							ChloeCustomTourney_EnterBuilderAfterEdit(eventnum)
						end,
						function(event)
							local eventnum = event.num
							event.num = nil
							ChloeCustomTourney_EnterBuilderAfterEdit(eventnum)
						end,
						menu_chloecustom_buildtournament.numplayers
					)
				end
			end
			playmenusound_action()
		elseif VirtualKey == KeyCodes["BUTTON_SELECT"] then
			BuildMenuButtons()
			GUI:ShowMenuButtons()
			--GUI:SetActiveItem(table.getn(self.items))
			W("highlight"):HideWindow()

			--W("textparent"):ShowWindow()
			W("infobd"):HideWindow()
			
			UpdateInfo(table.getn(self.items))
			W("info2"):SetTitle(L"")
			GUI:SetHelpButtons(BUTTON_OK, UI_SELECT, BUTTON_BACK, UI_BACK)
			playmenusound_back()
		elseif VirtualKey == KeyCodes["BUTTON_Y"] then
			if TourneyEvents[CurrentEvent] ~= nil then
				TourneyEvents[CurrentEvent] = nil
				RefreshEventGrid(self, TourneyEvents)
				UpdateEventInfo(true)
				GUI:SetHelpButtons(BUTTON_OK, TRANSLATOR(UI_ADDEVENT), BUTTON_BACK, TRANSLATOR(UI_BACK))
				playmenusound_action()
			end
		elseif VirtualKey == KeyCodes["BUTTON_X"] then
			if TourneyEvents[CurrentEvent] ~= nil then
				origPos = CurrentEvent
				local x,y = W("event_icon_frame_"..CurrentEvent):GetPosition()
				W("selected"):SetPosition(x - 4.5, y - 6.5)
				W("selected"):ShowWindow()
				W("move_handler"):SetFocus()
				GUI:SetHelpButtons(BUTTON_OK, TRANSLATOR(UI_MOVEEVENT), BUTTON_BACK, UI_BACK)
				playmenusound_action()
			end
		else
			local w = W("highlight")
			if w.animhandle == nil or not IsAnimationActive(w.animhandle) then
				if VirtualKey == KeyCodes["BUTTON_DOWN"] then
					CurRow = math.mod(CurRow + 1, 4)
					CurrentEvent = CurRow*3+CurCol+1
					UpdateEventInfo(true)
					playmenusound_move()
				elseif VirtualKey == KeyCodes["BUTTON_UP"] then
					CurRow = math.mod(CurRow - 1 + 4, 4)
					CurrentEvent = CurRow*3+CurCol+1
					UpdateEventInfo(true)
					playmenusound_move()
				elseif VirtualKey == KeyCodes["BUTTON_LEFT"] then
					local numevents = 12
					CurrentEvent = math.mod(CurrentEvent - 2 + numevents, numevents) + 1
					CurCol = math.mod(CurrentEvent - 1, 3)
					CurRow = math.floor((CurrentEvent - 1) / 3)
					UpdateEventInfo(true)
					playmenusound_move()
				elseif VirtualKey == KeyCodes["BUTTON_RIGHT"] then
					CurrentEvent = math.mod(CurrentEvent, 12) + 1
					CurCol = math.mod(CurrentEvent - 1, 3)
					CurRow = math.floor((CurrentEvent - 1) / 3)
					UpdateEventInfo(true)
					playmenusound_move()
				end
			end
		end
		
		if prevSel ~= CurrentEvent then
			if TourneyEvents[CurrentEvent] == nil and TourneyEvents[prevSel] ~= nil then
				GUI:SetHelpButtons(BUTTON_OK, TRANSLATOR(UI_ADDEVENT), BUTTON_BACK, TRANSLATOR(UI_BACK))
			elseif TourneyEvents[CurrentEvent] ~= nil and TourneyEvents[prevSel] == nil then
				GUI:SetHelpButtons(BUTTON_OK, TRANSLATOR(UI_EDITEVENT), BUTTON_BACK, TRANSLATOR(UI_BACK), BUTTON_EXTRA, TRANSLATOR(UI_DELETE), BUTTON_XBOX_X, TRANSLATOR(UI_MOVEEVENT))
			end
		end
		
		UpdateHilitePos()
	end

	local move_handler = InputHandler { Name="move_handler" }
	move_handler.onKeyPressed = function(Self, Character, VirtualKey, ScanCode)
		if VirtualKey == KeyCodes["BUTTON_START"] or VirtualKey == KeyCodes["BUTTON_X"] then
			local origEvent = TourneyEvents[origPos]
			TourneyEvents[origPos] = TourneyEvents[CurrentEvent]
			TourneyEvents[CurrentEvent] = origEvent
			UpdateEventInfo()
			RefreshEventGrid(self, TourneyEvents)
			W("selected"):HideWindow()
			W("edit_handler"):SetFocus()
			GUI:SetHelpButtons(BUTTON_OK, TRANSLATOR(UI_EDITEVENT), BUTTON_BACK, TRANSLATOR(UI_BACK), BUTTON_EXTRA, TRANSLATOR(UI_DELETE), BUTTON_XBOX_X, TRANSLATOR(UI_MOVEEVENT))
			playmenusound_action()
		elseif VirtualKey == KeyCodes["BUTTON_SELECT"] then
			W("selected"):HideWindow()
			W("edit_handler"):SetFocus()
			if TourneyEvents[CurrentEvent] == nil then
				UpdateEventInfo(true)
				GUI:SetHelpButtons(BUTTON_OK, TRANSLATOR(UI_ADDEVENT), BUTTON_BACK, TRANSLATOR(UI_BACK))
			else
				GUI:SetHelpButtons(BUTTON_OK, TRANSLATOR(UI_EDITEVENT), BUTTON_BACK, TRANSLATOR(UI_BACK), BUTTON_EXTRA, TRANSLATOR(UI_DELETE), BUTTON_XBOX_X, TRANSLATOR(UI_MOVEEVENT))
			end
			playmenusound_back()
		elseif VirtualKey == KeyCodes["BUTTON_DOWN"] then
			CurRow = math.mod(CurRow + 1, 4)
			CurrentEvent = CurRow*3+CurCol+1
			UpdateEventInfo()
			playmenusound_move()
		elseif VirtualKey == KeyCodes["BUTTON_UP"] then
			CurRow = math.mod(CurRow - 1 + 4, 4)
			CurrentEvent = CurRow*3+CurCol+1
			UpdateEventInfo()
			playmenusound_move()
		elseif VirtualKey == KeyCodes["BUTTON_LEFT"] then
			local numevents = 12
			CurrentEvent = math.mod(CurrentEvent - 2 + numevents, numevents) + 1
			CurCol = math.mod(CurrentEvent - 1, 3)
			CurRow = math.floor((CurrentEvent - 1) / 3)
			UpdateEventInfo()
			playmenusound_move()
		elseif VirtualKey == KeyCodes["BUTTON_RIGHT"] then
			CurrentEvent = math.mod(CurrentEvent, 12) + 1
			CurCol = math.mod(CurrentEvent - 1, 3)
			CurRow = math.floor((CurrentEvent - 1) / 3)
			UpdateEventInfo()
			playmenusound_move()
		end
		
		UpdateHilitePos()
	end	
end

function menu_chloecustom_buildtournament.init(self)
	self.parent:init(self)
	
	-- Title + backdrop
	Frame { Position=LEFTPOS(0,53), Size=SIZE(ChloeWidescreen_GetRight(),42) }:AttachResource(self:getResource("game_mode_main_bd"))
	local win = StaticText { Name="title", Position=POS(320,54), Size=SIZE(200,33), Font=fonttitle(), Color=GetPaletteColor(33), Align=FONTF_CENTER }
	win:SetTitle(MULTIPLAYER_TOURNAMENT_TITLE)

	-- Event grid backdrop
	local bd1 = Frame { Position=RIGHTPOS(290,99), Size=SIZE(84,204) }:AttachResource(self:getResource("party_mode_bd"))
	local bd2 = Frame { Position=RIGHTPOS(374,99), Size=SIZE(266,204) }:AttachResource(self:getResource("party_mode_bd_2"))

	bd1.handle = AnimateWindowPos(bd1, RIGHTPOS(640,99), { bd1:GetPosition() }, 0.3, 0.3, bd1.handle)
	bd2.handle = AnimateWindowPos(bd2, RIGHTPOS(640-290+374,99), { bd2:GetPosition() }, 0.3, 0.3, bd2.handle)

	-- Info window
	local textparent = Frame { Name="textparent", Position=POS(0,0), Size=SIZE(640,480) }
	Frame { Position=LEFTPOS(0, 309), Size=SIZE(ChloeWidescreen_GetRight(),42), Parent=textparent }:AttachResource(self:getResource("cup_title_bd"))
	FadingStaticText { Name="info1", Position=POS(320,313), Size=SIZE(500,24), Font=fontsmall(), Color=GetPaletteColor(34), Align=FONTF_CENTER, Parent=textparent }
	FadingStaticText { Name="info2", Position=POS(320,329), Size=SIZE(500,12), Font=fontsmall(), Color=GetPaletteColor(34), Align=FONTF_CENTER, Parent=textparent }
	
	-- Event info
	local tip
	local str
	if menu_chloecustom_buildtournament.partymode then
		tip = self:getResource("fo_total_reward_bd_tip")
		str = self:getResource("fo_total_reward_bd_str")
	else
		tip = self:getResource("ac_result_r_4_tip")
		str = self:getResource("ac_result_r_4_str")
	end
	
	local tipsize = GetResourceSize(tip)
	local strsize = SIZE(640 - 346 - tipsize[1], tipsize[2])

	local infobd = Frame { Name="infobd", Position=POS(0,0), Size=SIZE(640,480) }
	Frame { Position=RIGHTPOS(346,304), Size=tipsize, Parent=infobd }:AttachResource(tip)
	Frame { Position=RIGHTPOS(346 + tipsize[1],304), Size=strsize, Parent=infobd }:AttachResource(str)
	StaticText { Name="eventnum", Position=RIGHTPOS(485,304), Font=fontmedium(), Color=GetPaletteColor(33), Align=FONTF_CENTER, Parent=infobd }
	StaticText { Name="eventtype", Position=RIGHTPOS(485,329), Font=fontlarge(), Color=GetPaletteColor(33), Align=FONTF_CENTER, Parent=infobd }
	StaticText { Name="trackname", Position=RIGHTPOS(485,348), Font=fontsmall(), Color=GetPaletteColor(34), Align=FONTF_CENTER, Parent=infobd }
	local details = StaticText { Name="eventdetails", Position=RIGHTPOS(485,371), Font=fontsmall(), Color=GetPaletteColor(34), Align=FONTF_CENTER, Parent=infobd }
	
	if menu_chloecustom_buildtournament.partymode then
		details:HideWindow()
	end
	
	infobd:HideWindow()
	
	-- Races
	state.eventwindows = { }
	
	local imgsize = wm.GetResourceSize(self:getResource("track_images_forest1"))
	for i = 1, 12 do
		local rowNum = math.floor((i - 1) / 3)
		local pos = RIGHTPOS(306 + rowNum * 13, 111 + rowNum * 48)
		local x = pos[1] + 78 * math.mod(i - 1, 3)
		local w = Frame { Name="event_icon_frame_"..i, Position=POS(x,pos[2]), Size=imgsize }
		w.position = POS(x, pos[2])--pos

		local imageframe = Frame { Name="event_icon_"..i, Position=POS(0,0), Parent=w }
		
		w.info = StaticText { Name="event_info_"..i, Position=POS(68,16), Size=SIZE(20,20), Font=fontmedium(), Color=GetPaletteColor(1), Align=FONTF_RIGHT, Parent=w }

		if TourneyEvents[i] then
			w.image = imageframe:AttachResource(self:getResource(Levels[TourneyEvents[i].trackid].TrackIcon))
			imageframe:SetSize(imgsize[1], imgsize[2])
			local boxsize = wm.GetResourceSize(self:getResource("track_images1_empty_box"))
			imageframe:SetPosition((boxsize[1] - imgsize[1]) / 2 + 2, (boxsize[2] - imgsize[2]) / 2 - 1)
			w.image:SetAlpha(0)
			if TourneyEvents[i].rules ~= GAMETYPE_STUNT and TourneyEvents[i].rules ~= GAMETYPE_DERBY_LMS then
				w.info:SetTitle(L(TourneyEvents[i].lapsOrTimeLimit))
			end
		else
			local size = wm.GetResourceSize(self:getResource("track_images1_empty_box"))
			imageframe:SetSize(size[1], size[2])
			imageframe:SetPosition(0, 0)
			w.image = imageframe:AttachResource(self:getResource("track_images1_empty_box"))
			w.image:SetAlpha(0)
		end

		table.insert(state.eventwindows,w)
	end

	imgsize = wm.GetResourceSize(self:getResource("track_imagesl_selection_glow"))
	local hilite = Frame { Name="highlight", Position=POS(0,0), Size=imgsize, Layer=5 }:AttachResource(self:getResource("track_imagesl_selection_glow"))
	hilite:HideWindow()

	local selected = Frame { Name="selected", Position=POS(0,0), Size=imgsize, Layer=5 }:AttachResource(self:getResource("track_imagesl_selection_glow"))
	--selected:SetAlpha(0.6)
	selected:HideWindow()

	CreateEditRaceItems(self)

	PresetSelection = false
	
	if menu_chloecustom_buildtournament.editEvent then
		menu_chloecustom_buildtournament.editEvent = false
		StartEditEvents(CurrentEvent)
		ShowEventWindows(true)
	else
		if menu_chloecustom_buildtournament.editTournament then
			BuildMenuButtons()
			ShowEventWindows(true)
		elseif table.getn(ValidPresets) > 0 then
			--W("title"):SetTitle(TRANSLATOR(TITLE_LIVE_PRESETS))
			ShowPresets()
		else
			--W("title"):SetTitle(TRANSLATOR(MULTIPLAYER_TOURNAMENT_TITLE))
			BuildMenuButtons()
			ShowEventWindows(true)
		end
	end
end

function menu_chloecustom_buildtournament.buttonChange(self, oldButton, newButton)
	if PresetSelection then
		if newButton < table.getn(menu_chloecustom_buildtournament.items) then
			RefreshEventGrid(self, ValidPresets[newButton].events, true)
		else
			RefreshEventGrid(self, nil, true)
		end
		if ValidPresets[newButton] ~= nil then
			W("info1"):SetTitle(ValidPresets[newButton].desc)
		else
			W("info1"):SetTitle(TRANSLATOR(MULTIPLAYER_TOURNAMENT_CUSTOMEVENTS))
		end
		W("info1"):WordWrap()
		local posanim = false
		if oldButton == 0 then
			posanim = true
		end
		ShowEventWindows(posanim)
	else
		UpdateInfo(newButton)
	end
end

function menu_chloecustom_buildtournament.update(self,time)
	self.parent:update(self,time)
	
	local alpha = 1 - 0.20 + math.sin(time * 6) * 0.20
	W("highlight"):SetAlpha(alpha)
end

function menu_chloecustom_buildtournament.deinit(self)
	self.parent:deinit(self)
end

function menu_chloecustom_buildtournament.startshow(self)
	self.parent:startshow(self)

	--ShowEventWindows()
end

function menu_chloecustom_buildtournament.starthide(self)
	self.parent:starthide(self)

	HideEventWindows()
end
