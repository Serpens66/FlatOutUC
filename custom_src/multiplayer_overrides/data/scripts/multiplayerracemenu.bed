local GameType = 1
local GameMode = 2
local TrackType = 3
local Track = 4
local Laps = 5
local Weather = 6

local Label=1
local ItemLabels=2
local ItemValues=3
local SelectedItem=4
local Enabled=5
local OnChanged=6
local Descriptions=7
local Hidden = 8

local NumOptions = 6

local function GetEnabled(Items, RowNr)
	return Items[RowNr][Enabled]
end

local function SetEnabled(Items, RowNr, Enable)
	Items[RowNr][Enabled]=Enable
	if Enable then
		Items[RowNr][Hidden]=false
	end
end

local function SetHidden(Items, RowNr, Hide)
	Items[RowNr][Hidden] = Hide
	if Hide then
		Items[RowNr][Enabled] = false
	end	
end

local function GetHidden(Items, RowNr)
	return Items[RowNr][Hidden]
end

local function GetSelectedItem(Items, RowNr)
	return Items[RowNr][SelectedItem]
end

local function SetSelectedItem(Items, RowNr, Item)
	Items[RowNr][SelectedItem]=Item
end

local function SetSelectedItemByValue(Items, RowNr, Value)
	for i,j in ipairs(Items[RowNr][ItemValues]) do
		if j==Value then
			SetSelectedItem(Items, RowNr, i)
			break
		end
	end
end

local function GetSelectedItemValue(Items, rowNr)
	return Items[rowNr][ItemValues][Items[rowNr][SelectedItem] ]
end

local function GetSelectedItemLabel(Items, rowNr)
	return Items[rowNr][ItemLabels][Items[rowNr][SelectedItem] ]
end

local function GetNumItems(Items, RowNr)
	return table.getn(Items[RowNr][ItemValues])
end

local function GetRealRowNr(RowNr)
	local realRowNr=nil
	local currentRow=0
	for i=1, table.getn(Options) do
		if GetHidden(Options, i) ~= true then
			currentRow = currentRow + 1
			if currentRow == RowNr then
				realRowNr = i
				break
			end
		end
	end
	return realRowNr
end

local function GetRealNumRows()
	local currentRow=0
	for i=1, table.getn(Options) do
		if GetHidden(Options, i) ~= true then
			currentRow = currentRow + 1
		end
	end
	return currentRow
end

local function SetWeatherOptions()
	if OnlineWeatherDisabled() or GetSelectedItemValue(Options, GameType) == GAMETYPE_STUNT or type(Levels[ValidTracks[SelectedTrack]].Weathers) ~= "table" then
		Options[Weather] = {
			L"",
			{nil},
			{0},
			1,
			false,
			nil,
			nil,
			true
		}
	else
		local labels = { }
		local values = { }
		local weathers = Levels[ValidTracks[SelectedTrack]].Weathers
		table.insert(labels, MULTIPLAYER_ANY)
		table.insert(values, 0)
		for i,v in ipairs(weathers) do
			table.insert(labels, WeatherLabels[v])
			table.insert(values, i)
		end
		Options[Weather] = {
			TRANSLATOR(TRACKOPTIONS_TIMEOFDAY),
			labels,
			values,
			1,
			true,
			nil,
			nil,
			false
		}
	end
end

OnGameTypeChanged = function()
	Options[GameMode]=GameModes[ GetSelectedItem(Options, GameType) ]
	--SetSelectedItem(Options, GameMode, 1)
	local gameType = GetSelectedItemValue(Options, GameType)
	if gameType == GAMETYPE_TOURNAMENT_RACE then -- Race
		SetHidden(Options, GameMode, false)
		Options[TrackType] = TrackTypeRaces
		--SetSelectedItem(Options, TrackType, 1)
		Options[Laps] = LapsOption
		Options[Laps][Label] = MULTIPLAYER_LAPS
		OnTrackTypeChanged()
	elseif gameType == GAMETYPE_TOURNAMENT_DERBY then -- Derby
		SetHidden(Options, GameMode, false)
		Options[TrackType] = TrackTypeDerby
		--SetSelectedItem(Options, TrackType, 1)
		Options[Laps] = TimeLimitDerbyOption
		Options[Laps][Label] = MULTIPLAYER_MINUTES
		OnTrackTypeChanged()
	elseif gameType == GAMETYPE_STUNT then -- Stunt
		Options[TrackType] = TrackTypeStunt
		Options[Laps] = EmptyLapsOption
		SetHidden(Options, GameMode, true)
		ValidTracks = { }
		SelectedTrack = 1
		for i,l in ipairs(Levels) do
			if l and l.TrackType == TRACKTYPE_STUNT and not l.ChloeCustomHidden then -- ChloeCustom
				table.insert(ValidTracks, i)
			end
		end
		SetWeatherOptions()
	end
	OnGameModeChanged()
end

OnGameModeChanged = function()
	local gameMode = GetSelectedItemValue(Options, GameMode)
	if gameMode == GAMETYPE_RACE then
		Options[Laps] = LapsOption
		SetSelectedItem(Options, Laps, 4)
		Options[TrackType] = TrackTypeRaces
		OnTrackTypeChanged()
	elseif gameMode == GAMETYPE_PONGRACE then
		Options[Laps] = TurnsOption
		SetSelectedItem(Options, Laps, 3)
		Options[TrackType] = TrackTypePong
		OnTrackTypeChanged()
	elseif gameMode == GAMETYPE_ARCADE_RACE then
		Options[Laps] = EmptyLapsOption
		Options[TrackType] = TrackTypeArcadeRace
		OnTrackTypeChanged()
	elseif gameMode == GAMETYPE_TONYHAWK then
		Options[Laps] = TimeLimitDerbyOption
		Options[Laps][Label] = MULTIPLAYER_MINUTES
		Options[TrackType] = TrackTypeTonyHawk
		OnTrackTypeChanged()
	elseif gameMode == GAMETYPE_SPEEDTRAP then
		Options[Laps] = LapsOption
		SetSelectedItem(Options, Laps, 4)
		Options[TrackType] = TrackTypeSpeedtrap
		OnTrackTypeChanged()
	elseif gameMode == GAMETYPE_DRIFT then
		Options[Laps] = TimeLimitDerbyOption
		Options[Laps][Label] = MULTIPLAYER_MINUTES
		Options[TrackType] = TrackTypeRaces
		OnTrackTypeChanged()
	elseif gameMode == GAMETYPE_LAPKNOCKOUT then
		Options[Laps] = TurnsOption
		SetSelectedItem(Options, Laps, 3)
		Options[TrackType] = TrackTypeRaces
		OnTrackTypeChanged()
	elseif gameMode == GAMETYPE_KNOCKOUT then
		Options[Laps] = EmptyLapsOption
		Options[TrackType] = TrackTypeRaces
		OnTrackTypeChanged()
	elseif gameMode == GAMETYPE_BEAT_THE_BOMB then
		Options[Laps] = EmptyLapsOption
		Options[TrackType] = TrackTypeBeatTheBomb
		OnTrackTypeChanged()
	end
end

local Label=1
local ItemLabels=2
local ItemValues=3
local SelectedItem=4
local Enabled=5
local OnChanged=6
local Descriptions=7
local Hidden = 8

OnTrackTypeChanged = function()
	local tt = GetSelectedItemValue(Options, TrackType)
	ValidTracks = { }
	SelectedTrack = 1
	
	if tt==TRACKTYPE_REVERSED then
		for i,l in ipairs(Levels) do
			if l.TrackType and not l.ChloeCustomHidden and l.AllowReversed and not ChloeCollection_IsTrackLockedByCheatCode(i) then
				table.insert(ValidTracks, i)
			end
		end
	elseif tt==TRACKTYPE_ARCADERACE then
		for i,l in ipairs(Levels) do
			if l.TrackType and not l.ChloeCustomHidden and l.AllowArcadeRace and not ChloeCollection_IsTrackLockedByCheatCode(i) then
				table.insert(ValidTracks, i)
			end
		end
	elseif tt==TRACKTYPE_TONYHAWK then
		for i,l in ipairs(Levels) do
			if l.TrackType and not l.ChloeCustomHidden and l.AllowTonyHawk and not ChloeCollection_IsTrackLockedByCheatCode(i) then
				table.insert(ValidTracks, i)
			end
		end
	elseif tt==TRACKTYPE_SPEEDTRAP then
		for i,l in ipairs(Levels) do
			if l.TrackType and not l.ChloeCustomHidden and l.AllowSpeedtrap and not ChloeCollection_IsTrackLockedByCheatCode(i) then
				table.insert(ValidTracks, i)
			end
		end
	elseif tt==TRACKTYPE_BEATTHEBOMB then
		for i,l in ipairs(Levels) do
			if l.TrackType and not l.ChloeCustomHidden and l.AllowBeatTheBomb and not ChloeCollection_IsTrackLockedByCheatCode(i) then
				table.insert(ValidTracks, i)
			end
		end
	else
		for i,l in ipairs(Levels) do
			if l.TrackType and not l.ChloeCustomHidden and l.TrackType == tt and not ChloeCollection_IsTrackLockedByCheatCode(i) then
				table.insert(ValidTracks, i)
			end
		end
	end
	
	SetWeatherOptions()
end

local function UpdateArrows(self)
	local row = SelectedRow
	
	local leftArrowSize = wm.GetResourceSize(self:getResource("ingame_options_arrow_left_glow"))
	local rightArrowSize = wm.GetResourceSize(self:getResource("ingame_options_arrow_right_glow"))

	local value = wm.GetWindow("optionvalue_row"..row)
	local xpos,ypos = value:GetPosition()
	self.leftarrow:SetPosition(xpos - 5 - leftArrowSize[1], ypos)

	local w,_ = wm.GetTextExtents(value:GetTitle(), fontextratiny())
	self.rightarrow:SetPosition(xpos + w + 9, ypos)
end

local function RefreshInfo(self)
	-- Update option label & value titles
	local track_type=GetSelectedItemValue(Options, TrackType)
	for i = 1, GetRealNumRows() do
		local realRowNr = GetRealRowNr(i)
		local labelwin = wm.GetWindow("optionlabel_row"..i)
		labelwin:SetTitle(Options[realRowNr][Label])
		
		local valuewin = wm.GetWindow("optionvalue_row"..i)
		local value = nil
		if realRowNr == Track then
			value = L(Levels[ValidTracks[SelectedTrack]].Name)
		else
			value = GetSelectedItemLabel(Options, realRowNr)
		end

		if value ~= nil then
			valuewin:SetTitle(value)
		else
			valuewin:SetTitle(L"")
		end
		
		local color
		if i == SelectedRow then
			color = GetPaletteColor(33)
		else
			color = GetPaletteColor(1)
		end
		valuewin:SetColor(color, false)
		
		if Options[realRowNr][Enabled] then
			labelwin:SetLayer(4)
			valuewin:SetLayer(4)
			labelwin:ShowWindow()
			valuewin:ShowWindow()
		else
			labelwin:SetLayer(2)
			valuewin:SetLayer(2)
			labelwin:ShowWindow()
			valuewin:ShowWindow()
		end
	end
	
	for i = GetRealNumRows() + 1, NumOptions do
		local labelwin = wm.GetWindow("optionlabel_row"..i)
		local valuewin = wm.GetWindow("optionvalue_row"..i)
		labelwin:HideWindow()
		valuewin:HideWindow()

		W("hilite_tip_row"..i):AttachResource(self:getResource("track_options_bd_black_1"))
		W("hilite_str_row"..i):AttachResource(self:getResource("track_options_bd_black_2"))
	end

	-- Update track name & image
	if SelectedTrack then
		local leveldata = Levels[ValidTracks[SelectedTrack]]

		local trackname=L""
		if track_type and track_type==TRACKTYPE_REVERSED then
			trackname = WStringConcat(GetPhrase(TRANSLATOR(RACETRACKTYPE_REVERSED)), L" ")
		end
		trackname = WStringConcat(trackname, L(leveldata.Name))

		W("trackname"):SetTitle(trackname)
		W("trackimage"):AttachResource(self:getResource(leveldata.TrackImage))

		--[[local tracktype
		local gametype = GetSelectedItemValue(Options, GameType)
		if gametype == GAMETYPE_TOURNAMENT_RACE or gametype == GAMETYPE_TOURNAMENT_DERBY then
			tracktype = GetSelectedItemValue(Options, TrackType)
		elseif gametype == GAMETYPE_STUNT then
			tracktype = TRACKTYPE_STUNT
		end

		W("trackimage"):AttachResource(self:getResource(TrackTypeImages[tracktype]))--]]
	end

	if GetRealRowNr(SelectedRow) == Track then
		if SelectedTrack then
			local leveldata = Levels[ValidTracks[SelectedTrack]]
			local desc = W("infotext")
			
			local trackDesc = TRANSLATOR(leveldata.Description)
			if (trackDesc == 65535) then
				trackDesc = L(leveldata.Description)
			end
			desc:SetTitle(trackDesc)
			desc:WordWrap()
		end
	else
		local descs = Options[GetRealRowNr(SelectedRow)][Descriptions]
		local desc
		if descs ~= nil then
			if type(descs) == "table" then
				desc = descs[GetSelectedItem(Options, GetRealRowNr(SelectedRow))]
			else
				desc = descs
			end
		end
		
		local infotext = wm.GetWindow("infotext")
		if desc then
			infotext:SetTitle(desc)
			infotext:WordWrap()
		else
			infotext:SetTitle(L"")
		end
	end
end

local function SelectRow(self, prevSel, SelectedRow)
	if prevSel ~= nil then
		W("hilite_tip_row"..prevSel):AttachResource(self:getResource("track_options_bd_black_1"))
		W("hilite_str_row"..prevSel):AttachResource(self:getResource("track_options_bd_black_2"))
	end
	if SelectedRow ~= nil then
		W("hilite_tip_row"..SelectedRow):AttachResource(self:getResource("track_options_bd_white_1"))
		W("hilite_str_row"..SelectedRow):AttachResource(self:getResource("track_options_bd_white_2"))
	end
end

function menu_multiplayer_trackselection.init(self)
	self.parent:init(self)

	-- Title + backdrop
	Frame { Position=LEFTPOS(0,64), Size=SIZE(ChloeWidescreen_GetRight(),42) }:AttachResource(self:getResource("game_mode_main_bd"))
	StaticText { Name="trackname", Title=L"", Position=POS(320,63), Font=fonttitle(), Color=GetPaletteColor(33), Align=FONTF_CENTER }

	-- Mid backdrop + track image
	Frame { Position=LEFTPOS(0,110), Size=SIZE(ChloeWidescreen_GetRight(),128) }:AttachResource(self:getResource("game_mode_main_bd_2"))
	Frame { Name="trackimage", Position=POS(64,118), Size=SIZE(512,112) }
	
	-- Bottom backdrops
	Frame{Position=LEFTPOS(0,244),Size=SIZE(292-ChloeWidescreen_GetLeft(),128),Layer=2}:AttachResource(self:getResource("game_mode_bd_str"))
	Frame{Position=POS(292,244),Size=SIZE(67,128),Layer=2}:AttachResource(self:getResource("game_mode_bd_tips"))
	Frame{Position=POS(359,244),Size=SIZE(ChloeWidescreen_GetRight()-359,128),Layer=2}:AttachResource(self:getResource("game_mode_bd_str"))
	
	-- Labels
	StaticText { Title=MULTIPLAYER_DESCRIPTION, Position=POS(177,244), Size=SIZE(200,16), Font=fontmedium(), Color=GetPaletteColor(33), Align=FONTF_CENTER }
	StaticText { Title=MULTIPLAYER_TRACKOPTIONS, Position=POS(474,244), Size=SIZE(200,16), Font=fontmedium(), Color=GetPaletteColor(33), Align=FONTF_CENTER }

	FadingStaticText { Name="infotext", Position=POS(175,273), Size=SIZE(272,48), Font=fontextratiny(), Color=GetPaletteColor(34), Align=FONTF_CENTER }
	
	if not XBOX then
		Options[GameType][Descriptions] = {PS2ONLINE_GAMETYPE_RACE_DESCRIPTION, PS2ONLINE_GAMETYPE_STUNT_DESCRIPTION, PS2ONLINE_GAMETYPE_DERBY_DESCRIPTION }
	end
	
	local x = 330
	local y = 272
	for i = 1, NumOptions do
		Frame { Name="hilite_tip_row"..i, Position=POS(x,y), Size=SIZE(14,14), Layer=3 }:AttachResource(self:getResource("track_options_bd_black_1"))
		Frame { Name="hilite_str_row"..i, Position=POS(x+14,y), Size=SIZE(ChloeWidescreen_GetRight(),14), Layer=3 }:AttachResource(self:getResource("track_options_bd_black_2"))
		
		local labelWin = StaticText { Name="optionlabel_row"..i, Position=POS(454,y-1), Size=SIZE(200,12), Font=fontextratiny(), Color=GetPaletteColor(33), Align=FONTF_RIGHT }
		local valueWin = StaticText { Name="optionvalue_row"..i, Position=POS(484,y-1), Size=SIZE(200,12), Font=fontextratiny(), Color=GetPaletteColor(1) }
		if not GetHidden(Options, i) then
			labelWin:SetTitle(Options[i][Label])
		end

		y = y + 16
		x = x + 4
	end

	self.leftarrow = CreateArrow(self, "leftarrow", "ingame_options_arrow_left")
	self.rightarrow = CreateArrow(self, "rightarrow", "ingame_options_arrow_right")

	if not mprace_edit then
		-- "Add race"
		local gametype
		if mprace_rules == GAMETYPE_TOURNAMENT then
			gametype = GAMETYPE_TOURNAMENT_RACE
		else
			gametype = mprace_rules
		end
		SetSelectedItemByValue(Options, GameType, gametype)
		OnGameTypeChanged()
		Options[GameType][Enabled] = (mprace_rules == GAMETYPE_TOURNAMENT)
	else
		-- "Edit event"
		local etype
		local race = false
		local derby = false
		local gametype
		local tracktype
		
		etype = mprace_event.rules
		tracktype = mprace_event.tracktype
		if etype == GAMETYPE_TOURNAMENT_RACE or etype == GAMETYPE_RACE or etype == GAMETYPE_PONGRACE or etype == GAMETYPE_ARCADE_RACE or etype == GAMETYPE_TONYHAWK or etype == GAMETYPE_DRIFT or etype == GAMETYPE_KNOCKOUT or etype == GAMETYPE_LAPKNOCKOUT or etype == GAMETYPE_SPEEDTRAP or etype == GAMETYPE_BEAT_THE_BOMB then
			race = true
		elseif etype == GAMETYPE_TOURNAMENT_DERBY or etype == GAMETYPE_DERBY_WRECKING or etype == GAMETYPE_DERBY_FRAG or etype == GAMETYPE_DERBY_LMS then
			derby = true
		end

		if race then
			gametype = GAMETYPE_TOURNAMENT_RACE
		elseif derby then
			gametype = GAMETYPE_TOURNAMENT_DERBY
		else
			gametype = GAMETYPE_STUNT
		end
	
		SetSelectedItemByValue(Options, GameType, gametype)
		OnGameTypeChanged() -- Updates game mode & track type settings

		if mprace_rules == GAMETYPE_TOURNAMENT then
			Options[GameType][Enabled] = true
		else
			Options[GameType][Enabled] = false
		end
		
		SetSelectedItemByValue(Options, GameMode, etype)
		OnGameModeChanged()
		SetSelectedItemByValue(Options, TrackType, tracktype)
		OnTrackTypeChanged()
		
		if race or derby then
			for i = 1, table.getn(Options[Laps][ItemValues]) do
				if Options[Laps][ItemValues][i] == mprace_event.lapsOrTimeLimit then
					SetSelectedItem(Options, Laps, i)
					break
				end
			end
		end
		
		for i,v in ipairs(ValidTracks) do
			if mprace_event.trackid == v then
				SelectedTrack = i
				break
			end
		end
		if mprace_event.weather==nil then
			mprace_event.weather=0
		end
		SetWeatherOptions()
		OUTPUTDEBUGSTRING("weather "..mprace_event.weather)
		SetSelectedItemByValue(Options, Weather, mprace_event.weather)
	end

	local row = 1
	SelectedRow = 1
	while Options[row][Enabled] == false do
		if not Options[row][Hidden] then
			SelectedRow = SelectedRow + 1
		end
		row = row + 1
	end

	RefreshInfo(self)
	UpdateArrows(self)
	
	local flashLeftArrow = false
	local flashRightArrow = false
	local handler = InputHandler { Name="handler" }
	handler.onKeyPressed = function(Self, Character, VirtualKey, ScanCode)
		if VirtualKey == KeyCodes["BUTTON_START"] then
			local mode = GetSelectedItemValue(Options, GameMode)
	
			local event = {
				rules = mode,
				trackid = ValidTracks[SelectedTrack],
				lapsOrTimeLimit = GetSelectedItemValue(Options, Laps),
				tracktype = GetSelectedItemValue(Options, TrackType),
			}
			
			if type(Levels[ValidTracks[SelectedTrack]].Weathers) == "table" then
				event.weather = GetSelectedItemValue(Options, Weather)
			else
				event.weather = 0			
			end
			
			
			if mprace_edit then
				event.num = mprace_event.num
			end
			
			playmenusound_action()
			
			mprace_ok(event)
		elseif VirtualKey == KeyCodes["BUTTON_SELECT"] then
			playmenusound_back()
			mprace_back(mprace_event)
		elseif VirtualKey == KeyCodes["BUTTON_LEFT"] then
			playmenusound_move()
			local oldsel = nil
			local realRowNr = GetRealRowNr(SelectedRow)
			if realRowNr == Track then
				local numtracks = table.getn(ValidTracks)
				oldsel = SelectedTrack
				SelectedTrack = math.mod(SelectedTrack - 2 + numtracks, numtracks) + 1
				SetWeatherOptions()
			else
				local selectedItem = GetSelectedItem(Options, realRowNr) - 1
				local numItems = GetNumItems(Options, realRowNr)
				if selectedItem < 1 then
					selectedItem = numItems
				end
				SetSelectedItem(Options, realRowNr, selectedItem)
			end
			if Options[realRowNr][OnChanged] then
				Options[realRowNr][OnChanged]()
			end
			RefreshInfo(self)
			UpdateArrows(self)
			self.leftarrow:Flash(-1)
		elseif VirtualKey == KeyCodes["BUTTON_RIGHT"] then
			playmenusound_move()
			local oldsel = nil
			local realRowNr = GetRealRowNr(SelectedRow)
			if realRowNr == Track then
				SelectedTrack = math.mod(SelectedTrack, table.getn(ValidTracks)) + 1
				SetWeatherOptions()
			else
				local selectedItem = GetSelectedItem(Options, realRowNr) + 1
				local numItems = GetNumItems(Options, realRowNr)
				if selectedItem > numItems then
					selectedItem = 1
				end
				SetSelectedItem(Options, realRowNr, selectedItem)
			end
			if Options[realRowNr][OnChanged] then
				Options[realRowNr][OnChanged]()
			end
			RefreshInfo(self)
			UpdateArrows(self)
			self.rightarrow:Flash(1)
		elseif VirtualKey == KeyCodes["BUTTON_DOWN"] then
			self.leftarrow:StopFlash()
			self.rightarrow:StopFlash()
			playmenusound_move()
			local prevsel = SelectedRow
			local numoptions = GetRealNumRows()
			local row = SelectedRow
			local realrow
			repeat
				row = row + 1
				if row == numoptions + 1 then
					row = 1
				end
				realrow = GetRealRowNr(row)
			until Options[realrow][Enabled] == true
			SelectedRow = row
			if SelectedRow ~= prevsel then
				SelectRow(self, prevsel, SelectedRow)
				RefreshInfo(self)
				UpdateArrows(self)
			end
		elseif VirtualKey == KeyCodes["BUTTON_UP"] then
			self.leftarrow:StopFlash()
			self.rightarrow:StopFlash()
			playmenusound_move()
			local prevsel = SelectedRow
			local numoptions = GetRealNumRows()
			local row = SelectedRow
			local realrow
			repeat
				row = row - 1
				if row == 0 then
					row = numoptions
				end
				realrow = GetRealRowNr(row)
			until Options[realrow][Enabled] == true
			SelectedRow = row
			if SelectedRow ~= prevsel then
				SelectRow(self, prevsel, SelectedRow)
				RefreshInfo(self)
				UpdateArrows(self)
			end
		end
	end
	
	SelectRow(self, nil, SelectedRow)
	
	GUI:SetHelpButtons(BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))
end

function menu_multiplayer_trackselection.deinit(self)
	self.parent:deinit(self)
end

function menu_multiplayer_trackselection.update(self,time)
	self.parent:update(self,time)

	self.leftarrow:AnimateAlpha(time)
	self.rightarrow:AnimateAlpha(time)
end

end --//USE_NETWORK