-- OptionItem item indexes
local Label=1
local ItemLabels=2
local ItemValues=3
local SelectedItem=4
local Enabled=5
local OnChanged=6
local Descriptions=7
local Hidden=8

-- OptionItem indexes
local CarType=1
local PropCars=2
local DamageLevel=3
local HandlingDamage=4
local Upgrades=5
local NitroRegen=6
local NitroRegenType=7
local HandlingMode=8
local SpeedLimit=9
local DisableProps=10
local GhostMode=11
local AICount=12
local AIClass=13
local AIDriverSlot=14 -- ChloeCustom
local AIDriverName=15

local NumOptions=14 -- ChloeCustom: AI COUNT is replaced by AI SLOT + AI DRIVER

local function GetEnabled(RowNr)
	return OptionItems[RowNr][Enabled]
end

local function SetEnabled(RowNr, Enable)
	OptionItems[RowNr][Enabled]=Enable
	if Enable then
		OptionItems[RowNr][Hidden]=false
	end
end

local function SetHidden(RowNr, Hide)
	OptionItems[RowNr][Hidden] = Hide
	if Hide then
		OptionItems[RowNr][Enabled] = false
	end	
end

local function GetHidden(RowNr)
	return OptionItems[RowNr][Hidden]
end

local function GetSelectedItem(RowNr)
	return OptionItems[RowNr][SelectedItem]
end

local function SetSelectedItem(RowNr, Item)
	OptionItems[RowNr][SelectedItem]=Item
end

local function SetSelectedItemByValue(RowNr, Value)
	for i,j in ipairs(OptionItems[RowNr][ItemValues]) do
		if j == Value then
			SetSelectedItem(RowNr, i)
			break
		end
	end
end

local function GetSelectedItemValue(rowNr)
	return OptionItems[rowNr][ItemValues][OptionItems[rowNr][SelectedItem] ]
end

local function GetSelectedItemLabel(rowNr)
	return OptionItems[rowNr][ItemLabels][OptionItems[rowNr][SelectedItem] ]
end

local function GetNumItems(RowNr)
	return table.getn(OptionItems[RowNr][ItemValues])
end

local function GetRealRowNr(RowNr)
	local realRowNr=nil
	local currentRow=0
	for i=1, table.getn(OptionItems) do
		if GetHidden(i) ~= true then
			currentRow = currentRow + 1
			if currentRow == RowNr then
				realRowNr = i
				break
			end
		end
	end
	return realRowNr
end

local function GetRealNumRows()
	local currentRow=0
	for i=1, table.getn(OptionItems) do
		if GetHidden(i) ~= true then
			currentRow = currentRow + 1
		end
	end
	return currentRow
end

local function UpdateArrows(self)
	local row = wm.GetWindow("optionlist"):GetSelectedRow()
	local y = Layout.ListTop + (Layout.RowHeight + Layout.RowPadding) * (row - 1)
	
	local leftArrowSize = wm.GetResourceSize(self:getResource("ingame_options_arrow_left_glow"))
	local rightArrowSize = wm.GetResourceSize(self:getResource("ingame_options_arrow_right_glow"))

	local value = wm.GetWindow("optionvalue_row"..row)
	local xpos,_ = value:GetPosition()
	self.leftarrow:SetPosition(xpos - 5 - leftArrowSize[1], y + 2)

	local w,_ = wm.GetTextExtents(value:GetTitle(), Layout.ListFont)
	self.rightarrow:SetPosition(xpos + w + 9, y + 2)
end

local function UpdateInfoText()
	local selectedRow = GetRealRowNr(wm.GetWindow("optionlist"):GetSelectedRow())
	local descs = OptionItems[selectedRow][Descriptions]
	if descs ~= nil then
		local desc
		if type(descs) == "table" then
			desc = descs[GetSelectedItem(selectedRow)]
		else
			desc = descs
		end
		
		local infotext = wm.GetWindow("infotext")
		if desc then
			infotext:SetTitle(desc)
			infotext:WordWrap()
		else
			infotext:SetTitle(L"")
		end
	end
end

-- ChloeCustom: AI drivers chosen by the host (ChloeSteamNet.asi keeps the list, saves it and sends it to the clients)
function ChloeCustom_AIDriverRefresh()
	local text = ChloeSteam_GetAIDriverText()
	OptionItems[AIDriverSlot][Descriptions] = text
	OptionItems[AIDriverName][Descriptions] = text
end
function ChloeCustom_AISlotChanged()
	SetSelectedItemByValue(AIDriverName, ChloeSteam_GetAIDriver(GetSelectedItemValue(AIDriverSlot)))
	ChloeCustom_AIDriverRefresh()
end
function ChloeCustom_AIDriverChanged()
	ChloeSteam_SetAIDriver(GetSelectedItemValue(AIDriverSlot), GetSelectedItemValue(AIDriverName))
	ChloeCustom_AIDriverRefresh()
end

local function ChangeOptions(events, carindex, carskin)	
	local cartype = GetSelectedItemValue(CarType)
	if cartype < 0 then
		if carindex ~= nil then
			ChloeNet_Host_SetCarClass(CARCLASS_SAMEASHOST + carindex)
			ChloeNet_SetPlayerCar(carindex)
			ChloeNet_SetPlayerCarSkin(carskin)
		end
	else
		ChloeNet_Host_SetCarClass(cartype)
	end
	
	ChloeNet_Host_SetNitroRegen(GetSelectedItemValue(NitroRegenType))
	ChloeNet_Host_SetHandlingDamage(GetSelectedItemValue(HandlingDamage))
	ChloeNet_Host_SetUpgradeLevel(GetSelectedItemValue(Upgrades))
	ChloeNet_Host_SetNitroMult(GetSelectedItemValue(NitroRegen))
	ChloeNet_Host_SetDamageMult(GetSelectedItemValue(DamageLevel))
	ChloeNet_Host_SetHandlingMode(GetSelectedItemValue(HandlingMode))
	ChloeNet_Host_SetUncappedSpeedLimit(GetSelectedItemValue(SpeedLimit))
	ChloeNet_Host_SetNoProps(GetSelectedItemValue(DisableProps))
	ChloeNet_Host_SetNoContact(GetSelectedItemValue(GhostMode))
	if ChloeSteam_GetAIDriverCount ~= nil then -- ChloeCustom: number of chosen AI drivers
		ChloeNet_Host_SetNumAI(ChloeSteam_GetAIDriverCount())
	else
		ChloeNet_Host_SetNumAI(GetSelectedItemValue(AICount))
	end
	ChloeNet_Host_SetAIClass(GetSelectedItemValue(AIClass))
	ChloeNet_Host_SetPropCarsAvailable(GetSelectedItemValue(PropCars))
	
	menu_chloemultiplayer_lobby_changeoptions.back()
end

local function SelectHostCar(events)
	local carlist = { }
	local rules = ChloeNet_GetGameRules()
	if rules == GR_DEFAULT then
		rules = Levels[ChloeNet_GetLevelId()].Rules or GR_RACE
	end
	
	if rules == GR_STUNT then
		carlist = CarlistStuntCars()
	else
		local propCarsEnabled = ChloeNet_GetPropCarsAvailable()
		local validCarFunc = IsValidCarNoTemp350
		if propCarsEnabled then
			validCarFunc = IsValidCarIncludeTemp350
		end
	
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			if validCarFunc(i) then
				table.insert(carlist, {index = i})
			end
		end
		SortCarsByClass(carlist)
	end

	EnterCarSelection(
		function(car, skin)
			ChangeOptions(events, car, skin)
		end,
		function()
			EnterMenu("menu_chloemultiplayer_lobby_changeoptions")
		end,
		carlist,
		false, -- purchase
		true, -- all_available
		false, -- only_description
		false, -- show_tutorial
		false, -- background
		false, -- testtrack_menudata
		true, -- show_class
		nil, -- title
		true -- hide_menubar_car
	)
end

function menu_chloemultiplayer_lobby_changeoptions.init(self)
	self.parent:init(self)
	
	GUI:SetBackground("data/menu/career_race_rewards_background.tga")

	local res = self:getResource("title_bd")
	Frame { Position=Layout.TitleFramePos, Size=Layout.TitleFrameSize }:AttachResource(res)
	StaticText { Title=TITLE_MULTIPLAYER_GAMEOPTIONS, Font=Layout.TitleFont, Color=Layout.TitleColor, Position=Layout.TitlePos, Size=Layout.TitleSize, Align=FONTF_CENTER }
	
	res = self:getResource("black75_bd")
	Frame { Position=Layout.ListBdTopPos, Size=Layout.ListBdTopSize }:AttachResource(res)
	Frame { Position=Layout.ListBdBotPos, Size=Layout.ListBdBotSize }:AttachResource(res)
	
	res = self:getResource("black50_bd")
	Frame { Position=Layout.ListBdMidPos, Size=Layout.ListBdMidSize, Layer=2 }:AttachResource(res)
	Frame { Position=Layout.DescTitleFramePos, Size=Layout.DescTitleFrameSize, Layer=2 }:AttachResource(res)
	local frame = Frame { Position=Layout.DescFramePos, Size=Layout.DescFrameSize }:AttachResource(res)
	
	FadingStaticText { Name="infotext", Title=L"", Font=Layout.DescFont, Position=Layout.DescPos, Size=Layout.DescSize, Color=Layout.DescColor, Align=FONTF_CENTER, Layer=5 }

	local listboxParams = {
		ListBoxTemplate	= { Name="optionlist" },
		Left			= Layout.ListLeft,
		Top				= Layout.ListTop,
		LeftPadding		= 0,
		RightPadding	= 0,
		TopPadding		= 0,
		BottomPadding	= 0,
		RowWidth		= ChloeWidescreen_GetRight(),
		RowHeight		= Layout.RowHeight,
		RowPadding		= Layout.RowPadding,
		RowTemplate		= { DrawBackgroundColor=FALSE, TitleCentering=TITLE_CENTER_Y, Layer=3 },
		RowTemplateType	= "Button",
		RowTemplateCust	= function(Row, RowNr)
			Row:AttachResource(self:getResource("black50_bd"))
		end,
		NumRows	= NumOptions,
		Coloumns = {
			[1] = {
				Name				= "optiontitle", -- _row# is added
				ColoumnTemplate		= { Font=Layout.ListFont, Color=Layout.LabelFontColor, Position=POS(Layout.LabelX, 1), Size=SIZE(Layout.OptionWidth, Layout.RowHeight), Align=FONTF_RIGHT, Layer=4 },
				ColoumnTemplateType	= "StaticText",
				ColoumnTemplateCust	= function(Coloumn, RowNr, ColoumnNr)
				end
			},
			[2] = {
				Name				= "optionvalue", -- _row# is added
				ColoumnTemplate		= { Font=Layout.ListFont, Color=Layout.OptionFontColor, Position=POS(Layout.OptionX, 1), Size=SIZE(Layout.OptionWidth, Layout.RowHeight), Layer=4 },
				ColoumnTemplateType	= "StaticText",
				ColoumnTemplateCust	= function(Coloumn, RowNr, ColoumnNr)
				end
			},
		}
	}
	
	local flashLeftArrow = false
	local flashRightArrow = false
	local optionlist = CreateMultiColoumnListBox(listboxParams)
	optionlist:SetNumRows(NumOptions)
	optionlist:SetSelectedRow(1)
	optionlist.onNeedData = function(Self, RowObject, RowNr, ControlRowNr)
		local title = wm.GetWindow("optiontitle_row"..RowNr)
		local value = wm.GetWindow("optionvalue_row"..RowNr)
		
		local realRowNr = GetRealRowNr(RowNr)
		
		if realRowNr then
			if OptionItems[realRowNr][Hidden] == true then
				value:HideWindow()
				title:HideWindow()
			else
				local color
				if RowNr == optionlist:GetSelectedRow() then
					color = Layout.OptionSelectedFontColor
				else
					color = Layout.OptionFontColor
				end
				
				title:SetTitle(OptionItems[realRowNr][Label])
				value:SetTitle(GetSelectedItemLabel(realRowNr))
				value:SetColor(color, false)
				title:ShowWindow()
				value:ShowWindow()
				if OptionItems[realRowNr][Enabled] then
					value:SetLayer(4)
					title:SetLayer(4)
				else
					value:SetLayer(2)
					title:SetLayer(2)
				end
			end
		else
			value:SetLayer(2)
			title:SetLayer(2)
			value:SetTitle(L"")
			value:HideWindow()
			title:HideWindow()	
		end

		if RowNr == optionlist:GetSelectedRow() then
			UpdateArrows(self)
			if flashLeftArrow then
				flashLeftArrow = false
				self.leftarrow:Flash(-1)
			end
			if flashRightArrow then
				flashRightArrow = false
				self.rightarrow:Flash(1)
			end
		end
	end

	self.leftarrow = CreateArrow(self, "leftarrow", "ingame_options_arrow_left")
	self.rightarrow = CreateArrow(self, "rightarrow", "ingame_options_arrow_right")

	if ChloeNet_GetCarClass() < CARCLASS_SAMEASHOST then
		SetSelectedItemByValue(CarType, ChloeNet_GetCarClass())
	else
		SetSelectedItem(CarType, table.getn(OptionItems[CarType][ItemValues]))
	end
	
	SetSelectedItemByValue(DamageLevel, ChloeNet_GetDamageMult())
	if ChloeNet_GetHandlingDamage() then
		SetSelectedItemByValue(HandlingDamage, 1)
	else
		SetSelectedItemByValue(HandlingDamage, 0)
	end
	SetSelectedItemByValue(Upgrades, ChloeNet_GetUpgradeLevel())
	SetSelectedItemByValue(NitroRegen, ChloeNet_GetNitroMult())
	SetSelectedItemByValue(NitroRegenType, ChloeNet_GetNitroRegen())
	SetSelectedItemByValue(AICount, ChloeNet_GetNumAI())
	SetSelectedItemByValue(AIClass, ChloeNet_GetAIClass())
	if ChloeSteam_SetAIDriver ~= nil then -- ChloeCustom: AI SLOT / AI DRIVER instead of AI COUNT
		SetHidden(AICount, true)
		SetEnabled(AIDriverSlot, true)
		SetEnabled(AIDriverName, true)
		SetSelectedItem(AIDriverSlot, 1)
		SetSelectedItemByValue(AIDriverName, ChloeSteam_GetAIDriver(1))
		ChloeCustom_AIDriverRefresh()
	else
		SetHidden(AIDriverSlot, true)
		SetHidden(AIDriverName, true)
	end
	SetSelectedItemByValue(HandlingMode, ChloeNet_GetHandlingMode())
	if ChloeNet_GetNoProps() then
		SetSelectedItemByValue(DisableProps, 1)
	else
		SetSelectedItemByValue(DisableProps, 0)
	end
	if ChloeNet_GetUncappedSpeedLimit() then
		SetSelectedItemByValue(SpeedLimit, 1)
	else
		SetSelectedItemByValue(SpeedLimit, 0)
	end
	if ChloeNet_GetNoContact() then
		SetSelectedItemByValue(GhostMode, 1)
	else
		SetSelectedItemByValue(GhostMode, 0)
	end
	if ChloeNet_GetPropCarsAvailable() then
		SetSelectedItemByValue(PropCars, 1)
	else
		SetSelectedItemByValue(PropCars, 0)
	end
	
	optionlist:SetSelectedRow(1)
	
	local handler = InputHandler { Name="inputhandler" }
	handler.onKeyPressed = function(Self, Character, VirtualKey, ScanCode)
		local selectedRow = GetRealRowNr(optionlist:GetSelectedRow())
		if VirtualKey == KeyCodes["BUTTON_START"] then
			if GetSelectedItemValue(CarType) < 0 and ChloeNet_GetCarClass() < CARCLASS_SAMEASHOST then
				SelectHostCar()
			else
				ChangeOptions()
				menu_chloemultiplayer_lobby_changeoptions.back()
			end
			playmenusound_action()
		elseif VirtualKey == KeyCodes["BUTTON_SELECT"] then
			--menu_chloemultiplayer_lobby_changeoptions.back()
			if GetSelectedItemValue(CarType) < 0 and ChloeNet_GetCarClass() < CARCLASS_SAMEASHOST then
				SelectHostCar()
			else
				ChangeOptions()
				menu_chloemultiplayer_lobby_changeoptions.back()
			end
			playmenusound_back()
		elseif VirtualKey == KeyCodes["BUTTON_LEFT"] then
			if selectedRow then
				if GetEnabled(selectedRow) then
					local selectedItem = GetSelectedItem(selectedRow) - 1
					local numItems = GetNumItems(selectedRow)
					if selectedItem < 1 then
						selectedItem = numItems
					end
					SetSelectedItem(selectedRow,selectedItem)

					local onChanged = OptionItems[selectedRow][OnChanged]
					if onChanged ~= nil then
						onChanged(selectedRow)
					end
					
					flashLeftArrow = true
					optionlist:Refresh()
					UpdateInfoText()
					playmenusound_move()
				end
			end
		elseif VirtualKey == KeyCodes["BUTTON_RIGHT"] then
			if selectedRow then
				if GetEnabled(selectedRow) then
					local selectedItem = GetSelectedItem(selectedRow) + 1
					local numItems = GetNumItems(selectedRow)
					if selectedItem > numItems then
						selectedItem = 1
					end
					SetSelectedItem(selectedRow,selectedItem)

					local onChanged = OptionItems[selectedRow][OnChanged]
					if onChanged ~= nil then
						onChanged(selectedRow)
					end
					
					flashRightArrow = true
					optionlist:Refresh()
					UpdateInfoText()
					playmenusound_move()
				end
			end
		elseif VirtualKey == KeyCodes["BUTTON_DOWN"] then
			self.leftarrow:StopFlash()
			self.rightarrow:StopFlash()
			-- Skip any disabled rows
			local row = optionlist:GetSelectedRow()
			if row == GetRealNumRows() then
				row = 0 -- init to 0 as the below code sets it to 1 right after
			end
			local realrow
			repeat
				row = row + 1
				realrow = GetRealRowNr(row)
			until OptionItems[realrow][Enabled] == true or row == GetRealNumRows()
			if not (row == GetRealNumRows() and OptionItems[realrow][Enabled] == false) then
				optionlist:SetSelectedRow(row)
			end
			
			UpdateArrows(self)
			UpdateInfoText()
			playmenusound_move()
		elseif VirtualKey == KeyCodes["BUTTON_UP"] then
			self.leftarrow:StopFlash()
			self.rightarrow:StopFlash()
			-- Skip any disabled rows
			local row = optionlist:GetSelectedRow()
			if row == 1 then
				row = GetRealNumRows() + 1
			end
			local realrow
			repeat
				row = row - 1
				realrow = GetRealRowNr(row)
			until OptionItems[realrow][Enabled] == true or row == 1
			if not (row == 1 and OptionItems[realrow][Enabled] == false) then
				optionlist:SetSelectedRow(row)
			end

			UpdateArrows(self)
			UpdateInfoText()
			playmenusound_move()
		end
	end
	
	GUI:SetHelpButtons(BUTTON_OK, UI_ACCEPT, BUTTON_BACK, UI_BACK)
	UpdateInfoText()
	
	handler:SetFocus()
end
	
function menu_chloemultiplayer_lobby_changeoptions.deinit(self)
	self.parent:deinit(self)
end

function menu_chloemultiplayer_lobby_changeoptions.update(self,time)
	self.parent:update(self,time)

	self.leftarrow:AnimateAlpha(time)
	self.rightarrow:AnimateAlpha(time)
end