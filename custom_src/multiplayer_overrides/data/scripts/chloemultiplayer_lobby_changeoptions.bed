dofile("data/menu/xbox_controller.bed")

menu_chloemultiplayer_lobby_changeoptions = CreateMenuFromTemplate("template_multiplayer")
menu_chloemultiplayer_lobby_changeoptions.options.title = TITLE_MULTIPLAYER_CHANGEOPTIONS
menu_chloemultiplayer_lobby_changeoptions.back = function() end

function EnterChloeChangeOptions(title, backmenu)
	menu_chloemultiplayer_lobby_changeoptions.options.title = title
	menu_chloemultiplayer_lobby_changeoptions.back = entermenu(backmenu)
	EnterMenu("menu_chloemultiplayer_lobby_changeoptions")
end

function menu_chloemultiplayer_lobby_changeoptions.create(self)
	self.parent:create(self)

	self:addResource("xbox_controller.tga", xbox_controller, xbox_controller_size)
	
	self:loadResources()

	self.items = { }
end

