-- OptionItem item indexes
local Label=1
local ItemLabels=2
local ItemValues=3
local SelectedItem=4
local Enabled=5
local OnChanged=6
local Descriptions=7

-- OptionItem indexes
local CarType=1
local DamageLevel=2
local HandlingDamage=3
local Upgrades=4
local NitroRegen=5
local NitroRegenType=6
local HandlingMode=7
local SpeedLimit=8
local DisableProps=9
local GhostMode=10
local AIClass=11
local AllowZMenu=12

local NumOptions=11

local function GetEnabled(RowNr)
	return OptionItems[RowNr][Enabled]
end

local function SetEnabled(RowNr, value)
	OptionItems[RowNr][Enabled]=value
end

local function SetSelectedItem(RowNr, Item)
	OptionItems[RowNr][SelectedItem]=Item
end

local function SetSelectedItemByValue(RowNr, Value)
	for i,j in ipairs(OptionItems[RowNr][ItemValues]) do
		if j == Value then
			SetSelectedItem(RowNr, i)
			break
		end
	end
end

local function GetSelectedItemValue(rowNr)
	return OptionItems[rowNr][ItemValues][OptionItems[rowNr][SelectedItem] ]
end

local function GetSelectedItemLabel(rowNr)
	return OptionItems[rowNr][ItemLabels][OptionItems[rowNr][SelectedItem] ]
end

local function GetRealRowNr(RowNr)
	local realRowNr=nil
	local currentRow=0
	for i=1, table.getn(OptionItems) do
		if GetEnabled(i) then
			currentRow = currentRow + 1
			if currentRow == RowNr then
				realRowNr = i
				break
			end
		end
	end
	return realRowNr
end

local function GetRealNumRows()
	local currentRow=0
	for i=1, table.getn(OptionItems) do
		if GetEnabled(i) then
			currentRow = currentRow + 1
		end
	end
	return currentRow
end

local HelpTopRow
local NumHelpTextRows

local StuntTexts = {
	[LevelIndex.CURLING]		= "INTRO_STUNT_CURLING",
	[LevelIndex.HIGHJUMP]		= "INTRO_STUNT_HIGHJUMP",
	[LevelIndex.STONESKIPPING]	= "INTRO_STUNT_STONESKIPPING",
	[LevelIndex.RINGOFFIRE]		= "INTRO_STUNT_RING",
	[LevelIndex.DARTS]			= "INTRO_STUNT_DARTS",
	[LevelIndex.ROYALFLUSH]		= "INTRO_STUNT_ROYALFLUSH",
	[LevelIndex.SKIJUMP]		= "INTRO_STUNT_SKIJUMP",
	[LevelIndex.FIELDGOAL]		= "INTRO_STUNT_FIELDGOAL",
	[LevelIndex.BOWLING]		= "INTRO_STUNT_BOWLING",
	[LevelIndex.BASKETBALL]		= "INTRO_STUNT_BASKETBALL",
	[LevelIndex.BASEBALL]		= "INTRO_STUNT_BASEBALL",
	[LevelIndex.SOCCER]			= "INTRO_STUNT_SOCCER",
}

local EventHelpEnabled

local function ShowEventHelp()
	MessageBox(EventHelpText, MESSAGEBOX_OK,
		function(value)
			GUI:SetHelpButtons(BUTTON_BACK, UI_BACK, BUTTON_EXTRA, UI_EVENTHELP)
		end
	)
end

local function HideEventHelp()
	wm.GetWindow("eventhelp_box"):HideWindow()
end

local function InitOptions()	
	if ChloeNet_GetCarClass() < CARCLASS_SAMEASHOST then
		SetSelectedItemByValue(CarType, ChloeNet_GetCarClass())
	else
		SetSelectedItem(CarType, table.getn(OptionItems[CarType][ItemValues]))
	end
	
	SetSelectedItemByValue(DamageLevel, ChloeNet_GetDamageMult())
	if ChloeNet_GetHandlingDamage() then
		SetSelectedItemByValue(HandlingDamage, 1)
	else
		SetSelectedItemByValue(HandlingDamage, 0)
	end
	SetSelectedItemByValue(Upgrades, ChloeNet_GetUpgradeLevel())
	SetSelectedItemByValue(NitroRegen, ChloeNet_GetNitroMult())
	SetSelectedItemByValue(NitroRegenType, ChloeNet_GetNitroRegen())
	SetSelectedItemByValue(AIClass, ChloeNet_GetAIClass())
	SetSelectedItemByValue(HandlingMode, ChloeNet_GetHandlingMode())
	if ChloeNet_GetNoProps() then
		SetSelectedItemByValue(DisableProps, 1)
	else
		SetSelectedItemByValue(DisableProps, 0)
	end
	if ChloeNet_GetUncappedSpeedLimit() then
		SetSelectedItemByValue(SpeedLimit, 1)
	else
		SetSelectedItemByValue(SpeedLimit, 0)
	end
	if ChloeNet_GetNoContact() then
		SetSelectedItemByValue(GhostMode, 1)
	else
		SetSelectedItemByValue(GhostMode, 0)
	end
	if ChloeNet_GetZMenuAllowed() then
		SetSelectedItemByValue(AllowZMenu, 1)
	else
		SetSelectedItemByValue(AllowZMenu, 0)
	end
end

menu_chloemultiplayer_lobby_sessiondetails = CreateMenuFromTemplate("template_multiplayer")
menu_chloemultiplayer_lobby_sessiondetails.options.title = L""
menu_chloemultiplayer_lobby_sessiondetails.back = function() end

function menu_chloemultiplayer_lobby_sessiondetails.create(self)
	self.parent:create(self)

	self:addResource("game_mode_selector_ws.tga",game_mode_selector,game_mode_selector_size)
	self:addResource("xbox_controller.tga",xbox_controller,xbox_controller_size)	
	self:addResource("event_type_images_wide_ws.tga",event_type_images_wide,event_type_images_wide_size)
	self:addResource("event_type_images_wide_2.tga",event_type_images_wide_2,event_type_images_wide_2_size)
	self:addResource("event_type_images_wide_3.tga",event_type_images_wide_3,event_type_images_wide_3_size)
	self:addResource("event_type_images_wide_tt.tga",event_type_images_wide_tt,event_type_images_wide_tt_size)
	self:addResource("event_type_images_wide_karelia.tga",event_type_images_wide_karelia,event_type_images_wide_karelia_size)
	self:addResource("event_type_images_wide_kenya.tga",event_type_images_wide_kenya,event_type_images_wide_kenya_size)
	self:addResource("event_type_images_wide_finland.tga",event_type_images_wide_finland,event_type_images_wide_finland_size)
	self:addResource("event_type_images_wide_sweden.tga",event_type_images_wide_sweden,event_type_images_wide_sweden_size)
	self:addResource("event_type_images_wide_switzerland.tga",event_type_images_wide_switzerland,event_type_images_wide_switzerland_size)
	self:addResource("event_type_images_wide_arcade.tga",event_type_images_wide_arcade,event_type_images_wide_arcade_size)
	self:addResource("event_type_images_wide_extras.tga",event_type_images_wide_extras,event_type_images_wide_extras_size)
	self:addResource("track_images_wide_1_ws.tga",track_images_wide_1,track_images_wide_1_size)	
	self:addResource("track_images_wide_2_ws.tga",track_images_wide_2,track_images_wide_2_size)	
	self:addResource("track_images_wide_3_ws.tga",track_images_wide_3,track_images_wide_3_size)	
	self:addResource("track_images_wide_4_ws.tga",track_images_wide_4,track_images_wide_4_size)	
	self:addResource("track_images_wide_5_ws.tga",track_images_wide_5,track_images_wide_5_size)	
	self:addResource("track_images_wide_6_ws.tga",track_images_wide_6,track_images_wide_6_size)	
	self:addResource("track_images_wide_7_ws.tga",track_images_wide_7,track_images_wide_7_size)	
	
	self:loadResources()
	self.items = { }
end

function menu_chloemultiplayer_lobby_sessiondetails.init(self)
	self.parent:init(self)

	-- Title + backdrop
	Frame { Position=LEFTPOS(0,64), Size=SIZE(ChloeWidescreen_GetRight(),42) }:AttachResource(self:getResource("game_mode_main_bd"))
	StaticText { Name="trackname", Title=L"", Position=POS(320,63), Font=fonttitle(), Color=GetPaletteColor(33), Align=FONTF_CENTER }

	-- Mid backdrop + track image
	Frame { Position=LEFTPOS(0,110), Size=SIZE(ChloeWidescreen_GetRight(),128) }:AttachResource(self:getResource("game_mode_main_bd_2"))
	Frame { Name="trackimage", Position=POS(64,118), Size=SIZE(512,112) }
	
	-- Bottom backdrops
	Frame { Position=LEFTPOS(0,244), Size=SIZE(ChloeWidescreen_GetRight(),20) }:AttachResource(self:getResource("black50_bd"))
	Frame { Position=LEFTPOS(0,267), Size=SIZE(286-ChloeWidescreen_GetLeft(),105) }:AttachResource(self:getResource("session_detail_str"))
	Frame { Position=POS(286,267), Size=SIZE(70,105) }:AttachResource(self:getResource("session_detail_mid"))
	Frame { Position=POS(356,267), Size=SIZE(ChloeWidescreen_GetRight()-356,105) }:AttachResource(self:getResource("session_detail_str"))
	
	-- Labels
	StaticText { Title=TITLE_MULTIPLAYER_SESSIONDETAILS, Position=POS(320,243), Size=SIZE(200,16), Font=fontmedium(), Color=GetPaletteColor(33), Align=FONTF_CENTER }

	local rules = ChloeNet_GetGameRules()
	if rules == GR_DEFAULT then
		rules = Levels[ChloeNet_GetLevelId()].Rules or GR_RACE
	end
	
	if rules == GR_STUNT then
		EventHelpEnabled = true
		
		-- Construct event help text for the current stunt
		local stunttype = ChloeNet_GetLevelId()
		local textid = StuntTexts[stunttype]
		EventHelpText = L("#33"..Levels[ChloeNet_GetLevelId()].Name.."#34\n\n")
		for i = 1,4 do
			if i > 1 then
				EventHelpText = WStringConcat(EventHelpText, L"\n\n")
			end
			EventHelpText = WStringConcat(EventHelpText, L(i..". "))
			EventHelpText = WStringConcat(EventHelpText, _G[textid.."_"..i])
		end
		EventHelpText = WStringConcat(EventHelpText, L"\n")
	else
		EventHelpEnabled = false
	end
	
	local leveldata = Levels[ChloeNet_GetLevelId()]
	
	local track_type=nil
	if rules == GR_RACE then
		track_type=leveldata.TrackType
		if ChloeNet_GetTrackReversed() then
			track_type=TRACKTYPE_REVERSED
		end
	end
	
	local trackname=L""
	if track_type and track_type==TRACKTYPE_REVERSED then
		trackname = WStringConcat(GetPhrase(TRANSLATOR(RACETRACKTYPE_REVERSED)), L" ")
	end
	trackname = WStringConcat(trackname, L(leveldata.Name))

	W("trackname"):SetTitle(trackname)

	local image = leveldata.TrackImage or ""
	W("trackimage"):AttachResource(self:getResource(image))

	InitOptions()
	
	local realNumOptions = GetRealNumRows()
	local numRows1 = math.min(realNumOptions, 6)
	local numRows2 = math.max(realNumOptions - 6, 0)
	
	local listboxParams = {
		ListBoxTemplate	= { Name="optionlist1" },
		Left			= 0,
		Top				= Layout.ListTop,
		LeftPadding		= 0,
		RightPadding	= 0,
		TopPadding		= 0,
		BottomPadding	= 0,
		RowWidth		= 640,
		RowHeight		= Layout.RowHeight,
		RowPadding		= Layout.RowPadding,
		RowTemplate		= { },
		RowTemplateType	= "Button",
		RowTemplateCust	= function(Row, RowNr)
		end,
		NumRows	= numRows1,
		Coloumns = {
			[1] = {
				Name				= "optiontitle1", -- _row# is added
				ColoumnTemplate		= { Font=Layout.ListFont, Color=Layout.LabelFontColor, Position=POS(Layout.LabelLeft, -1), Size=SIZE(Layout.OptionWidth, Layout.RowHeight), Align=FONTF_RIGHT, Layer=4 },
				ColoumnTemplateType	= "StaticText",
				ColoumnTemplateCust	= function(Coloumn, RowNr, ColoumnNr)
				end
			},
			[2] = {
				Name				= "optionvalue1", -- _row# is added
				ColoumnTemplate		= { Font=Layout.ListFont, Color=Layout.OptionFontColor, Position=POS(Layout.OptionLeft, -1), Size=SIZE(Layout.OptionWidth, Layout.RowHeight), Layer=4 },
				ColoumnTemplateType	= "StaticText",
				ColoumnTemplateCust	= function(Coloumn, RowNr, ColoumnNr)
				end
			},
		}
	}
	
	local optionlist1 = CreateMultiColoumnListBox(listboxParams)
	optionlist1:SetNumRows(numRows1)
	optionlist1:SetSelectedRow(1)
	optionlist1.onNeedData = function(Self, RowObject, RowNr, ControlRowNr)
		local title = wm.GetWindow("optiontitle1_row"..RowNr)
		local value = wm.GetWindow("optionvalue1_row"..RowNr)
		
		title:SetPosition(Layout.LabelLeft + 5 * (ControlRowNr - 1), -1)
		value:SetPosition(Layout.OptionLeft + 5 * (ControlRowNr - 1), -1)
		
		local realRowNr = GetRealRowNr(RowNr)
		
		if realRowNr then
			title:SetTitle(OptionItems[realRowNr][Label])
			if OptionItems[realRowNr][Enabled] then
				value:SetLayer(4)
				title:SetLayer(4)
				value:SetTitle(GetSelectedItemLabel(realRowNr))
				value:ShowWindow()
				title:ShowWindow()
			else
				value:HideWindow()
				title:HideWindow()
			end
		else
			value:HideWindow()
			title:HideWindow()	
		end
	end
	
	listboxParams.ListBoxTemplate.Name = "optionlist2"
	listboxParams.Coloumns[1].Name = "optiontitle2"
	listboxParams.Coloumns[2].Name = "optionvalue2"

	local optionlist2 = CreateMultiColoumnListBox(listboxParams)
	optionlist2:SetNumRows(numRows2)
	optionlist2:SetSelectedRow(1)
	optionlist2.onNeedData = function(Self, RowObject, RowNr, ControlRowNr)
		local title = wm.GetWindow("optiontitle2_row"..RowNr)
		local value = wm.GetWindow("optionvalue2_row"..RowNr)
		
		title:SetPosition(Layout.LabelLeft2 + 5 * (ControlRowNr - 1), -1)
		value:SetPosition(Layout.OptionLeft2 + 5 * (ControlRowNr - 1), -1)
		
		local realRowNr = GetRealRowNr(RowNr + 6)
		
		if realRowNr then
			title:SetTitle(OptionItems[realRowNr][Label])
			if OptionItems[realRowNr][Enabled] then
				value:SetLayer(4)
				title:SetLayer(4)
				value:SetTitle(GetSelectedItemLabel(realRowNr))
				value:ShowWindow()
				title:ShowWindow()
			else
				value:HideWindow()
				title:HideWindow()
			end
		else
			value:HideWindow()
			title:HideWindow()	
		end
	end

	local handler = InputHandler { Name="inputhandler" }
	handler.onKeyPressed = function(Self, Character, VirtualKey, ScanCode)
		if VirtualKey == KeyCodes["BUTTON_SELECT"] then
			menu_chloemultiplayer_lobby_sessiondetails.back()
		elseif EventHelpEnabled and VirtualKey==KeyCodes["BUTTON_Y"] then
			ShowEventHelp()
		end
	end
	
	if EventHelpEnabled then
		GUI:SetHelpButtons(BUTTON_BACK, UI_BACK, BUTTON_EXTRA, UI_EVENTHELP)
	else
		GUI:SetHelpButtons(BUTTON_BACK, UI_BACK)
	end

	handler:SetFocus()
end
	
function menu_chloemultiplayer_lobby_sessiondetails.deinit(self)
	self.parent:deinit(self)
end

function menu_chloemultiplayer_lobby_sessiondetails.update(self,time)
	self.parent:update(self,time)
end

end --//USE_NETWORK