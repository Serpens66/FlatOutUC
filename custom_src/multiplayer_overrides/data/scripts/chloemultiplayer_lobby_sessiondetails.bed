function EnterChloeSessionDetails(title, backmenu)
	menu_chloemultiplayer_lobby_sessiondetails.options.title = title
	menu_chloemultiplayer_lobby_sessiondetails.back = entermenu(backmenu)
	EnterMenu("menu_chloemultiplayer_lobby_sessiondetails")
end

