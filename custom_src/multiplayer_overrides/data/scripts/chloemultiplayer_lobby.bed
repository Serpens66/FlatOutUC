local function ShowPlayerProfile(playerNum)
	Mode = PLAYER_PROFILE
	wm.GetWindow("list"):Refresh()
	
	EnterChloeMultiPlayerProfile(ChloeNet_GetPlayerName(playerNum), entermenu("menu_chloemultiplayer_lobby"))
end

local function KickPlayer(playerNum)
	GUI:HideMenuButtons()
	if not ChloeNet_IsPlayerValid(playerNum) or ChloeNet_IsPlayerLocalPlayer(playerNum) then
		Mode = LOBBY
		BuildLobbyMenuButtons()
		SetLobbyHelpButtons()
		return
	end
	
	local msg =	WStringConcat(EscapeString(ChloeNet_GetPlayerName(playerNum)), L"\n")
	msg = WStringConcat(msg, L"Are you sure you want to kick this player?")

	MessageBox(
		msg,
		MESSAGEBOX_YESNO,
		function(value)
			if value == TRUE then
				ChloeNet_Host_KickPlayer(playerNum)
			end
			Mode = LOBBY
			BuildLobbyMenuButtons()
			SetLobbyHelpButtons()
		end
	)
end

local function BanPlayer(playerNum)
	GUI:HideMenuButtons()
	if not ChloeNet_IsPlayerValid(playerNum) or ChloeNet_IsPlayerLocalPlayer(playerNum) then
		Mode = LOBBY
		BuildLobbyMenuButtons()
		SetLobbyHelpButtons()
		return
	end
	
	local msg =	WStringConcat(EscapeString(ChloeNet_GetPlayerName(playerNum)), L"\n")
	msg = WStringConcat(msg, L"Are you sure you want to ban this player?\nThey won't be able to join your server again until you restart the game!")

	MessageBox(
		msg,
		MESSAGEBOX_YESNO,
		function(value)
			if value == TRUE then
				ChloeNet_Host_BanPlayer(playerNum)
			end
			Mode = LOBBY
			BuildLobbyMenuButtons()
			SetLobbyHelpButtons()
		end
	)
end

local ActivePlayerOption
local ActiveLobbyOption

local function SetSelectPlayerButtons(playerNum)
	local playerNum = wm.GetWindow("list"):GetSelectedRow()+PLAYERLIST_SCROLL
	
	menu_chloemultiplayer_lobby.items = { }
	if not ChloeNet_IsPlayerValid(playerNum) then
		SelectedPlayerValid = false
		GUI:HideMenuButtons()
		return
	end

	SelectedPlayerValid = true

	if MultiplayerMode == MPMODE_XBOXLIVE then
		table.insert(menu_chloemultiplayer_lobby.items, { ICON_MULTIPLAYER_PLAYER_PROFILE, function() ShowPlayerProfile(playerNum) end, ICON(menu_chloemultiplayer_lobby, "icon_player_profile") } )
	end

	if ChloeNet_IsServer() then
		table.insert(menu_chloemultiplayer_lobby.items, { ICON_MULTIPLAYER_PLAYER_KICK, function() KickPlayer(playerNum) end, ICON(menu_chloemultiplayer_lobby, "icon_kick_player") } )
		table.insert(menu_chloemultiplayer_lobby.items, { L("BAN PLAYER"), function() BanPlayer(playerNum) end, ICON(menu_chloemultiplayer_lobby, "icon_kick_player") } )
	end
	
	GUI:InitMenuButtons(menu_chloemultiplayer_lobby.items)
	GUI:ShowMenuButtons()
	ActivePlayerOption = 1
	GUI:SetActiveItem(ActivePlayerOption)
	
	if table.getn(menu_chloemultiplayer_lobby.items)==0 then
		SelectedPlayerValid=false
		GUI:HideMenuButtons()
	end
end

local function SelectPlayer()	
	local list = wm.GetWindow("list")

	local handler = InputHandler { Name="selectplayer_handler" }
		
	handler.onKeyPressed = function(Self, Character, VirtualKey, ScanCode)
		if VirtualKey == KeyCodes["BUTTON_START"] then
			if SelectedPlayerValid then
				list.onSelectedRowChanged = nil
				wm.RemoveWindow(handler)
				menu_chloemultiplayer_lobby.items[ActivePlayerOption][2]()
				AUDIO.PlayMenuSound(AUDIO.MENUSFX_SELECT)
			end
		elseif VirtualKey == KeyCodes["BUTTON_SELECT"] then
			list.onSelectedRowChanged = nil
			Mode = LOBBY
			wm.RemoveWindow(handler)
			BuildLobbyMenuButtons()
			AUDIO.PlayMenuSound(AUDIO.MENUSFX_BACK)
		elseif VirtualKey == KeyCodes["BUTTON_DOWN"] then
			if list:GetSelectedRow()+PLAYERLIST_SCROLL < ChloeNet_GetNumPlayers() and list:GetSelectedRow() < NUMPLAYERS_LOBBYLIST then
				list:MoveNext()
				AUDIO.PlayMenuSound(AUDIO.MENUSFX_MOVE)
			end
		elseif VirtualKey == KeyCodes["BUTTON_UP"] then
			if list:GetSelectedRow() > 1 then
				list:MovePrev()
				AUDIO.PlayMenuSound(AUDIO.MENUSFX_MOVE)
			end
		elseif VirtualKey == KeyCodes["BUTTON_RIGHT"] then
			local numitems = table.getn(menu_chloemultiplayer_lobby.items)
			if numitems > 0 then
				ActivePlayerOption = math.mod(ActivePlayerOption, numitems) + 1
				GUI:SetActiveItem(ActivePlayerOption)
			end
			AUDIO.PlayMenuSound(AUDIO.MENUSFX_MOVE)
			handler:SetFocus()
		elseif VirtualKey == KeyCodes["BUTTON_LEFT"] then
			local numitems = table.getn(menu_chloemultiplayer_lobby.items)
			if numitems > 0 then
				ActivePlayerOption = math.mod(ActivePlayerOption - 2 + numitems, numitems) + 1
				GUI:SetActiveItem(ActivePlayerOption)
			end
			AUDIO.PlayMenuSound(AUDIO.MENUSFX_MOVE)
			handler:SetFocus()
		end
	end
	
	list.onSelectedRowChanged = function(self, row)
		if ChloeNet_GetNumPlayers() >= row then
			SelectedPlayerPeerId = ChloeNet_GetPlayerName(row+PLAYERLIST_SCROLL)
			ActivePlayerOption = 1
			SetSelectPlayerButtons()
			handler:SetFocus()
		else
			list:SetSelectedRow(ChloeNet_GetNumPlayers()-PLAYERLIST_SCROLL)
		end
	end
	
	GUI:HideMenuButtons()

	handler:SetFocus()
	SelectedPlayerPeerId = ChloeNet_GetPlayerName(list:GetSelectedRow()+PLAYERLIST_SCROLL)
	Mode = SELECT_PLAYER
	SelectPlayerStart = 0
	wm.GetWindow("list"):SetSelectedRow(1)
	SetSelectPlayerButtons(1)
	wm.GetWindow("list"):Refresh()
end

local function SwapTrackFO2()
	if ChloeNet_GetIsFO2Track() then
		ChloeNet_Host_SetIsFO2Track(0)
	else
		ChloeNet_Host_SetIsFO2Track(1)
	end
end

BuildLobbyMenuButtons = function(creating)	
	Mode = LOBBY
	menu_chloemultiplayer_lobby.items = { }
	
	if ChloeNet_IsServer() then
		menu_chloemultiplayer_lobby.items = { }
		table.insert(menu_chloemultiplayer_lobby.items, { ICON_MULTIPLAYER_CHANGECAR, function() ChangeCar() end, ICON(menu_chloemultiplayer_lobby,"icon_change_car") } )
		table.insert(menu_chloemultiplayer_lobby.items, { L("RANDOM CAR"), function() SetRandomCar() end, ICON(menu_chloemultiplayer_lobby,"icon_instant_action") } )
		if ChloeNet_GetTuningAvailable() then
			table.insert(menu_chloemultiplayer_lobby.items, { L("TUNE CAR"), function() TuneCar() end, ICON(menu_chloemultiplayer_lobby,"icon_change_upgrade_level") } )
		end
		table.insert(menu_chloemultiplayer_lobby.items, { ICON_MULTIPLAYER_PLAYERDETAILS, function() SelectPlayer() end, ICON(menu_chloemultiplayer_lobby,"icon_player_details") } )
		table.insert(menu_chloemultiplayer_lobby.items, { ICON_MULTIPLAYER_GAMEOPTIONS, function() ChangeOptions() end, ICON(menu_chloemultiplayer_lobby,"icon_game_options") } )
		table.insert(menu_chloemultiplayer_lobby.items, { MULTIPLAYER_ICON_CHANGETRACK, function() ChangeTrack() end, ICON(menu_chloemultiplayer_lobby,"icon_change_track") } )
		if ChloeCollection_DoesTrackHaveFO2Variant(ChloeNet_GetLevelId()) then
			table.insert(menu_chloemultiplayer_lobby.items, { L("TRACK VARIATION"), function() SwapTrackFO2() end, ICON(menu_chloemultiplayer_lobby,"icon_instant_action") } )
		end
		table.insert(menu_chloemultiplayer_lobby.items, { ICON_MAIN_OPTIONS, function() EnterOptionsMenu() end, ICON(menu_chloemultiplayer_lobby,"icon_options") } )
		table.insert(menu_chloemultiplayer_lobby.items, { ICON_MULTIPLAYER_STARTRACE, function() StartRace() end, ICON(menu_chloemultiplayer_lobby,"icon_go_race") } )
	elseif ChloeNet_IsLocalPlayerReady() then
		table.insert(menu_chloemultiplayer_lobby.items, { ICON_MULTIPLAYER_PLAYERDETAILS, function() SelectPlayer() end, ICON(menu_chloemultiplayer_lobby,"icon_player_details") } )
		table.insert(menu_chloemultiplayer_lobby.items, { ICON_MULTIPLAYER_SESSIONDETAILS, function() SessionDetails() end, ICON(menu_chloemultiplayer_lobby,"icon_session_details") } )
		table.insert(menu_chloemultiplayer_lobby.items, { L("UNREADY"), function() ChloeNet_SetPlayerReady(0); BuildLobbyMenuButtons(); end, ICON(menu_chloemultiplayer_lobby,"icon_profile_x") } )
	else
		table.insert(menu_chloemultiplayer_lobby.items, { ICON_MULTIPLAYER_CHANGECAR, function() ChangeCar() end, ICON(menu_chloemultiplayer_lobby,"icon_change_car") } )
		if ChloeNet_GetCarClass() < CARCLASS_SAMEASHOST then
			table.insert(menu_chloemultiplayer_lobby.items, { L("RANDOM CAR"), function() SetRandomCar() end, ICON(menu_chloemultiplayer_lobby,"icon_instant_action") } )
		end
		if ChloeNet_GetTuningAvailable() then
			table.insert(menu_chloemultiplayer_lobby.items, { L("TUNE CAR"), function() TuneCar() end, ICON(menu_chloemultiplayer_lobby,"icon_change_upgrade_level") } )
		end
		table.insert(menu_chloemultiplayer_lobby.items, { ICON_MULTIPLAYER_PLAYERDETAILS, function() SelectPlayer() end, ICON(menu_chloemultiplayer_lobby,"icon_player_details") } )
		table.insert(menu_chloemultiplayer_lobby.items, { ICON_MULTIPLAYER_SESSIONDETAILS, function() SessionDetails() end, ICON(menu_chloemultiplayer_lobby,"icon_session_details") } )
		table.insert(menu_chloemultiplayer_lobby.items, { ICON_MAIN_OPTIONS, function() EnterOptionsMenu() end, ICON(menu_chloemultiplayer_lobby,"icon_options") } )
		table.insert(menu_chloemultiplayer_lobby.items, { ICON_MULTIPLAYER_READY, function() ChloeNet_SetPlayerReady(1); BuildLobbyMenuButtons(); end, ICON(menu_chloemultiplayer_lobby,"icon_ready") } )
	end

	if ChloeCustomTourney_AddLobbyButtons then ChloeCustomTourney_AddLobbyButtons(menu_chloemultiplayer_lobby) end -- ChloeCustom Tourney
	GUI:InitMenuButtons(menu_chloemultiplayer_lobby.items)
	GUI:ShowMenuButtons(true)
	ActiveLobbyOption = GUI:GetActiveItem()
	GUI:SetActiveItem(ActiveLobbyOption)
	
	local handler = InputHandler { Name="lobbyscroll_handler" }
	handler.onKeyPressed = function(Self, Character, VirtualKey, ScanCode)
		if VirtualKey == KeyCodes["BUTTON_START"] then
			menu_chloemultiplayer_lobby.items[ActiveLobbyOption][2]()
			AUDIO.PlayMenuSound(AUDIO.MENUSFX_SELECT)
		elseif VirtualKey == KeyCodes["BUTTON_SELECT"] then
			menu_chloemultiplayer_lobby.back()
			AUDIO.PlayMenuSound(AUDIO.MENUSFX_BACK)
		elseif VirtualKey == KeyCodes["BUTTON_DOWN"] then
			if PLAYERLIST_SCROLL < ChloeNet_GetNumPlayers() - NUMPLAYERS_LOBBYLIST then
				PLAYERLIST_SCROLL = PLAYERLIST_SCROLL + 1
			end
			handler:SetFocus()
		elseif VirtualKey == KeyCodes["BUTTON_UP"] then
			if PLAYERLIST_SCROLL > 0 then
				PLAYERLIST_SCROLL = PLAYERLIST_SCROLL - 1
			end
			handler:SetFocus()
		elseif VirtualKey == KeyCodes["BUTTON_RIGHT"] then
			local numitems = table.getn(menu_chloemultiplayer_lobby.items)
			if numitems > 0 then
				ActiveLobbyOption = math.mod(ActiveLobbyOption, numitems) + 1
				GUI:SetActiveItem(ActiveLobbyOption)
			end
			AUDIO.PlayMenuSound(AUDIO.MENUSFX_MOVE)
			handler:SetFocus()
		elseif VirtualKey == KeyCodes["BUTTON_LEFT"] then
			local numitems = table.getn(menu_chloemultiplayer_lobby.items)
			if numitems > 0 then
				ActiveLobbyOption = math.mod(ActiveLobbyOption - 2 + numitems, numitems) + 1
				GUI:SetActiveItem(ActiveLobbyOption)
			end
			AUDIO.PlayMenuSound(AUDIO.MENUSFX_MOVE)
			handler:SetFocus()
		end
	end

	handler:SetFocus()
end

ChloeGameModeNames = {
	[GR_DEFAULT]			= TRANSLATOR(MULTIPLAYER_GAMEMODE_RACE),
	[GR_RACE]				= TRANSLATOR(MULTIPLAYER_GAMETYPE_RACE),
	[GR_PONGRACE]			= TRANSLATOR(MULTIPLAYER_GAMEMODE_PONGRACE),
	[GR_DERBY]				= TRANSLATOR(MULTIPLAYER_GAMEMODE_WRECKINGDERBY),
	[GR_STUNT]				= TRANSLATOR(MULTIPLAYER_GAMETYPE_STUNT),
	[GR_ARCADE_RACE]		= TRANSLATOR(ARCADEMODE_CARNAGERACE),
	[GR_TIME_TRIAL]			= TRANSLATOR(MULTIPLAYER_TIMETRIAL),
	[GR_BEAT_THE_BOMB]		= TRANSLATOR(ARCADEMODE_BEATTHEBOMB),
	[GR_TONYHAWK]			= L("STUNT SHOW"),
	[GR_SPEEDTRAP]			= L("SPEEDTRAP"),
	[GR_DRIFT]				= L("DRIFT"),
	[GR_LAPKNOCKOUT]		= L("LAP KNOCKOUT"),
	[GR_KNOCKOUT]			= L("KNOCKOUT"),
}

ChloeDerbyTypeNames = {
	[DERBY_LMS]				= MULTIPLAYER_GAMEMODE_SURVIVORDERBY,
	[DERBY_WRECKING]		= MULTIPLAYER_GAMEMODE_WRECKINGDERBY,
	[DERBY_FRAG]			= MULTIPLAYER_GAMEMODE_FRAGDERBY,
}

-- ChloeCustom: progress of a stunt or derby while others play (Steam package: ChloeSteamNet.asi sends it)
local function ChloeCustom_ShowRaceStatus(gameRules)
	if ChloeSteam_GetRaceStatus == nil or not ChloeNet_IsLobbyInGame() then
		return false
	end
	local kind, dtype, a, b, c = ChloeSteam_GetRaceStatus()
	if kind == 1 and gameRules == GR_STUNT then
		W("progress_title"):SetTitle(WStringConcat(INGAME_ROUND, L":"))
		W("progress"):SetTitle(L(a .. "/" .. b))
	elseif kind == 2 and gameRules == GR_DERBY and (a >= 0 or c >= 0) then
		local msg = L""
		if a >= 0 then
			msg = WStringConcat(L(a .. "/" .. b .. " "), MULTIPLAYER_PLAYERS)
		end
		if c >= 0 then
			if a >= 0 then
				msg = WStringConcat(msg, L", ")
			end
			msg = WStringConcat(msg, L(string.format("%d:%02d", math.floor(c / 60), math.mod(c, 60))))
		end
		W("progress_title"):SetTitle(WStringConcat(INGAME_REMAINING, L":"))
		W("progress"):SetTitle(msg)
	else
		return false
	end
	W("progress_title"):ShowWindow()
	W("progress"):ShowWindow()
	return true
end

local function UpdateGameInfo(self)
	local gameRules = ChloeNet_GetGameRules()
	if gameRules == GR_DEFAULT then
		gameRules = Levels[ChloeNet_GetLevelId()].Rules or GR_RACE
	end
	
	if gameRules == GR_DERBY then
		W("eventtype"):SetTitle(WStringConcat(ChloeDerbyTypeNames[ChloeNet_GetDerbyType()], L":"))
	else
		W("eventtype"):SetTitle(WStringConcat(ChloeGameModeNames[gameRules], L":"))
	end
	
	local msg=L""
	
	if gameRules == GR_RACE then
		if ChloeNet_GetTrackReversed() then
			msg=GetPhrase(TRANSLATOR(RACETRACKTYPE_REVERSED))
			msg=WStringConcat(msg, L" ")
		end
	end
	
	if ChloeNet_GetIsFO2Track() and ChloeCollection_DoesTrackHaveFO2Variant(ChloeNet_GetLevelId()) then
		msg = WStringConcat(msg, L("FO2 "))
	end
	msg = WStringConcat(msg, L(Levels[ChloeNet_GetLevelId()].Name))
	if gameRules == GR_RACE or gameRules == GR_PONGRACE or gameRules == GR_SPEEDTRAP or gameRules == GR_LAPKNOCKOUT then
		if not Levels[ChloeNet_GetLevelId()].ForceOneLapOnly then
			msg = WStringConcat(msg, L(", "..ChloeNet_GetLapCount().." "))
			msg = WStringConcat(msg, MULTIPLAYER_LAPS)
		end
	elseif gameRules == GR_DERBY or gameRules == GR_TONYHAWK or gameRules == GR_DRIFT then
		msg = WStringConcat(msg, L(", "..ChloeNet_GetLapCount().." "))
		msg = WStringConcat(msg, MULTIPLAYER_MINUTES)
	end
	local numAI = ChloeNet_GetNumAI()
	if numAI > 0 then
		msg = WStringConcat(msg, L(", "..numAI.." AI"))
	end
	W("eventinfo"):SetTitle(msg)
	
	local havedetails = false
	W("eventnum_title"):HideWindow()
	W("eventnum"):HideWindow()
	
	if ChloeNet_IsLobbyInGame() and (gameRules == GR_RACE or gameRules == GR_PONGRACE or gameRules == GR_ARCADE_RACE or gameRules == GR_TONYHAWK or gameRules == GR_SPEEDTRAP or gameRules == GR_BEAT_THE_BOMB) then
		local highestLap = ChloeNet_GetHighestCurrentLap() + 1
		if highestLap > ChloeNet_GetLapCount() then
			W("progress_title"):SetTitle(L"FINISHED:")
			W("progress"):SetTitle(L(ChloeNet_GetNumPlayersFinished().."/"..ChloeNet_GetNumPlayersInGame()))
		else
			W("progress_title"):SetTitle(WStringConcat(INGAME_SCORE_LAP_TITLE, L":"))
			W("progress"):SetTitle(L(highestLap.."/"..ChloeNet_GetLapCount()))
		end
	elseif ChloeCustom_ShowRaceStatus(gameRules) then -- ChloeCustom: stunt round, derby cars and time left
	else
		W("progress_title"):HideWindow()
		W("progress"):HideWindow()
	end
	
	--if not ChloeNet_IsLobbyInGame() then
	--	W("progress_title"):HideWindow()
	--	W("progress"):HideWindow()
	--else
	--	havedetails = true
	--	if gameRules == GR_RACE or gameRules == GR_PONGRACE or gameRules == GR_ARCADE_RACE or gameRules == GR_BEAT_THE_BOMB then
	--		W("progress_title"):SetTitle(WStringConcat(INGAME_SCORE_LAP_TITLE, L":"))
	--		W("progress"):SetTitle(L(ChloeNet_GetPlayerCurrentLap(1).."/"..ChloeNet_GetLapCount()))
	--	elseif gameRules == GR_STUNT then
	--		W("progress_title"):SetTitle(WStringConcat(INGAME_ROUND, L":"))
	--		W("progress"):SetTitle(L(LatestSessionInfo.RaceStatus.Value1.."/"..LatestSessionInfo.RaceStatus.Value2))
	--	elseif gameRules == GR_DERBY and ChloeNet_GetDerbyType() == DERBY_WRECKING then
	--		W("progress_title"):SetTitle(WStringConcat(INGAME_REMAINING, L":"))
	--		msg = L(LatestSessionInfo.RaceStatus.Value1.."/"..LatestSessionInfo.RaceStatus.Value2.." ")
	--		msg = WStringConcat(msg, MULTIPLAYER_PLAYERS)
	--		msg = WStringConcat(msg, L(", "..LatestSessionInfo.RaceStatus.Value3.." "))
	--		msg = WStringConcat(msg, MULTIPLAYER_MINUTES)
	--		W("progress"):SetTitle(msg)
	--	elseif gameRules == GR_DERBY and ChloeNet_GetDerbyType() == DERBY_FRAG then
	--		W("progress_title"):SetTitle(WStringConcat(INGAME_REMAINING, L":"))
	--		msg = L(LatestSessionInfo.RaceStatus.Value3.." ")
	--		msg = WStringConcat(msg, MULTIPLAYER_MINUTES)
	--		W("progress"):SetTitle(msg)
	--	end
	--	W("progress_title"):ShowWindow()
	--	W("progress"):ShowWindow()
	--end
	
	if havedetails then
		W("sessiondetails_bd"):ShowWindow()
	else
		W("sessiondetails_bd"):HideWindow()
	end

	if ChloeNet_IsLobbyInGame() then
		local icon = wm.GetResource("steering_wheel")
		local win=wm.GetWindow("racestatus")
		local iconsize = wm.GetResourceSize(icon)
		local w,h = wm.GetTextExtents(W("eventtype"):GetTitle(), Layout.EventTypeFont)
		local x = Layout.EventTypePos[1] - w - iconsize[1] - 3
		win:SetPosition(x, Layout.EventTypePos[2] + 3)
		win:SetSize(iconsize[1], iconsize[2])
		win:AttachResource(icon)
		win:ShowWindow()	
	else
		wm.GetWindow("racestatus"):HideWindow()
	end
	
	wm.GetWindow("readycounter"):SetTitle(L(ChloeNet_GetNumPlayersReady().."/"..ChloeNet_GetNumPlayers().." READY"))
end

function ExitChloeMultiplayerLobby()
	local ok=function(value)
		ChloeCustomTourney_DialogOpen = false -- ChloeCustom Tourney
		if value == TRUE then
			ChloeCustom_SetPersistent("hostdefaults", nil) -- ChloeCustom
			ChloeCustom_SetPersistent("ghostbeforestunt", nil)
			if ChloeCustomTourney_Reset then ChloeCustomTourney_Reset() end -- ChloeCustom Tourney
			ChloeNet_Disconnect()
		else
			GUI:ShowMenuButtons()
			SetLobbyHelpButtons()
		end
	end

	GUI:HideMenuButtons()
	ChloeCustomTourney_DialogOpen = true -- ChloeCustom Tourney
	MessageBox(MULTIPLAYER_LOBBY_QUITGAME,MESSAGEBOX_YESNO,ok)
end

menu_chloemultiplayer_lobby = CreateMenuFromTemplate("template_multiplayer")
menu_chloemultiplayer_lobby.options.title=ICON_MULTIPLAYER_PC
menu_chloemultiplayer_lobby.back=ExitChloeMultiplayerLobby

function menu_chloemultiplayer_lobby.create(self)
	self.parent:create(self)
	if ChloeCustomTourney_CaptureResults then ChloeCustomTourney_CaptureResults() end -- ChloeCustom Tourney: results of the last race
	GameFlow.ClearRace()

	self:addResource("cup_next_race_elements.tga", cup_next_race_elements, cup_next_race_elements_size)
	self:addResource("xbox_controller.tga", xbox_controller, xbox_controller_size)
	self:addResource("garage_elements_2.tga", garage_elements_2, garage_elements_2_size)
	self:addResource("flags2.tga", flags2, flags2_size)
	
	self:loadResources()
end

local function SetArcadeRaceScore(race_nr)
	local num1 = (race_nr-1) / 6 + 1
	local num2 = math.mod(race_nr-1, 6) + 1
	ChloeNet_Stats_SetPlayerArcadeCareerEventScore(num1, num2, PlayerProfile:GetArcadeLevelScore(num1, num2))
end

local function SetDefaultCarForClass()
	local carClass = ChloeNet_GetCarClass()
	if carClass ~= CARCLASS_ANY then
		local carlist = GetCarListForCurrentClass()
		ChloeNet_SetPlayerCar(carlist[1].index)
		ChloeNet_SetPlayerCarSkin(1)
		SetBackgroundCar()
	end
end

function menu_chloemultiplayer_lobby.init(self)
	self.parent:init(self)

	ChloeCollection_SetIsInMultiplayer(1)
	ChloeCollection_SetCareerTimeTrial(0) -- ChloeCustom: no time trial flags left from single player
	
	ChloeNet_SetPlayerInLobby()
	ChloeNet_SetPlayerChangingOptions(0)
	ChloeNet_SetPlayerChangingTrack(0)
	ChloeNet_SetPlayerDriverType(ChloeCollection_GetCustomPlayerModelType())
	ChloeNet_SetPlayerDriverSkin(ChloeCollection_GetCustomPlayerModelSkinID())
	ChloeNet_SetPlayerPortraitId(Settings["Game"]["MPPortrait"] + 1)
	ChloeNet_SetPlayerColor(Settings["Game"]["ChatColor"] + 100)
	ChloeNet_SetPlayerFlag(Settings["Game"]["PlayerFlag"])
	ChloeNet_SetPlayerFlagSecret(Settings["Game"]["PlayerFlag2"])
	for i = 1, 4 do
		ChloeNet_SetFragDerbyRewards(i, ChloeCollection_GetFragDerbyRewardAmount(i))
	end
	ChloeNet_SetInterpolationEnabled(Settings["Network"]["Interpolation"])
	ChloeNet_Stats_SetPlayerArcadeCareerScore(PlayerProfile:GetArcadeTotalScore())
	
	if Settings["Network"]["JoinNotifs"] then
		ChloeNet_SetJoinNotifs(1)
	else
		ChloeNet_SetJoinNotifs(0)
	end
	
	-- ChloeCustom: defaults for a new hosted game (handling FLATOUT 2, AI class SAME AS HOST, 0.5x damage)
	if ChloeNet_IsServer() and ChloeCustom_GetPersistent("hostdefaults") == nil then
		ChloeCustom_SetPersistent("hostdefaults", "1")
		ChloeNet_Host_SetHandlingMode(HANDLING_NORMAL_FO2DOWNFORCE)
		ChloeNet_Host_SetAIClass(4)
		ChloeNet_Host_SetDamageMult(0.5)
	end
	if ChloeNet_IsServer() then
		if ChloeNet_IsUsingZMenu() or Settings["Network"]["AllowCheats"] then
			ChloeNet_Host_SetZMenuAllowed(1)
		else
			ChloeNet_Host_SetZMenuAllowed(0)
		end
	end

	local nr = 1
	for row_nr, row in ipairs(ArcadeClasses) do
		for race_nr, race in ipairs(row.Races) do
			SetArcadeRaceScore(nr)
			nr = nr + 1
		end
	end
	
	if not IsPlayerCarValidForClass() then
		SetDefaultCarForClass()
	end
	
	SetBackgroundCar()
	MenuScene:CameraRotate(TRUE)
	MenuScene:AllowCameraRotate(TRUE)
	BuildLobbyMenuButtons()

	local res = self:getResource("cup_title_bd")
	Frame { Position=Layout.TitleFramePos, Size=Layout.TitleFrameSize }:AttachResource(res)
	StaticText { Title=TITLE_LIVE_LOBBY, Font=fonttitle(), Color=Layout.TitleColor, Position=Layout.TitlePos, Size=Layout.TitleSize, Align=FONTF_CENTER }
	
	res = self:getResource("optim_event_bd")
	Frame { Position=Layout.EventFramePos, Size=Layout.EventFrameSize }:AttachResource(res)
	local eventtype = StaticText { Name="eventtype", Font=Layout.EventTypeFont, Color=Layout.EventTypeColor, Position=Layout.EventTypePos, Size=Layout.EventTypeSize, Align=FONTF_RIGHT }
	local eventinfo = StaticText { Name="eventinfo", Font=fontlarge(), Color=Layout.EventInfoColor, Position=Layout.EventInfoPos, Size=Layout.EventInfoSize }

	Frame { Name="racestatus", Position=POS(0, 0), Size=SIZE(0, 0), Layer=2 }
	Frame { Name="progressbar_bg", Position=Layout.ProgressBarPos, Size=Layout.ProgressBarSize, DrawBackgroundColor=TRUE, Layer=1 } : AttachResource(self:getResource("black50_bd"))
	res  = self:getResource("general_timer_fill")
	Frame { Name="progressbar", Position=Layout.ProgressBarPos, Size=Layout.ProgressBarSize, Layer=2 }:AttachResource(res)

	wm.GetWindow("progressbar"):HideWindow()
	wm.GetWindow("progressbar_bg"):HideWindow()
	
	res = self:getResource("black50_bd")
	Frame { Name="sessiondetails_bd", Position=Layout.SessionDetailsFramePos, Size=Layout.SessionDetailsFrameSize }:AttachResource(res)
	local eventnum_title = StaticText { Name="eventnum_title", Font=fontsmall(), Color=Layout.DetailsTitleColor, Position=Layout.EventNumTitlePos, Size=Layout.EventNumTitleSize, Align=FONTF_RIGHT }
	StaticText { Name="progress_title", Font=fontsmall(), Color=Layout.DetailsTitleColor, Position=Layout.ProgressTitlePos, Size=Layout.ProgressTitleSize, Align=FONTF_RIGHT }
	StaticText { Name="eventnum", Font=fontsmall(), Color=Layout.DetailsColor, Position=Layout.EventNumPos, Size=Layout.EventNumSize, Parent=frame }
	StaticText { Name="progress", Font=fontsmall(), Color=Layout.DetailsColor, Position=Layout.ProgressPos, Size=Layout.ProgressSize, Parent=frame }
	
	eventnum_title:SetTitle(WStringConcat(MULTIPLAYER_EVENT, L":"))
	eventinfo:SetTitle(L"")
	
	local msg = StaticText { Name="msg", Position=Layout.LobbyMessagePos, Size=Layout.LobbyMessageSize, Font=Layout.LobbyMessageFont, Color=GetPaletteColor(1), TitleCentering=TITLECENTER_Y, Align=FONTF_CENTER, Layer=2 }
	
	local labelTemplate={
		Font=Layout.LabelFont,
		Position=POS(0, Layout.LabelTop), 
		Size=SIZE(Layout.LabelWidth, Layout.LabelHeight),
		Layer=2,
	}

	labelTemplate.Name="readycounter"
	labelTemplate.Title=L(ChloeNet_GetNumPlayersReady().."/"..ChloeNet_GetNumPlayers().." READY")
	labelTemplate.Position=POS(Layout.ReadyX-12, Layout.LabelTop)
	StaticText(labelTemplate):SetColor(Layout.LabelColor, false)

	labelTemplate.Name=nil
	labelTemplate.Title=TRANSLATOR(MULTIPLAYER_GAMERTAG)
	labelTemplate.Position=POS(Layout.NameLeft, Layout.LabelTop)
	StaticText(labelTemplate):SetColor(Layout.LabelColor, false)

	labelTemplate.Position = POS(Layout.CarLeft, Layout.LabelTop)
	labelTemplate.Title=MULTIPLAYER_CAR
	StaticText(labelTemplate):SetColor(Layout.LabelColor, false)

	labelTemplate.Position = POS(Layout.UpgradesX, Layout.LabelTop)
	labelTemplate.Title=L"PING"
	labelTemplate.Name="chloecustom_pingheader" -- ChloeCustom Tourney: "PTS (PING)" during a tournament
	StaticText(labelTemplate):SetColor(Layout.LabelColor, false)
	labelTemplate.Name=nil
	
	--local maxpl = ChloeNet_GetMaxPlayers()
	local maxpl = NUMPLAYERS_LOBBYLIST
	
	local pos = LEFTPOS(0, Layout.ListTop)
	for i = 1, maxpl do
		local w = Frame { Name="rowbg_row"..i, Position=pos, Size=SIZE(Layout.ListWidth, Layout.RowHeight), DrawBackgroundColor=TRUE, Layer=1 }
		w:SetColor({0,0,0,0.5*MAX_VERTEXCOLOR_A}, false)
		pos[2] = pos[2] + Layout.RowHeight + Layout.RowPadding
	end
	
	local trueskillLeft = Layout.TrueSkillCenter - GetResourceSize(self:getResource("trueskill_bd"))[1] / 2
	
	local listboxParams={
		ListBoxTemplate={Name="list", Layer=2},
		Left=Layout.ListLeft,
		Top=Layout.ListTop,
		LeftPadding=0,
		RightPadding=0,
		TopPadding=0,
		BottomPadding=0,
		RowWidth=Layout.ListWidth,
		RowHeight=Layout.RowHeight,
		RowPadding=Layout.RowPadding,
		RowTemplate={Layer=2},
		RowTemplateType="Frame",
		RowTemplateCust=function(Row, RowNr)
		end,
		NumRows=ChloeNet_GetMaxPlayers(),
		--NumRows=NUMPLAYERS_LOBBYLIST,
		Coloumns={
			{
			Name="flag", -- _row# is added
			ColoumnTemplate={Position=POS(Layout.FlagLeft, Layout.FlagTop), Size=wm.GetResourceSize("check_mark"), Layer=2},
			ColoumnTemplateType="Frame",
			ColoumnTemplateCust=function(Coloumn, RowNr, ColoumnNr)
			end
			},
			{
			Name="readyfill", -- _row# is added
			ColoumnTemplate={Position=POS(Layout.ReadyX, Layout.ReadyTop), Size=wm.GetResourceSize("check_mark"), Layer=2},
			ColoumnTemplateType="Frame",
			ColoumnTemplateCust=function(Coloumn, RowNr, ColoumnNr)
			end
			},			
			{
			Name="readyicon", -- _row# is added
			ColoumnTemplate={Position=POS(Layout.ReadyX, Layout.ReadyTop), Size=wm.GetResourceSize("check_mark"), Layer=2},
			ColoumnTemplateType="Frame",
			ColoumnTemplateCust=function(Coloumn, RowNr, ColoumnNr)
			end
			},
			{
			Name="voiceicon", -- _row# is added
			ColoumnTemplate={Position=POS(Layout.VoiceLeft, Layout.VoiceTop), Size=wm.GetResourceSize("xbox_voice_communicator"), Layer=2},
			ColoumnTemplateType="Frame",
			ColoumnTemplateCust=function(Coloumn, RowNr, ColoumnNr)
			end
			},
			{
			Name="playername", -- _row# is added
			ColoumnTemplate={Position=POS(Layout.NameLeft, -1), Size=SIZE(Layout.LabelWidth, Layout.RowHeight), Font=Layout.ListFont, Layer=2},
			ColoumnTemplateType="StaticText",
			ColoumnTemplateCust=function(Coloumn, RowNr, ColoumnNr)
				Coloumn:SetColor(Layout.ListFontColor, false)
			end
			},		
			{
			Name="car", -- _row# is added
			ColoumnTemplate={Position=POS(Layout.CarLeft, -1), Size=SIZE(Layout.LabelWidth, Layout.RowHeight), Font=Layout.ListFont, Layer=2},
			ColoumnTemplateType="StaticText",
			ColoumnTemplateCust=function(Coloumn, RowNr, ColoumnNr)
				Coloumn:SetColor(Layout.ListFontColor, false)
			end
			},
			{
			Name="upgrades", -- _row# is added
			ColoumnTemplate={Position=POS(Layout.UpgradesX, -1), Size=SIZE(100,14), Font=Layout.ListFont, Layer=2},
			ColoumnTemplateType="StaticText",
			ColoumnTemplateCust=function(Coloumn, RowNr, ColoumnNr)
				Coloumn:SetColor(Layout.ListFontColor, false)
			end
			},	
			{
			Name="trueskillbg", -- _row# is added
			ColoumnTemplate={Position=POS(trueskillLeft, 0), Size=GetResourceSize(self:getResource("trueskill_bd")), Layer=2},
			ColoumnTemplateType="Frame",
			ColoumnTemplateCust=function(Coloumn, RowNr, ColoumnNr)
				Coloumn:AttachResource(self:getResource("trueskill_bd"))
			end
			},
			{
			Name="trueskill_blue", -- _row# is added
			ColoumnTemplate={Position=POS(trueskillLeft + 1, 1), Size=SIZE(Layout.TrueSkillWidth, Layout.TrueSkillHeight), Layer=2},
			ColoumnTemplateType="Frame",
			ColoumnTemplateCust=function(Coloumn, RowNr, ColoumnNr)
				Coloumn:AttachResource(self:getResource("trueskill_blue_fill"))
			end
			},	
			{
			Name="trueskill_red", -- _row# is added
			ColoumnTemplate={Position=POS(trueskillLeft + 1, 1), Size=SIZE(30, 14), Layer=2},
			ColoumnTemplateType="Frame",
			ColoumnTemplateCust=function(Coloumn, RowNr, ColoumnNr)
				Coloumn:AttachResource(self:getResource("trueskill_red_fill"))
			end
			},	
			{
			Name="trueskill_text", -- _row# is added
			ColoumnTemplate={Font=Layout.TrueSkillFont, Position=POS(trueskillLeft + 3, 0), Size=SIZE(30, 14), Layer=2},
			ColoumnTemplateType="StaticText",
			ColoumnTemplateCust=function(Coloumn, RowNr, ColoumnNr)
				Coloumn:SetColor(Layout.TrueSkillColor, false)
			end
			},
		}
	}

	local list=CreateMultiColoumnListBox(listboxParams)
	list.onNeedData=function(Self, RowObject, RowNr, ControlRowNr)
		local rowbg=wm.GetWindow(string.format("rowbg_row%i", RowNr))
		local ready=wm.GetWindow(string.format("readyicon_row%i", RowNr))
		local readyfill=wm.GetWindow(string.format("readyfill_row%i", RowNr))
		local voice=wm.GetWindow(string.format("voiceicon_row%i", RowNr))
		local name=wm.GetWindow(string.format("playername_row%i", RowNr))
		local car=wm.GetWindow(string.format("car_row%i", RowNr))
		local upgrades=wm.GetWindow(string.format("upgrades_row%i", RowNr))
		local tsbg=wm.GetWindow(string.format("trueskillbg_row%i", RowNr))
		local tsred=wm.GetWindow(string.format("trueskill_red_row%i", RowNr))
		local tsblue=wm.GetWindow(string.format("trueskill_blue_row%i", RowNr))
		local tstxt=wm.GetWindow(string.format("trueskill_text_row%i", RowNr))
		local flag=wm.GetWindow(string.format("flag_row%i", RowNr))
		if not rowbg then
			return
		end
		
		local playerId = RowNr+PLAYERLIST_SCROLL
		
		local c,a
		if (Mode == SELECT_PLAYER or Mode == PLAYER_OPTIONS) and RowNr == list:GetSelectedRow() then
			c = GetPaletteColor(14)
			if Mode == SELECT_PLAYER then
				a = rowbg:GetColor(true)[4]
			else
				a = 0.5
			end
		else
			c = {0,0,0}
			a = 0.5
		end
		
		local headsetConnected=false
		local isTalking=false
		local voiceThroughSpeakers=false
			
		if not ChloeNet_IsPlayerValid(playerId) or RowNr > NUMPLAYERS_LOBBYLIST then
			rowbg:SetColor({0,0,0,0.3*MAX_VERTEXCOLOR_A}, false)
			ready:HideWindow()
			voice:HideWindow()
			tsbg:HideWindow()
			tsblue:HideWindow()
			tsred:HideWindow()
			tstxt:HideWindow()
			flag:HideWindow()
			name:SetTitle(L"")
			car:SetTitle(L"")
			upgrades:SetTitle(L"")
		else
			rowbg:SetColor({c[1],c[2],c[3],a*MAX_VERTEXCOLOR_A}, false)
			
			name:SetTitle(EscapeString(ChloeNet_GetPlayerName(playerId)))
			
			local r,g,b=ChloeNet_GetPlayerColor(playerId)
			name:SetColor({r,g,b,1.0*MAX_VERTEXCOLOR_A}, false)
		
			local icon = nil
			local voiceIcon = nil
			if ChloeNet_IsPlayerInGame(playerId) then
				icon = wm.GetResource("steering_wheel")
			else
				if playerId == 1 then -- host player
					icon = wm.GetResource("yellow_star")
				elseif ChloeNet_IsPlayerReady(playerId) then
					icon = wm.GetResource("check_mark")
				end
			end
			
			local ping = ChloeNet_GetPlayerPing(playerId)
			if ChloeCustomTourney_RowText then -- ChloeCustom Tourney: points of the player
				upgrades:SetTitle(ChloeCustomTourney_RowText(playerId, ping))
			else
				upgrades:SetTitle(ConvertToWString(ping))
			end
			if ChloeNet_IsPlayerChatting(playerId) then
				voiceIcon = wm.GetResource("xbox_talking")
			end
			
			
			if icon then
				local iconsize = wm.GetResourceSize(icon)
				ready:SetPosition(Layout.ReadyX - iconsize[1] / 2, Layout.ReadyTop)
				ready:SetSize(iconsize[1], iconsize[2])
				ready:AttachResource(icon)
				ready:ShowWindow()
			else
				ready:HideWindow()
			end
			
			if voiceIcon then
				local iconsize = wm.GetResourceSize(voiceIcon)
				voice:SetPosition(Layout.VoiceCenterX - iconsize[1] / 2, Layout.VoiceTop)
				voice:SetSize(iconsize[1], iconsize[2])
				voice:AttachResource(voiceIcon)
				voice:ShowWindow()
			else
				voice:HideWindow()
			end
			
			local flagRes = GetPlayerFlagResource(self, ChloeNet_GetPlayerFlag(playerId), ChloeNet_GetPlayerFlagSecret(playerId))
			if flagRes then
				local flagSize=GetResourceSize(flagRes)
				flag:SetSize(flagSize[1], flagSize[2])
				flag:AttachResource(flagRes)
				flag:ShowWindow()
			else
				flag:HideWindow()
			end
			
			readyfill:HideWindow()
			
			if ChloeNet_IsPlayerChangingOptions(playerId) then 
				car:SetTitle(L"CHANGING OPTIONS")
				car:SetColor(Layout.CarChangingFontColor, false)
			elseif ChloeNet_IsPlayerChangingTrack(playerId) then 
				car:SetTitle(L"CHANGING TRACK")
				car:SetColor(Layout.CarChangingFontColor, false)
			elseif ChloeNet_IsPlayerChangingCar(playerId) then 
				car:SetTitle(MULTIPLAYER_CHANGINGCAR)
				car:SetColor(Layout.CarChangingFontColor, false)
			else
				local cardata = db.FlatOut2.Cars:GetProperty("Car", ChloeNet_GetPlayerCar(playerId))
				car:SetTitle(L(cardata.Name))
				car:SetColor(Layout.ListFontColor, false)
			end
			
			tsbg:HideWindow()
			tsblue:HideWindow()
			tsred:HideWindow()
			tstxt:HideWindow()
		end
	end
	
	wm.GetWindow("list"):SetNumRows(NUMPLAYERS_LOBBYLIST)
	
	LobbyMessages			= { }
	
	if ChloeNet_IsServer() and not ChloeNet_HasPortWarningBeenShown() and (ChloeSteam_IsAvailable == nil or not ChloeSteam_IsAvailable()) then -- ChloeCustom
		MessageBox(L("Note: To host a multiplayer game, you have to forward UDP port 23756 on your router."),MESSAGEBOX_OK,function() end)
	end
	
	GUI:ShowMenuButtons()
	SetLobbyHelpButtons()
end
function menu_chloemultiplayer_lobby.deinit(self)
	self.parent:deinit(self)
	
	LobbyMessages = { }
end
function menu_chloemultiplayer_lobby.update(self, time)
	self.parent:update(self, time)
	
	if ChloeNet_IsConnected() then		
		wm.GetWindow("list"):SetNumRows(NUMPLAYERS_LOBBYLIST)
		UpdateGameInfo(self)
		if ChloeCustomTourney_LobbyUpdate then ChloeCustomTourney_LobbyUpdate(self, time, Mode == LOBBY) end -- ChloeCustom Tourney
		
		if Mode == SELECT_PLAYER then
			local numplayers = ChloeNet_GetNumPlayers()
			if PrevNumPlayers > numplayers then
				local found = false
				for i = 1, numplayers do
					if ChloeNet_GetPlayerName(i) == SelectedPlayerPeerId then
						found = true
					end
				end
				if found then
					wm.GetWindow("list"):SetSelectedRow(i)
					SetSelectPlayerButtons()
				else
					SetSelectPlayerButtons()
				end
				local win=wm.GetWindow("selectplayer_handler")
				if win then
					wm.SetFocus(win)
				end
				
			end
			
			if not SelectedPlayerValid then
				local selected = wm.GetWindow("list"):GetSelectedRow()+PLAYERLIST_SCROLL
				if ChloeNet_IsPlayerValid(selected) then
					SetSelectPlayerButtons()
				end
			end
		else
			local win=wm.GetWindow("lobbyscroll_handler")
			if win then
				wm.SetFocus(win)
			end
		end
		PrevNumPlayers = ChloeNet_GetNumPlayers()
		
		if ChloeNet_GetTuningAvailable() then
			ChloeTuning_SetEnabledForMultiplayer(1)
			ChloeTuning_SetActiveCarForMultiplayer(ChloeNet_GetLocalPlayerCar())
		else
			ChloeTuning_SetEnabledForMultiplayer(0)
		end
		
		ChloeCollection_SetHandlingMode(ChloeNet_GetHandlingMode())
		
		if ChloeNet_GetIsFO2Track() then
			ChloeCollection_SetTrackFO2Variant(1)
		else
			ChloeCollection_SetTrackFO2Variant(0)
		end
		
		if ChloeNet_GetGameRules() == GR_TONYHAWK then
			ChloeCollection_SetSpeedtrapMode(0)
			ChloeCollection_SetDriftMode(0)
			ChloeCollection_SetLapKnockoutMode(0)
			
			ChloeCollection_SetStuntSimpleUI(1)
			ChloeCollection_SetStuntTime(ChloeNet_GetLapCount())
			ChloeCollection_SetStuntHandling(1)
			ChloeCollection_SetStuntMode(1)
		elseif ChloeNet_GetGameRules() == GR_SPEEDTRAP then
			ChloeCollection_SetStuntMode(0)
			ChloeCollection_SetDriftMode(0)
			ChloeCollection_SetLapKnockoutMode(0)
			
			ChloeCollection_SetSpeedtrapSimpleUI(1)
			ChloeCollection_SetSpeedtrapMode(1)
		elseif ChloeNet_GetGameRules() == GR_DRIFT then
			ChloeCollection_SetStuntMode(0)
			ChloeCollection_SetSpeedtrapMode(0)
			ChloeCollection_SetLapKnockoutMode(0)
			
			ChloeCollection_SetDriftSimpleUI(1)
			ChloeCollection_SetDriftTime(ChloeNet_GetLapCount())
			ChloeCollection_SetDriftMode(1)
		elseif ChloeNet_GetGameRules() == GR_LAPKNOCKOUT then
			ChloeCollection_SetStuntMode(0)
			ChloeCollection_SetSpeedtrapMode(0)
			ChloeCollection_SetDriftMode(0)
			
			ChloeCollection_SetLapKnockoutMode(1)
		elseif ChloeNet_GetGameRules() == GR_KNOCKOUT then
			ChloeCollection_SetStuntMode(0)
			ChloeCollection_SetSpeedtrapMode(0)
			ChloeCollection_SetDriftMode(0)
			
			ChloeCollection_SetTimedKnockoutMode(1)
		else
			ChloeCollection_SetStuntMode(0)
			ChloeCollection_SetSpeedtrapMode(0)
			ChloeCollection_SetDriftMode(0)
			ChloeCollection_SetLapKnockoutMode(0)
		end
		
		ChloeCollection_SetAirControlMode(ChloeNet_GetAirControl())
		
		if ChloeNet_HasAnyPlayerLeft() then
			local msg = WStringConcat(ChloeNet_GetLeftPlayerName(), L" ")
			msg = WStringConcat(msg, MULTIPLAYER_LEFTLOBBY)
			AddLobbyMessage(msg, GetPaletteColor(33), LOBBY_CONNECT_MESSAGE_TIME, ANIM_FADEOUT)
		end
		
		if ChloeNet_HasAnyPlayerJoined() then
			local msg = WStringConcat(ChloeNet_GetJoinedPlayerName(), L" ")
			msg = WStringConcat(msg, MULTIPLAYER_JOINEDTHELOBBY)
			AddLobbyMessage(msg, GetPaletteColor(33), LOBBY_CONNECT_MESSAGE_TIME, ANIM_FADEOUT)
		end
		
		if not ChloeNet_IsServer() and ChloeNet_HaveGameOptionsJustChanged() then
		--if ChloeNet_HaveGameOptionsJustChanged() then
			if not ChloeNet_IsServer() then
				AddLobbyMessage(MULTIPLAYER_HOSTCHANGEOPTIONS, GetPaletteColor(33), LOBBY_OPTIONSCHANGED_MESSAGE_TIME, ANIM_BLINK)
			end
			ChloeNet_SetPlayerReady(0)
			BuildLobbyMenuButtons()
		end
		
		if PLAYERLIST_SCROLL > ChloeNet_GetNumPlayers() - NUMPLAYERS_LOBBYLIST then
			PLAYERLIST_SCROLL = ChloeNet_GetNumPlayers() - NUMPLAYERS_LOBBYLIST
		end
		if PLAYERLIST_SCROLL < 0 then
			PLAYERLIST_SCROLL = 0
		end
		
		-- update car based on the new car class
		if ChloeNet_HasCarClassJustChanged() and not IsPlayerCarValidForClass() then
			SetDefaultCarForClass()
			ChloeNet_SetPlayerCarSkin(1)
		end
	
		if ChloeNet_IsClient() and ChloeNet_GetCarClass() >= CARCLASS_SAMEASHOST then
			local hostCar = ChloeNet_GetPlayerCar(1)
			local hostCarMatchup = ChloeCollection_GetCarMatchup(hostCar)
			if hostCarMatchup == nil then
				hostCarMatchup = ChloeCollection_GetCarMatchupInverse(hostCar)
			end
			if ChloeNet_GetLocalPlayerCar() ~= hostCar and (not hostCarMatchup or ChloeNet_GetLocalPlayerCar() ~= hostCarMatchup) then
				ChloeNet_SetPlayerCar(ChloeNet_GetPlayerCar(1))
				ChloeNet_SetPlayerCarSkin(1)
				SetBackgroundCar()
			end
		end
	
		if table.getn(LobbyMessages) > 0 then
			local msgwin = wm.GetWindow("msg")
			local curmsg = LobbyMessages[table.getn(LobbyMessages)]
			while curmsg~=nil and curmsg.title==nil do
				table.remove(LobbyMessages)
				curmsg = LobbyMessages[table.getn(LobbyMessages)]
			end
			if curmsg~=nil then
				if curmsg.showtime == nil then
					curmsg.showtime = time
					msgwin:SetTitle(curmsg.title)
					msgwin:SetColor(curmsg.color, false)
				end
				if curmsg.duration ~= LOBBY_PERMANENT_MESSAGE and time > curmsg.showtime + curmsg.duration then
					table.remove(LobbyMessages)
					if table.getn(LobbyMessages) > 0 then
						curmsg = LobbyMessages[table.getn(LobbyMessages)]
						curmsg.showtime = time
						msgwin:SetTitle(curmsg.title)
						msgwin:SetColor(curmsg.color, false)
					else
						msgwin:SetTitle(L"")
					end
				else
					local c = curmsg.color
					local a
					if curmsg.animtype == ANIM_BLINK then
						local d = math.mod(time - curmsg.showtime, 1.0)
						a = math.floor(d + 0.5) * MAX_VERTEXCOLOR_A
						msgwin:SetColor({c[1],c[2],c[3],a}, false)
					elseif curmsg.animtype == ANIM_PULSE then
						a = (0.75 + 0.25 * (math.cos((time - curmsg.showtime) * 3.141592 * 2) + 1.0) / 2) * MAX_VERTEXCOLOR_A
						msgwin:SetColor({c[1],c[2],c[3],a}, false)
					elseif curmsg.animtype == ANIM_FADEOUT then
						local fadestart = curmsg.showtime + curmsg.duration - LOBBY_MESSAGE_FADE_TIME
						if time >= fadestart then
							local t = (time - fadestart) / LOBBY_MESSAGE_FADE_TIME
							a = (1 - t) * MAX_VERTEXCOLOR_A
							msgwin:SetColor({c[1],c[2],c[3],a}, false)
						end
					end
				end
			else
				msgwin:SetTitle(L"")
			end
		end
		
	-- drop back to multiplayer main if disconnected
	else
		ChloeNet_Stats_Save()
		if ChloeCustomTourney_Reset then ChloeCustomTourney_Reset() end -- ChloeCustom Tourney
		ChloeCustom_SetPersistent("hostdefaults", nil) -- ChloeCustom
		ChloeCustom_SetPersistent("ghostbeforestunt", nil)
		EnterMenu("menu_chloemultiplayer")
	end
end