local function SetBackgroundCar()
	if ChloeNet_GetLocalPlayerCarSkin() > ChloeSkins_GetNumSkinsForCar(ChloeNet_GetLocalPlayerCar()) then
		ChloeNet_SetPlayerCarSkin(1)
	end
	UpdateCarInfo(ChloeNet_GetLocalPlayerCar(), menu_chloemultiplayer_lobby, false, ChloeNet_GetLocalPlayerCarSkin())
end

local function SetRandomCar()
	local carlist = GetCarListForCurrentClass()
	
	local car = carlist[ChloeCollection_GetRandom(table.getn(carlist))+1].index
	if ChloeCollection_GetCarMatchup(car) ~= nil and ChloeCollection_GetRandom(2) == 1 then
		car = ChloeCollection_GetCarMatchup(car)
	end
	local skin = ChloeCollection_GetRandom(ChloeSkins_GetNumSkinsForCar(car))+1
	ChloeNet_SetPlayerCar(car)
	ChloeNet_SetPlayerCarSkin(skin)
	if ChloeNet_IsServer() and ChloeNet_GetCarClass() >= CARCLASS_SAMEASHOST then
		ChloeNet_Host_SetCarClass(car + CARCLASS_SAMEASHOST)
	end
	SetBackgroundCar()
end

local function AddLobbyMessage(title_, color_, duration_, animtype_)
	local lobbymsg = { title = title_, color = color_, duration = duration_, animtype = animtype_ }
	if duration_ == LOBBY_PERMANENT_MESSAGE then
		if LobbyMessages[1]==nil or LobbyMessages[1].duration~=LOBBY_PERMANENT_MESSAGE then
			table.insert(LobbyMessages, 1, lobbymsg)
		elseif	LobbyMessages[1].title~=lobbymsg.title then
			LobbyMessages[1]=lobbymsg
		end
	else
		if table.getn(LobbyMessages) > MaxLobbyMessages - 1 then
			table.remove(LobbyMessages, table.getn(LobbyMessages) - 1)
		end
		if table.getn(LobbyMessages) > 0 then
			table.insert(LobbyMessages, LobbyMessages[1].duration == LOBBY_PERMANENT_MESSAGE and 2 or 1, lobbymsg)
		else
			table.insert(LobbyMessages, 1, lobbymsg)
		end
	end
end

local function RemovePermanentLobbyMessage()
	if LobbyMessages[1] ~= nil and LobbyMessages[1].duration == LOBBY_PERMANENT_MESSAGE then
		LobbyMessages[1].duration=0
		LobbyMessages[1].showtime=0
	end
end

