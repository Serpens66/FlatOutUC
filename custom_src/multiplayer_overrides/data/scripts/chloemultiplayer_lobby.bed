local function IsCarUnfairBonus(carId)
	local car = db.FlatOut2.Cars:GetProperty("Car", carId)
	if string.find(car:GetFullPath(), ".PropMedium")~=nil then return true end
	if string.find(car:GetFullPath(), ".PropHeavy")~=nil then return true end
	
	if carId == CarIndex.Pimpster then return true end
	if carId == CarIndex.Flatmobile then return true end
	--if carId == CarIndex.MobCar then return true end
	if carId == CarIndex.SchoolBus then return true end
	if carId == CarIndex.StarflightSS then return true end
	if carId == CarIndex.TrailblazerSS then return true end
	if carId == CarIndex.AfterburnerSS then return true end
	if carId == CarIndex.RocketSS then return true end
	if carId == CarIndex.NucleonSS then return true end
	if carId == CarIndex.Truck then return true end
	if carId == CarIndex.PropForklift then return true end
	if carId == CarIndex.PropRoller then return true end
	if carId == CarIndex.PropChassis then return true end
	if carId == CarIndex.Freeman then return true end
	return false
end

local function GetCarListForCurrentClass(skipProps)
	local carlist = { }
	local carclass = ChloeNet_GetCarClass()
	local hostCar = ChloeNet_GetPlayerCar(1)
	
	local hostCarMatchup = ChloeCollection_GetCarMatchupInverse(hostCar)
	if hostCarMatchup ~= nil then
		hostCar = hostCarMatchup
	end
	
	local nitroMult = ChloeNet_GetNitroMult()
	
	local gameRules = ChloeNet_GetGameRules()
	if gameRules == GR_DEFAULT then
		gameRules = Levels[ChloeNet_GetLevelId()].Rules or GR_RACE
	end
	
	local propCarsEnabled = ChloeNet_GetPropCarsAvailable()
	local validCarFunc = IsValidCarNoTemp350
	if propCarsEnabled and skipProps then
		validCarFunc = IsValidCarIncludeTemp350NoProps
	elseif propCarsEnabled and not skipProps then
		validCarFunc = IsValidCarIncludeTemp350
	end
	
	local function SplitString(str)
		local t={}		
		for w in string.gfind(str,"(%w+)%.?") do
			table.insert(t,w)
		end
		return t
	end
	
	if gameRules == GR_STUNT then
		-- Only stunt cars are valid in stunt events
		if carclass >= CARCLASS_SAMEASHOST and not ChloeNet_IsServer() then
			carlist = { { index = hostCar } }
		else
			carlist = CarlistStuntCars()
		end
	elseif carclass == CARCLASS_ANY then
		-- Any car; includes derby, racing, street and bonus cars
		for i=0,db.FlatOut2.Cars:GetPropertyArraySize("Car")-1 do
			if validCarFunc(i) then
				table.insert(carlist,{ index=i })
			end
		end
	elseif carclass == CARCLASS_NOBONUS then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			local path = SplitString(string.lower(car:GetFullPath()))

			if path[3] ~= "bonus" and validCarFunc(i) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_BONUS then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			local path = SplitString(string.lower(car:GetFullPath()))

			if path[3] == "bonus" and validCarFunc(i) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_STUNT then
		carlist = CarlistStuntCars()
	elseif carclass == CARCLASS_FO1ANY then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)

			if string.find(car:GetFullPath(), "FO1")~=nil and validCarFunc(i) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_FO1DERBY then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			local path = SplitString(string.lower(car:GetFullPath()))

			if string.find(car:GetFullPath(), "FO1")~=nil and path[3] == "beginner" and validCarFunc(i) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_FO1RACING then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			local path = SplitString(string.lower(car:GetFullPath()))

			if string.find(car:GetFullPath(), "FO1")~=nil and path[3] == "amateur" and validCarFunc(i) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_FO1STREET then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			local path = SplitString(string.lower(car:GetFullPath()))

			if string.find(car:GetFullPath(), "FO1")~=nil and path[3] == "professional" and validCarFunc(i) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_RETRODEMO then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)

			if string.find(car:GetFullPath(), ".Retro")~=nil and IsValidCarIncludeMatchups(i) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_TOUGHTRUCKS then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)

			if string.find(car:GetFullPath(), ".TT")~=nil then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_RTANY then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)

			if string.find(car:GetFullPath(), ".RT")~=nil and validCarFunc(i) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_RTDERBY then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			local path = SplitString(string.lower(car:GetFullPath()))

			if string.find(car:GetFullPath(), ".RT")~=nil and path[3] == "beginner" and validCarFunc(i) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_RTRACING then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			local path = SplitString(string.lower(car:GetFullPath()))

			if string.find(car:GetFullPath(), ".RT")~=nil and path[3] == "amateur" and validCarFunc(i) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_RTSTREET then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			local path = SplitString(string.lower(car:GetFullPath()))

			if string.find(car:GetFullPath(), ".RT")~=nil and path[3] == "professional" and validCarFunc(i) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_BONUSSTUNT then
		table.insert(carlist, { index = CarIndex.StarflightSS })
		table.insert(carlist, { index = CarIndex.TrailblazerSS })
		table.insert(carlist, { index = CarIndex.AfterburnerSS })
		table.insert(carlist, { index = CarIndex.RocketSS })
		table.insert(carlist, { index = CarIndex.NucleonSS })
	elseif carclass == CARCLASS_FWD or carclass == CARCLASS_FWDNOBONUS then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			if carclass ~= CARCLASS_FWDNOBONUS or not IsCarUnfairBonus(i) then
				if car.Body.FrontTraction and not car.Body.RearTraction and validCarFunc(i) then
					table.insert(carlist, {index = i})
				end
			end
		end
	elseif carclass == CARCLASS_RWD or carclass == CARCLASS_RWDNOBONUS then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			if carclass ~= CARCLASS_RWDNOBONUS or not IsCarUnfairBonus(i) then
				if car.Body.RearTraction and not car.Body.FrontTraction and validCarFunc(i) then
					table.insert(carlist, {index = i})
				end
			end
		end
	elseif carclass == CARCLASS_4WD or carclass == CARCLASS_4WDNOBONUS then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			if carclass ~= CARCLASS_4WDNOBONUS or not IsCarUnfairBonus(i) then
				if car.Body.RearTraction and car.Body.FrontTraction and validCarFunc(i) then
					table.insert(carlist, {index = i})
				end
			end
		end
	elseif carclass == CARCLASS_PROPS then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			if ((string.find(car:GetFullPath(), ".Prop")~=nil and IsValidCarIncludeTemp350(i)) or ChloeCollection_DoesCarHaveCheatCode(i)) and not ChloeCollection_GetCarMatchupInverse(i) and (propCarsEnabled or i ~= CarIndex.Freeman) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_PROPSLIGHT then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			if ((string.find(car:GetFullPath(), ".PropLight")~=nil and IsValidCarIncludeTemp350(i)) or ChloeCollection_DoesCarHaveCheatCode(i)) and not ChloeCollection_GetCarMatchupInverse(i) and (propCarsEnabled or i ~= CarIndex.Freeman) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_PROPSMEDIUM then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			if string.find(car:GetFullPath(), ".PropMedium")~=nil and IsValidCarIncludeTemp350(i) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_PROPSHEAVY then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			if string.find(car:GetFullPath(), ".PropHeavy")~=nil and IsValidCarIncludeTemp350(i) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_PROPSRETROFOLK then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			if string.find(car:GetFullPath(), ".PropLightRetroFolk")~=nil and IsValidCarIncludeTemp350(i) then
				table.insert(carlist, {index = i})
			end
		end
	elseif carclass == CARCLASS_TIERF2 then
		--midwest ranch 1 time trial times:
		--stunt car: 45.97, 51.73
		--chili: 47.08, 51.50
		--malice: 49.06, 52.71
		--roamer: 49.38, 52.42
		--shaker: 47.67, 52.77
		--blaster xl: 47.43, 51.59
		--banger: 46.56, 50.33
		--pimpster: 46.79, 50.83
		--truck: 48.35, 52.96
		--cooper s: 48.31, 53.40
		--amazon: 44.51, 48.55
		
		--midwest ranch 1 no props time trial times:
		--pimpster: 49.61, 56.52
		--roamer: 48.86, 54.05
		--malice: 48.60, 54.68
		--shaker: 47.73, 53.87
		--stunt car: 46.52, 51.34
		--banger: 45.85, 51.14
		--amazon: 44.19, 48.71
		--ctr: 43.72, 49.30
		
		--midwest ranch 1 no props time trial times without speedlimit:
		--malice: 48.51
		--chili: 46.84
		--roamer: 47.83
		--shaker: 47.44
		--blaster xl: 45.49
		--stunt car: 45.35, 51.51
		--banger: 44.44
		--insetta sport: 44.29
		--switchblade: 43.71
		--ctr: 43.19
		--venom: 43.02
		--splitter: 42.71
	
		table.insert(carlist, { index = CarIndex.Malice })
		if not ChloeNet_GetUncappedSpeedLimit() then
			table.insert(carlist, { index = CarIndex.Roamer })
			if propCarsEnabled then
				table.insert(carlist, { index = CarIndex.PropFarmPickup }) -- Roamer
			end
		end
		-- the pimpster is awful without nitro so it's moved to F- tier
		if nitroMult == 0.0 then
			table.insert(carlist, { index = CarIndex.Pimpster })
		end
		table.insert(carlist, { index = CarIndex.RTSaab96 }) -- Malice
		table.insert(carlist, { index = CarIndex.HLATrabant }) -- Malice
		if propCarsEnabled then
			table.insert(carlist, { index = CarIndex.PropRetroFolk1 }) -- Pepper
			table.insert(carlist, { index = CarIndex.PropRetroFolk2 }) -- Blocker
			table.insert(carlist, { index = CarIndex.PropRetroFolk3 }) -- Pepper
			table.insert(carlist, { index = CarIndex.PropRetroFolk4 }) -- Pepper
			if ChloeNet_GetHandlingMode() == HANDLING_PROFESSIONAL then
				table.insert(carlist, { index = CarIndex.Freeman })
			end
		end
	elseif carclass == CARCLASS_TIERF then
		table.insert(carlist, { index = CarIndex.Chili })
		if ChloeNet_GetUncappedSpeedLimit() then
			table.insert(carlist, { index = CarIndex.Roamer })
			if propCarsEnabled then
				table.insert(carlist, { index = CarIndex.PropFarmPickup }) -- Roamer
			end
		end
		table.insert(carlist, { index = CarIndex.Shaker })
		if not ChloeNet_GetUncappedSpeedLimit() then
			table.insert(carlist, { index = CarIndex.BlasterXL })
			table.insert(carlist, { index = CarIndex.Banger })
			table.insert(carlist, { index = CarIndex.Starflight })
			table.insert(carlist, { index = CarIndex.Trailblazer })
			table.insert(carlist, { index = CarIndex.Afterburner })
			table.insert(carlist, { index = CarIndex.Rocket })
			table.insert(carlist, { index = CarIndex.Nucleon })
		end
		if nitroMult > 0.0 and nitroMult < 1.0 then
			table.insert(carlist, { index = CarIndex.Pimpster })
		end
		table.insert(carlist, { index = CarIndex.FO1Pepper }) -- Chili
		if not ChloeNet_GetUncappedSpeedLimit() then
			table.insert(carlist, { index = CarIndex.FO1Blocker }) -- Banger
		end
		table.insert(carlist, { index = CarIndex.FO1Grinder }) -- Shaker
		if not ChloeNet_GetUncappedSpeedLimit() then
			table.insert(carlist, { index = CarIndex.RetroBeetle }) -- modified Chili, closer to Banger
		end
		table.insert(carlist, { index = CarIndex.RTCooperS }) -- modified Chili
		table.insert(carlist, { index = CarIndex.PropTrafPizza }) -- Cooper S
		if propCarsEnabled and not ChloeNet_GetUncappedSpeedLimit() then
			table.insert(carlist, { index = CarIndex.MonaCar }) -- Blaster XL
		end
	elseif carclass == CARCLASS_TIERD then
		if ChloeNet_GetUncappedSpeedLimit() then
			table.insert(carlist, { index = CarIndex.BlasterXL })
			table.insert(carlist, { index = CarIndex.Banger })
			table.insert(carlist, { index = CarIndex.Starflight })
			table.insert(carlist, { index = CarIndex.Trailblazer })
			table.insert(carlist, { index = CarIndex.Afterburner })
			table.insert(carlist, { index = CarIndex.Rocket })
			table.insert(carlist, { index = CarIndex.Nucleon })
			table.insert(carlist, { index = CarIndex.FO1Blocker }) -- Banger
			table.insert(carlist, { index = CarIndex.RetroBeetle }) -- modified Chili, closer to Banger
			if propCarsEnabled then
				table.insert(carlist, { index = CarIndex.PropRetroFolk2 }) -- Blocker
				table.insert(carlist, { index = CarIndex.MonaCar }) -- Blaster XL
			end
		end
		table.insert(carlist, { index = CarIndex.CTR })
		table.insert(carlist, { index = CarIndex.Boxer })
		table.insert(carlist, { index = CarIndex.MadRash })
		table.insert(carlist, { index = CarIndex.Nevada })
		table.insert(carlist, { index = CarIndex.InsettaSport })
		if nitroMult == 1.0 then
			table.insert(carlist, { index = CarIndex.Pimpster })
		end
		table.insert(carlist, { index = CarIndex.FO1Overrunner }) -- CTR / Mad Rash
		table.insert(carlist, { index = CarIndex.FO1RoadKing }) -- Boxer
		table.insert(carlist, { index = CarIndex.FO1Fasthammer }) -- Nevada
		table.insert(carlist, { index = CarIndex.RTAmazon }) -- modified Switchblade, closer to CTR
		table.insert(carlist, { index = CarIndex.Stratum })
		table.insert(carlist, { index = CarIndex.TrainCar }) -- CTR
		table.insert(carlist, { index = CarIndex.MazdaRX8 }) -- Insetta Sport
		if propCarsEnabled then
			table.insert(carlist, { index = CarIndex.NukeCar }) -- Insetta Sport
			table.insert(carlist, { index = CarIndex.PropLincoln }) -- Mad Rash
			table.insert(carlist, { index = CarIndex.PropLincolnFO2 }) -- Mad Rash
			table.insert(carlist, { index = CarIndex.PropTarpCar }) -- Mad Rash
			table.insert(carlist, { index = CarIndex.PropCaddy }) -- Boxer
			table.insert(carlist, { index = CarIndex.PropCaddy2 }) -- Boxer
			table.insert(carlist, { index = CarIndex.PropRetroPickup }) -- Nevada
			table.insert(carlist, { index = CarIndex.PropRetroVan }) -- Nevada
			table.insert(carlist, { index = CarIndex.PropRetroFamilyCar }) -- Nevada
		end
	elseif carclass == CARCLASS_TIERC then
		table.insert(carlist, { index = CarIndex.Splitter })
		table.insert(carlist, { index = CarIndex.Switchblade })
		table.insert(carlist, { index = CarIndex.Lancea })
		table.insert(carlist, { index = CarIndex.Fortune })
		table.insert(carlist, { index = CarIndex.Daytana })
		table.insert(carlist, { index = CarIndex.ChiliPepper })
		table.insert(carlist, { index = CarIndex.Scorpion })
		table.insert(carlist, { index = CarIndex.Sparrowhawk })
		table.insert(carlist, { index = CarIndex.Crusader })
		if nitroMult > 1.0 then
			table.insert(carlist, { index = CarIndex.Pimpster })
		end
		table.insert(carlist, { index = CarIndex.FO1Blockhead }) -- Splitter
