			table.insert(carlist, { index = CarIndex.PropFO1Trasher }) -- Trasher
			table.insert(carlist, { index = CarIndex.Toyeca }) -- Sunray
			table.insert(carlist, { index = CarIndex.Evo5 }) -- Insetta
			table.insert(carlist, { index = CarIndex.UG2350Z }) -- Sunray
			table.insert(carlist, { index = CarIndex.SportCar }) -- Bullet GT
			table.insert(carlist, { index = CarIndex.ProStreetViper }) -- Speedevil
		end
	elseif carclass == CARCLASS_TIERS2 then
		table.insert(carlist, { index = CarIndex.Flatmobile })
		table.insert(carlist, { index = CarIndex.StarflightSS })
		table.insert(carlist, { index = CarIndex.TrailblazerSS })
		table.insert(carlist, { index = CarIndex.AfterburnerSS })
		table.insert(carlist, { index = CarIndex.RocketSS })
		table.insert(carlist, { index = CarIndex.NucleonSS })
		if propCarsEnabled and ChloeNet_GetHandlingMode() ~= HANDLING_PROFESSIONAL then
			table.insert(carlist, { index = CarIndex.Freeman })
		end
	elseif carclass < CARCLASS_SAMEASHOST then
		-- A specific car class
		carlist = CarlistFromClass(carclass, false, true)
	elseif ChloeNet_IsServer() then
		-- "Same as host" car setting
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			local car = db.FlatOut2.Cars:GetProperty("Car", i)
			
			if validCarFunc(i) then
				table.insert(carlist, {index = i})
			end
		end
	else
		-- "Same as host" car setting for non-hosts, can only change the car skin
		carlist = { { index = hostCar } }
	end
	-- ChloeCustom: only FlatOut 2 / Ultimate Carnage cars (some classes list addon cars directly)
	local fo2carlist = { }
	for _,c in ipairs(carlist) do
		if c.index and ChloeCustom_IsFO2Car(c.index) then
			table.insert(fo2carlist, c)
		end
	end
	if table.getn(fo2carlist) == 0 then
		for i = 0, db.FlatOut2.Cars:GetPropertyArraySize("Car") - 1 do
			if IsValidCar(i) then
				table.insert(fo2carlist, {index = i})
			end
		end
	end
	carlist = fo2carlist
	SortCarsByClass(carlist)
	
	-- 157 cars crashes the game
	print("Car count "..table.getn(carlist))
	if table.getn(carlist) >= 150 then
		return GetCarListForCurrentClass(true)
	end
	
	return carlist
end

local function IsPlayerCarValidForClass()
	local carlist = GetCarListForCurrentClass()
	
	local playerCar = ChloeNet_GetLocalPlayerCar()
	if ChloeNet_GetCarClass() ~= CARCLASS_RETRODEMO then
		local playerCarMatchup = ChloeCollection_GetCarMatchupInverse(playerCar)
		if playerCarMatchup ~= nil then
			playerCar = playerCarMatchup
		end
	end
	
	-- Check if the player's car is still valid, and if not, make it valid
	local carvalid = false
	for k,car in pairs(carlist) do
		if car.index == playerCar then
			carvalid = true
			break
		end
	end
	
	return carvalid
end

local function ChangeCar()
	local carlist = GetCarListForCurrentClass()
	local carclass = ChloeNet_GetCarClass()

	ChloeNet_SetPlayerChangingCar(1)
	EnterCarSelection(
		function(car, skin)
			ChloeNet_SetPlayerChangingCar(0)
			if car ~= nil then
				ChloeNet_SetPlayerCar(car)
				ChloeNet_SetPlayerCarSkin(skin)
				if ChloeNet_IsServer() and ChloeNet_GetCarClass() >= CARCLASS_SAMEASHOST then
					ChloeNet_Host_SetCarClass(car + CARCLASS_SAMEASHOST)
				end
			end
			EnterMenu("menu_chloemultiplayer_lobby")
		end,
		function()
			ChloeNet_SetPlayerChangingCar(0)
			EnterMenu("menu_chloemultiplayer_lobby")
		end,
		carlist,
		false,
		true,
		false,
		false,
		nil,
		nil,
		true, -- show_class
		nil, -- title
		true, -- hide_menubar_car
		false, -- nocolor
		false, -- nodescription
		carclass == CARCLASS_RETRODEMO -- noswap
	)
end

local function TuneCar()
	ChloeNet_SetPlayerChangingOptions(1)
	menu_chloecartuning.backmenuname="menu_chloemultiplayer_lobby"
	EnterMenu("menu_chloecartuning")
end

local function SetEvents(events)
	ChloeNet_Host_SetLevelId(events[1].trackid)
	ChloeNet_Host_SetGameRules(Levels[events[1].trackid].Rules or GR_DEFAULT)
	ChloeNet_Host_SetDerbyType(DERBY_NONE)
	if events[1].rules == GAMETYPE_PONGRACE then
		ChloeNet_Host_SetGameRules(GR_PONGRACE)
	elseif events[1].rules == GAMETYPE_ARCADE_RACE then
		ChloeNet_Host_SetGameRules(GR_ARCADE_RACE)
	elseif events[1].rules == GAMETYPE_TONYHAWK then
		ChloeNet_Host_SetGameRules(GR_TONYHAWK)
	elseif events[1].rules == GAMETYPE_DRIFT then
		ChloeNet_Host_SetGameRules(GR_DRIFT)
	elseif events[1].rules == GAMETYPE_LAPKNOCKOUT then
		ChloeNet_Host_SetGameRules(GR_LAPKNOCKOUT)
	elseif events[1].rules == GAMETYPE_KNOCKOUT then
		ChloeNet_Host_SetGameRules(GR_KNOCKOUT)
	elseif events[1].rules == GAMETYPE_SPEEDTRAP then
		ChloeNet_Host_SetGameRules(GR_SPEEDTRAP)
	elseif events[1].rules == GAMETYPE_BEAT_THE_BOMB then
		ChloeNet_Host_SetGameRules(GR_BEAT_THE_BOMB)
	elseif events[1].rules == GAMETYPE_DERBY_LMS then
		ChloeNet_Host_SetGameRules(GR_DERBY)
		ChloeNet_Host_SetDerbyType(DERBY_LMS)
	elseif events[1].rules == GAMETYPE_DERBY_WRECKING then
		ChloeNet_Host_SetGameRules(GR_DERBY)
		ChloeNet_Host_SetDerbyType(DERBY_WRECKING)
	elseif events[1].rules == GAMETYPE_DERBY_FRAG then
		ChloeNet_Host_SetGameRules(GR_DERBY)
		ChloeNet_Host_SetDerbyType(DERBY_FRAG)
	end
	ChloeNet_Host_SetLapCount(events[1].lapsOrTimeLimit)
	ChloeNet_Host_SetWeatherId(events[1].weather)
	if events[1].tracktype == TRACKTYPE_REVERSED then
		ChloeNet_Host_SetTrackReversed(1)
	else
		ChloeNet_Host_SetTrackReversed(0)
	end
	ChloeNet_Host_SetIsFO2Track(0)
	
	if events[1].rules == GAMETYPE_ARCADE_RACE or events[1].rules == GAMETYPE_BEAT_THE_BOMB then
		ChloeNet_Host_SetLapCount(10)
	end
	
	if Levels[events[1].trackid].ForceOneLapOnly and events[1].rules ~= GAMETYPE_DRIFT then
		ChloeNet_Host_SetLapCount(1)
	end
	
	local gameRules = ChloeNet_GetGameRules()
	if gameRules == GR_DEFAULT then
		gameRules = Levels[ChloeNet_GetLevelId()].Rules or GR_RACE
	end
	
	-- ChloeCustom: ghost mode for stunts (players start at the same point), restore the previous setting afterwards
	if gameRules == GR_STUNT then
		if ChloeCustom_GetPersistent("ghostbeforestunt") == nil then
			ChloeCustom_SetPersistent("ghostbeforestunt", ChloeNet_GetNoContact() and "1" or "0")
			ChloeNet_Host_SetNoContact(1)
		end
	elseif ChloeCustom_GetPersistent("ghostbeforestunt") ~= nil then
		ChloeNet_Host_SetNoContact(tonumber(ChloeCustom_GetPersistent("ghostbeforestunt")) or 0)
		ChloeCustom_SetPersistent("ghostbeforestunt", nil)
	end
	if gameRules == GR_STUNT and ChloeNet_GetCarClass() >= CARCLASS_SAMEASHOST and not IsStuntCar(ChloeNet_GetLocalPlayerCar()) then
		ChangeCar()
		return
	end
	
	EnterMenu("menu_chloemultiplayer_lobby")
end
ChloeCustomTourney_SetEvents = SetEvents -- ChloeCustom Tourney

local function ChangeTrack()
	ChloeNet_SetPlayerChangingTrack(1)
	
	local event = { }
	event.trackid = ChloeNet_GetLevelId()
	event.rules = GAMETYPE_RACE
	if ChloeNet_GetGameRules() == GR_PONGRACE then
		event.rules = GAMETYPE_PONGRACE
	elseif ChloeNet_GetGameRules() == GR_ARCADE_RACE then
		event.rules = GAMETYPE_ARCADE_RACE
	elseif ChloeNet_GetGameRules() == GR_TONYHAWK then
		event.rules = GAMETYPE_TONYHAWK
	elseif ChloeNet_GetGameRules() == GR_DRIFT then
		event.rules = GAMETYPE_DRIFT
	elseif ChloeNet_GetGameRules() == GR_LAPKNOCKOUT then
		event.rules = GAMETYPE_LAPKNOCKOUT
	elseif ChloeNet_GetGameRules() == GR_KNOCKOUT then
		event.rules = GAMETYPE_KNOCKOUT
	elseif ChloeNet_GetGameRules() == GR_SPEEDTRAP then
		event.rules = GAMETYPE_SPEEDTRAP
	elseif ChloeNet_GetGameRules() == GR_BEAT_THE_BOMB then
		event.rules = GAMETYPE_BEAT_THE_BOMB
	elseif ChloeNet_GetGameRules() == GR_DERBY then
		if ChloeNet_GetDerbyType() == DERBY_FRAG then
			event.rules = GAMETYPE_DERBY_FRAG
		else
			event.rules = GAMETYPE_DERBY_WRECKING
		end
	end
	event.lapsOrTimeLimit = ChloeNet_GetLapCount()
	if ChloeNet_GetTrackReversed() then
		event.tracktype = TRACKTYPE_REVERSED
	else
		event.tracktype = Levels[event.trackid].TrackType
	end
	event.weather = ChloeNet_GetWeatherId()
	
	EnterMultiplayerRaceEdit(
		GAMETYPE_TOURNAMENT,
		event,
		function(event)
			SetEvents( { event } )
		end,
		entermenu("menu_chloemultiplayer_lobby"),
		ChloeNet_GetMaxPlayers()
	)
end

